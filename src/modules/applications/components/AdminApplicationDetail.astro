---
import type { Locale } from "@i18n/config";
import type { loadAdminApplication } from "@/modules/applications/loaders/admin-applications.loader";
import { getAdminDict, adminStatusLabel } from "@i18n/admin";
import { AdminDetailShell, statusTone } from "@/core/admin";
import { Badge } from "@atoms/badge";
import { Card, CardContent, CardHeader, CardTitle } from "@atoms/card";
import { Input } from "@atoms/input";
import { Label } from "@atoms/label";
import Button from "@atoms/button/Button.astro";

interface Props {
  detail: NonNullable<Awaited<ReturnType<typeof loadAdminApplication>>>;
  locale: Locale;
  baseUrl: string;
  canReview: boolean;
}

const { detail, locale, baseUrl, canReview } = Astro.props;
const { application, traveler, decisions, events, checkouts } = detail;
const dict = getAdminDict(locale);
const t = dict.applications;
const c = dict.common;
const col = dict.columns;
const reviewable = ["submitted", "under_review", "contact_required"].includes(application.status);
const fmtDate = (value: Date) => value.toISOString().slice(0, 16).replace("T", " ");
---

<AdminDetailShell
  data-application-id={application.id}
  title={traveler?.legalName ?? traveler?.email ?? application.id}
  description={traveler?.email ?? undefined}
  backHref={baseUrl}
  backLabel={t.backToList}
>
  <Fragment slot="meta">
    <p class="mt-2">
      <Badge variant={statusTone(application.status)} size="sm">{adminStatusLabel(dict, application.status)}</Badge>
    </p>
  </Fragment>

  {canReview && reviewable ? (
    <Card>
      <CardContent class="grid gap-3 p-6">
        <div class="flex flex-col gap-1">
          <Label for="application-internal-note">{t.optionalNote}</Label>
          <Input id="application-internal-note" name="internalNote" data-review-note maxlength="5000" size="sm" />
        </div>
        <div class="flex flex-wrap gap-2">
          <Button type="button" variant="primary" size="sm" data-decision="approved">{t.approve}</Button>
          <Button type="button" variant="outline" size="sm" data-decision="contact_required">{t.requestChat}</Button>
          <Button type="button" variant="error" size="sm" data-decision="declined" data-confirm-decline={t.confirmDecline}>{t.decline}</Button>
        </div>
      </CardContent>
    </Card>
  ) : null}

  <Card>
    <CardHeader>
      <CardTitle>{col.traveler}</CardTitle>
    </CardHeader>
    <CardContent>
      <dl class="grid gap-2 text-sm sm:grid-cols-2">
        <div><dt class="text-muted-foreground">{col.email}</dt><dd>{traveler?.email}</dd></div>
        <div><dt class="text-muted-foreground">{t.phone}</dt><dd>{traveler?.phone ?? "—"}</dd></div>
        <div><dt class="text-muted-foreground">{col.locale}</dt><dd>{traveler?.locale ?? "—"}</dd></div>
      </dl>
    </CardContent>
  </Card>

  <Card>
    <CardHeader>
      <CardTitle>{t.answers}</CardTitle>
    </CardHeader>
    <CardContent>
      <dl class="space-y-3 text-sm">
        <div><dt class="text-muted-foreground">{t.room}</dt><dd>{application.roomPreference ?? "—"}</dd></div>
        <div><dt class="text-muted-foreground">{t.diet}</dt><dd>{application.dietaryRequirements ?? "—"}</dd></div>
        <div><dt class="text-muted-foreground">{t.access}</dt><dd>{application.accessibilityNeeds ?? "—"}</dd></div>
        <div><dt class="text-muted-foreground">{t.motivation}</dt><dd class="whitespace-pre-wrap">{application.motivation ?? "—"}</dd></div>
        <div><dt class="text-muted-foreground">{t.expectations}</dt><dd class="whitespace-pre-wrap">{application.expectations ?? "—"}</dd></div>
      </dl>
    </CardContent>
  </Card>

  <Card>
    <CardHeader>
      <CardTitle>{t.checkouts}</CardTitle>
    </CardHeader>
    <CardContent>
      {checkouts.length === 0 ? (
        <p class="text-sm text-muted-foreground">{c.noResults}</p>
      ) : (
        <ul class="space-y-2 text-sm">
          {checkouts.map((ck) => (
            <li class="flex flex-wrap justify-between gap-4 border-b pb-1 last:border-b-0">
              <a class="text-primary underline" href={`/${locale}/checkout/${ck.id}`}>/{locale}/checkout/{ck.id.slice(0, 8)}…</a>
              <Badge variant={statusTone(ck.status)} size="sm">{adminStatusLabel(dict, ck.status)}</Badge>
            </li>
          ))}
        </ul>
      )}
    </CardContent>
  </Card>

  <Card>
    <CardHeader>
      <CardTitle>{t.decisions}</CardTitle>
    </CardHeader>
    <CardContent class="space-y-6">
      {decisions.length === 0 ? (
        <p class="text-sm text-muted-foreground">{c.noResults}</p>
      ) : (
        <ul class="space-y-2 text-sm">
          {decisions.map((d) => (
            <li class="flex flex-wrap justify-between gap-4 border-b pb-1 last:border-b-0">
              <span class="font-semibold">{d.decision}</span>
              <span class="text-muted-foreground">{fmtDate(d.createdAt)}</span>
            </li>
          ))}
        </ul>
      )}
      <div>
        <h3 class="font-heading text-base font-medium">{t.timeline}</h3>
        <ul class="mt-2 space-y-2 text-sm">
          {events.map((ev) => (
            <li class="flex flex-wrap justify-between gap-4 border-b pb-1 last:border-b-0">
              <span>{ev.event}</span>
              <span class="text-muted-foreground">{fmtDate(ev.createdAt)}</span>
            </li>
          ))}
        </ul>
      </div>
    </CardContent>
  </Card>

  <input type="hidden" data-application-i18n data-error={c.error} data-decline-title={t.decline} data-decline-confirm={t.confirmDecline} data-confirm-label={c.confirm} data-cancel-label={c.cancel} data-success={t.decisionSaved} />
</AdminDetailShell>

<script>
  import { actions } from "astro:actions";
  import { toast } from "@atoms/toast";
  import { confirmAdminAction } from "@/core/admin";

  const root = document.querySelector<HTMLElement>("[data-application-id]");
  const id = root?.getAttribute("data-application-id") ?? "";
  const i18n = document.querySelector<HTMLInputElement>("[data-application-i18n]");

  document.querySelectorAll<HTMLButtonElement>("[data-decision]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const decision = (btn.dataset.decision ?? "") as "approved" | "declined" | "contact_required";
      if (decision === "declined") {
        const ok = await confirmAdminAction({
          title: i18n?.dataset.declineTitle ?? "",
          message: i18n?.dataset.declineConfirm ?? "",
          confirmLabel: i18n?.dataset.confirmLabel ?? "OK",
          cancelLabel: i18n?.dataset.cancelLabel ?? "",
        });
        if (!ok) return;
      }
      const note = (document.querySelector("[data-review-note]") as HTMLInputElement | null)?.value || null;
      const { error } = await actions.reviewApplication({ id, decision, internalNote: note });
      if (error) toast.error(error.message ?? i18n?.dataset.error ?? "");
      else {
        toast.success(i18n?.dataset.success ?? "");
        window.location.reload();
      }
    });
  });
</script>
