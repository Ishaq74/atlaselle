---
import type { Locale } from "@i18n/config";
import type { loadAdminPayments } from "@/modules/payments/loaders/admin-payments.loader";
import type { PaymentStatus, PaymentType } from "@database/schemas/payments.schema";

type Row = Awaited<ReturnType<typeof loadAdminPayments>>["rows"][number];

interface Props {
  rows: Row[];
  meta: { total: number; page: number; pageSize: number };
  locale: Locale;
  baseUrl: string;
  status?: string;
  statuses: PaymentStatus[];
  canRefund: boolean;
}

const { rows, meta, locale, baseUrl, status, statuses, canRefund } = Astro.props;
const totalPages = Math.max(1, Math.ceil(meta.total / meta.pageSize));
const fmt = (cents: number, currency: string) => `${currency === "EUR" ? "€" : currency + " "}${(cents / 100).toLocaleString("en")}`;
const t = locale === "fr"
  ? { title: "Paiements", status: "Statut", all: "Tous", reservation: "Réservation", type: "Type", amount: "Montant", refund: "Rembourser", confirm: "Confirmer le remboursement ? (ré-authentification requise en production)", prev: "←", next: "→", of: "sur" }
  : { title: "Payments", status: "Status", all: "All", reservation: "Booking", type: "Type", amount: "Amount", refund: "Refund", confirm: "Confirm refund? (re-auth required in production)", prev: "←", next: "→", of: "of" };
---
<section class="mx-auto max-w-6xl px-6 py-10">
  <h1 class="text-3xl font-bold">{t.title} ({meta.total})</h1>
  <form method="get" class="mt-6 flex flex-wrap gap-3 text-sm">
    <select name="status" class="rounded-md border bg-background px-2 py-1.5" onchange="this.form.submit()">
      <option value="">{t.status} : {t.all}</option>
      {statuses.map((s) => (
        <option value={s} selected={status === s}>{s}</option>
      ))}
    </select>
  </form>
  <div class="mt-6 overflow-x-auto rounded-xl border">
    <table class="w-full text-left text-sm">
      <thead class="bg-muted/60">
        <tr><th class="px-4 py-2">{t.reservation}</th><th class="px-4 py-2">{t.type}</th><th class="px-4 py-2">{t.status}</th><th class="px-4 py-2">{t.amount}</th><th class="px-4 py-2"></th></tr>
      </thead>
      <tbody>
        {rows.map((row: Row & { type: PaymentType }) => (
          <tr class="border-t" data-reservation-id={row.reservationId}>
            <td class="px-4 py-2 font-mono text-xs">{row.reservationNumber}</td>
            <td class="px-4 py-2">{row.type}</td>
            <td class="px-4 py-2"><span class="rounded-full bg-muted px-2 py-0.5 text-xs">{row.status}</span></td>
            <td class="px-4 py-2">{fmt(row.amount, row.currency)}</td>
            <td class="px-4 py-2 text-right">
              {canRefund && (row.status === "paid" || row.status === "partially_refunded") ? <button type="button" class="text-red-600 underline" data-refund>{t.refund}</button> : null}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <nav class="mt-4 flex items-center gap-3 text-sm" aria-label="Pagination">
    {meta.page > 1 ? <a class="rounded-md border px-3 py-1" href={`${baseUrl}?page=${meta.page - 1}${status ? `&status=${status}` : ""}`}>{t.prev}</a> : null}
    <span>{meta.page} {t.of} {totalPages}</span>
    {meta.page < totalPages ? <a class="rounded-md border px-3 py-1" href={`${baseUrl}?page=${meta.page + 1}${status ? `&status=${status}` : ""}`}>{t.next}</a> : null}
  </nav>
</section>

<script>
  import { actions } from "astro:actions";
  document.querySelectorAll("[data-refund]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const row = (btn as HTMLElement).closest("[data-reservation-id]");
      const reservationId = row?.getAttribute("data-reservation-id") ?? "";
      if (!reservationId || !window.confirm(btn.textContent ?? "OK")) return;
      const { error } = await actions.refundPayment({ reservationId });
      if (error) alert(error.message);
      else window.location.reload();
    });
  });
</script>
