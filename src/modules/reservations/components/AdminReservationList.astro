---
import { NativeSelect, NativeSelectOption } from "@atoms/native-select";
import type { Locale } from "@i18n/config";
import type { loadAdminReservations } from "@/modules/reservations/loaders/admin-reservations.loader";
import type { ReservationStatus } from "@database/schemas/reservations.schema";
import { getAdminDict, adminStatusLabel } from "@i18n/admin";
import { AdminResourceShell, DataView, statusTone } from "@/core/admin";
import AdminPagination from "@molecules/AdminPagination/AdminPagination.astro";
import { Table, TableHeader, TableHead, TableBody, TableRow, TableCell } from "@atoms/table";
import { Badge } from "@atoms/badge";
import Button from "@atoms/button/Button.astro";

type Row = Awaited<ReturnType<typeof loadAdminReservations>>["rows"][number];

interface Props {
  rows: Row[];
  meta: { total: number; page: number; pageSize: number };
  locale: Locale;
  baseUrl: string;
  status?: string;
  statuses: ReservationStatus[];
  canCancel: boolean;
}
const { rows, meta, locale, baseUrl, status, statuses, canCancel } = Astro.props;
const totalPages = Math.max(1, Math.ceil(meta.total / meta.pageSize));
const dict = getAdminDict(locale);
const t = dict.reservations;
const c = dict.common;
const col = dict.columns;
const statusLabel = (value: string) => adminStatusLabel(dict, value);
const amountFmt = new Intl.NumberFormat(locale);
const fmt = (cents: number, currency: string) => `${currency === "EUR" ? "€" : currency + " "}${amountFmt.format(cents / 100)}`;

const cancellable = ["pending", "awaiting_payment", "confirmed", "balance_due"];
const hasFilters = Boolean(status);
const paginationUrl = new URL(Astro.url.href);
---

<AdminResourceShell title={`${t.title} (${meta.total})`}>
  <div class="space-y-4 p-4 md:p-6">
    <input type="hidden" data-reservations-i18n data-error={c.error} data-confirm-title={t.cancel} data-confirm-label={c.confirm} data-cancel-label={c.cancel} />
    <form method="get" class="grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-3" data-admin-filters aria-label={c.filter}>
      <div class="flex flex-col gap-1">
        <label for="reservation-filter-status" class="text-sm font-medium">{col.status}</label>
        <NativeSelect id="reservation-filter-status" name="status" size="sm" data-autosubmit>
          <NativeSelectOption value="">{c.all}</NativeSelectOption>
          {statuses.map((s) => (
            <NativeSelectOption value={s} selected={status === s}>{statusLabel(s)}</NativeSelectOption>
          ))}
        </NativeSelect>
      </div>
      <div class="flex items-end gap-2">
        <Button type="submit" size="sm" variant="primary">{c.apply}</Button>
        <Button size="sm" variant="outline" href={baseUrl}>{c.reset}</Button>
      </div>
    </form>

    <DataView
      listLabel={dict.views.list}
      tableLabel={dict.views.table}
      cardsLabel={dict.views.cards}
      showModeSelector={rows.length > 0}
    >
      {/* Slots directs exigés : un slot nommé dans une expression
          conditionnelle n'est pas enregistré par Astro — donc plus de
          sélecteur de vue et trois vues empilées. */}
          <div slot="table">
          {rows.length === 0 ? (
            <div class="rounded-lg border border-dashed p-10 text-center">
          <p class="font-medium">{c.noResults}</p>
          <p class="mt-1 text-sm text-muted-foreground">{c.noResultsHint}</p>
          {hasFilters ? <Button class="mt-4" size="sm" variant="outline" href={baseUrl}>{c.clearFilters}</Button> : null}
            </div>
          ) : (
          <Table aria-label={t.title}>
            <TableHeader>
              <TableRow>
                <TableHead scope="col">{col.number}</TableHead>
                <TableHead scope="col">{col.traveler}</TableHead>
                <TableHead scope="col">{col.status}</TableHead>
                <TableHead scope="col">{col.total}</TableHead>
                <TableHead scope="col">{col.paid}</TableHead>
                <TableHead scope="col"><span class="sr-only">{c.actions}</span></TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {rows.map((row) => (
                <TableRow data-reservation-id={row.id}>
                  <TableCell class="font-mono text-xs">
                    <a class="text-primary underline" href={`${baseUrl}/${row.id}`}>{row.reservationNumber}</a>
                  </TableCell>
                  <TableCell>{row.travelerEmail}</TableCell>
                  <TableCell><Badge variant={statusTone(row.status)} size="sm">{statusLabel(row.status)}</Badge></TableCell>
                  <TableCell>{fmt(row.totalAmount, row.currency)}</TableCell>
                  <TableCell>{fmt(row.amountPaid, row.currency)}</TableCell>
                  <TableCell class="text-end">
                    {canCancel && cancellable.includes(row.status) ? (
                      <Button size="sm" variant="error" data-cancel>{t.cancel}</Button>
                    ) : (
                      <Button size="sm" variant="ghost" href={`${baseUrl}/${row.id}`}>{c.details}</Button>
                    )}
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
          )}
          </div>

          <div slot="list" class="divide-y rounded-lg border" hidden={rows.length === 0}>
            {rows.map((row) => (
              <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3" data-reservation-id={row.id}>
                <div class="min-w-0">
                  <p class="truncate font-mono text-sm"><a class="text-primary underline" href={`${baseUrl}/${row.id}`}>{row.reservationNumber}</a></p>
                  <p class="truncate text-xs text-muted-foreground">
                    {row.travelerEmail} · {fmt(row.amountPaid, row.currency)} / {fmt(row.totalAmount, row.currency)}
                  </p>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                  <Badge variant={statusTone(row.status)} size="sm">{statusLabel(row.status)}</Badge>
                  {canCancel && cancellable.includes(row.status) ? (
                    <Button size="sm" variant="error" data-cancel>{t.cancel}</Button>
                  ) : (
                    <Button size="sm" variant="ghost" href={`${baseUrl}/${row.id}`}>{c.details}</Button>
                  )}
                </div>
              </div>
            ))}
          </div>

          <div slot="cards" class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3" hidden={rows.length === 0}>
            {rows.map((row) => (
              <article class="flex flex-col gap-3 rounded-lg border p-4" data-reservation-id={row.id}>
                <div class="flex items-start justify-between gap-2">
                  <h3 class="min-w-0 truncate font-mono text-sm font-medium">{row.reservationNumber}</h3>
                  <Badge variant={statusTone(row.status)} size="sm">{statusLabel(row.status)}</Badge>
                </div>
                <dl class="grid grid-cols-2 gap-2 text-sm">
                  <div class="col-span-2"><dt class="text-muted-foreground">{col.traveler}</dt><dd class="truncate">{row.travelerEmail}</dd></div>
                  <div><dt class="text-muted-foreground">{col.total}</dt><dd>{fmt(row.totalAmount, row.currency)}</dd></div>
                  <div><dt class="text-muted-foreground">{col.paid}</dt><dd>{fmt(row.amountPaid, row.currency)}</dd></div>
                </dl>
                <div class="mt-auto flex justify-end gap-2">
                  <Button size="sm" variant="ghost" href={`${baseUrl}/${row.id}`}>{c.details}</Button>
                  {canCancel && cancellable.includes(row.status) ? (
                    <Button size="sm" variant="error" data-cancel>{t.cancel}</Button>
                  ) : null}
                </div>
              </article>
            ))}
          </div>
    </DataView>

    <AdminPagination currentPage={meta.page} totalPages={totalPages} baseUrl={paginationUrl} />
  </div>
</AdminResourceShell>

<script>
  import { actions } from "astro:actions";
  import { toast } from "@atoms/toast";
  import { confirmAdminAction } from "@/core/admin";

  document.querySelectorAll<HTMLSelectElement>("form[data-admin-filters] select[data-autosubmit]").forEach((select) => {
    if (select.dataset.bound === "true") return;
    select.dataset.bound = "true";
    select.addEventListener("change", () => select.form?.requestSubmit());
  });

  const i18n = document.querySelector<HTMLInputElement>("[data-reservations-i18n]");

  document.querySelectorAll<HTMLButtonElement>("[data-cancel]").forEach((btn) => {
    if (btn.dataset.bound === "true") return;
    btn.dataset.bound = "true";
    btn.addEventListener("click", async () => {
      const row = btn.closest<HTMLElement>("[data-reservation-id]");
      const reservationId = row?.getAttribute("data-reservation-id") ?? "";
      if (!reservationId) return;
      const ok = await confirmAdminAction({
        title: i18n?.dataset.confirmTitle ?? "",
        message: i18n?.dataset.confirmTitle ?? "",
        confirmLabel: i18n?.dataset.confirmLabel ?? "OK",
        cancelLabel: i18n?.dataset.cancelLabel ?? "",
      });
      if (!ok) return;
      const { error } = await actions.cancelReservation({ reservationId });
      if (error) toast.error(error.message ?? i18n?.dataset.error ?? "");
      else window.location.reload();
    });
  });
</script>
