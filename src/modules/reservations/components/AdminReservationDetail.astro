---
import type { Locale } from "@i18n/config";
import type { loadAdminReservation } from "@/modules/reservations/loaders/admin-reservations.loader";
import { getAdminDict, adminStatusLabel } from "@i18n/admin";
import { AdminDetailShell, statusTone } from "@/core/admin";
import { Badge } from "@atoms/badge";
import { Card, CardContent, CardHeader, CardTitle } from "@atoms/card";
import Button from "@atoms/button/Button.astro";

interface Props {
  detail: NonNullable<Awaited<ReturnType<typeof loadAdminReservation>>>;
  locale: Locale;
  canCancel: boolean;
  canRefund: boolean;
}

const { detail, locale, canCancel, canRefund } = Astro.props;
const { reservation, traveler, payments, tripTitle } = detail;
const dict = getAdminDict(locale);
const t = dict.reservations;
const c = dict.common;
const col = dict.columns;
const baseUrl = `/${locale}/admin/reservations`;
const fmt = (cents: number) => `${reservation.currency === "EUR" ? "€" : reservation.currency + " "}${(cents / 100).toLocaleString(locale)}`;
const cancellable = ["pending", "awaiting_payment", "confirmed", "balance_due"].includes(reservation.status);
const refundable = payments.some((p) => p.status === "paid" || p.status === "partially_refunded");
---

<AdminDetailShell
  data-reservation-id={reservation.id}
  title={reservation.reservationNumber}
  description={tripTitle ?? undefined}
  backHref={baseUrl}
  backLabel={t.backToList}
>
  <Fragment slot="meta">
    <p class="mt-2 flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
      <Badge variant={statusTone(reservation.status)} size="sm">{adminStatusLabel(dict, reservation.status)}</Badge>
      {traveler?.email ? <span>{traveler.email}</span> : null}
    </p>
  </Fragment>

  <Card>
    <CardHeader>
      <CardTitle>{t.breakdown}</CardTitle>
    </CardHeader>
    <CardContent>
      <dl class="space-y-2 text-sm">
        <div class="flex justify-between"><dt class="text-muted-foreground">{t.base}</dt><dd>{fmt(reservation.baseAmount)}</dd></div>
        <div class="flex justify-between"><dt class="text-muted-foreground">{t.supplement}</dt><dd>{fmt(reservation.singleSupplementAmount)}</dd></div>
        <div class="flex justify-between"><dt class="text-muted-foreground">{t.discount}</dt><dd>−{fmt(reservation.discountAmount)}</dd></div>
        <div class="flex justify-between"><dt class="text-muted-foreground">{t.tax}</dt><dd>{fmt(reservation.taxAmount)}</dd></div>
        <div class="flex justify-between"><dt class="text-muted-foreground">{t.fee}</dt><dd>{fmt(reservation.feeAmount)}</dd></div>
        <div class="flex justify-between border-t pt-2 font-semibold"><dt>{col.total}</dt><dd>{fmt(reservation.totalAmount)}</dd></div>
        <div class="flex justify-between"><dt class="text-muted-foreground">{col.paid}</dt><dd>{fmt(reservation.amountPaid)}</dd></div>
        <div class="flex justify-between"><dt class="text-muted-foreground">{t.balance}</dt><dd>{fmt(reservation.amountDue)}</dd></div>
      </dl>
      <div class="mt-4 flex flex-wrap gap-2">
        {canCancel && cancellable ? <Button variant="error" size="sm" data-cancel>{t.cancel}</Button> : null}
        {canRefund && refundable ? <Button variant="warning" size="sm" data-refund>{t.refund}</Button> : null}
      </div>
    </CardContent>
  </Card>

  <Card>
    <CardHeader>
      <CardTitle>{t.payments} ({payments.length})</CardTitle>
    </CardHeader>
    <CardContent>
      {payments.length === 0 ? (
        <p class="text-sm text-muted-foreground">{c.noResults}</p>
      ) : (
        <ul class="space-y-2 text-sm">
          {payments.map((p) => (
            <li class="flex flex-wrap justify-between gap-4 border-b pb-1 last:border-b-0">
              <span>
                {p.type} · {p.provider} ·{" "}
                <Badge variant={statusTone(p.status)} size="sm">{adminStatusLabel(dict, p.status)}</Badge>
              </span>
              <span class="font-semibold">{fmt(p.amount)}</span>
            </li>
          ))}
        </ul>
      )}
    </CardContent>
  </Card>

  <input type="hidden" data-reservation-i18n data-error={c.error} data-cancel-title={t.confirmCancel} data-refund-title={dict.payments.confirmRefund} data-confirm-label={c.confirm} data-cancel-label={c.cancel} />
</AdminDetailShell>

<script>
  import { actions } from "astro:actions";
  import { toast } from "@atoms/toast";
  import { confirmAdminAction } from "@/core/admin";

  const root = document.querySelector<HTMLElement>("[data-reservation-id]");
  const reservationId = root?.getAttribute("data-reservation-id") ?? "";
  const i18n = document.querySelector<HTMLInputElement>("[data-reservation-i18n]");

  const run = async (message: string, action: () => Promise<{ error?: { message?: string } | null }>) => {
    const ok = await confirmAdminAction({
      title: message,
      message,
      confirmLabel: i18n?.dataset.confirmLabel ?? "OK",
      cancelLabel: i18n?.dataset.cancelLabel ?? "",
    });
    if (!ok) return;
    const { error } = await action();
    if (error) toast.error(error.message ?? i18n?.dataset.error ?? "");
    else window.location.reload();
  };

  document.querySelector("[data-cancel]")?.addEventListener("click", () => {
    if (!reservationId) return;
    void run(i18n?.dataset.cancelTitle ?? "", () => actions.cancelReservation({ reservationId }));
  });

  document.querySelector("[data-refund]")?.addEventListener("click", () => {
    if (!reservationId) return;
    void run(i18n?.dataset.refundTitle ?? "", () => actions.refundPayment({ reservationId }));
  });
</script>
