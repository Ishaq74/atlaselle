---
import type { Locale } from "@i18n/config";
import type { loadAdminReservation } from "@/modules/reservations/loaders/admin-reservations.loader";

interface Props {
  detail: NonNullable<Awaited<ReturnType<typeof loadAdminReservation>>>;
  locale: Locale;
  canCancel: boolean;
  canRefund: boolean;
}

const { detail, locale, canCancel, canRefund } = Astro.props;
const { reservation, traveler, payments, tripTitle } = detail;
const fmt = (cents: number) => `${reservation.currency === "EUR" ? "€" : reservation.currency + " "}${(cents / 100).toLocaleString("en")}`;
const t = locale === "fr"
  ? { number: "N°", trip: "Voyage", traveler: "Voyageuse", breakdown: "Détail du prix", base: "Base", supplement: "Supplément", discount: "Réduction", tax: "Taxes", fee: "Frais", total: "Total", paid: "Payé", due: "Dû", payments: "Paiements", cancel: "Annuler", refund: "Rembourser", balance: "Solde" }
  : { number: "No.", trip: "Trip", traveler: "Traveler", breakdown: "Price breakdown", base: "Base", supplement: "Supplement", discount: "Discount", tax: "Tax", fee: "Fee", total: "Total", paid: "Paid", due: "Due", payments: "Payments", cancel: "Cancel", refund: "Refund", balance: "Balance" };
const cancellable = ["pending", "awaiting_payment", "confirmed", "balance_due"].includes(reservation.status);
---
<section class="mx-auto max-w-4xl space-y-8 px-6 py-10" data-reservation-id={reservation.id}>
  <div>
    <h1 class="font-mono text-3xl font-bold">{reservation.reservationNumber}</h1>
    <p class="mt-1 text-sm text-muted-foreground">{reservation.status} · {tripTitle} · {traveler?.email}</p>
  </div>

  <div class="rounded-xl border p-6">
    <h2 class="text-xl font-bold">{t.breakdown}</h2>
    <dl class="mt-3 space-y-2 text-sm">
      <div class="flex justify-between"><dt>{t.base}</dt><dd>{fmt(reservation.baseAmount)}</dd></div>
      <div class="flex justify-between"><dt>{t.supplement}</dt><dd>{fmt(reservation.singleSupplementAmount)}</dd></div>
      <div class="flex justify-between"><dt>{t.discount}</dt><dd>−{fmt(reservation.discountAmount)}</dd></div>
      <div class="flex justify-between"><dt>{t.tax}</dt><dd>{fmt(reservation.taxAmount)}</dd></div>
      <div class="flex justify-between"><dt>{t.fee}</dt><dd>{fmt(reservation.feeAmount)}</dd></div>
      <div class="flex justify-between border-t pt-2 font-bold"><dt>{t.total}</dt><dd>{fmt(reservation.totalAmount)}</dd></div>
      <div class="flex justify-between"><dt>{t.paid}</dt><dd>{fmt(reservation.amountPaid)}</dd></div>
      <div class="flex justify-between"><dt>{t.balance}</dt><dd>{fmt(reservation.amountDue)}</dd></div>
    </dl>
    <div class="mt-4 flex flex-wrap gap-2">
      {canCancel && cancellable ? <button type="button" class="rounded-md border px-4 py-2 text-sm" data-cancel>{t.cancel}</button> : null}
      {canRefund && payments.some((p) => p.status === "paid" || p.status === "partially_refunded") ? <button type="button" class="rounded-md border px-4 py-2 text-sm" data-refund>{t.refund}</button> : null}
    </div>
  </div>

  <div class="rounded-xl border p-6">
    <h2 class="text-xl font-bold">{t.payments} ({payments.length})</h2>
    <ul class="mt-3 space-y-2 text-sm">
      {payments.map((p) => (
        <li class="flex justify-between gap-4 border-b py-1">
          <span>{p.type} · {p.provider} · <span class="rounded-full bg-muted px-2 py-0.5 text-xs">{p.status}</span></span>
          <span class="font-semibold">{fmt(p.amount)}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { actions } from "astro:actions";
  const root = document.querySelector("section[data-reservation-id]");
  const reservationId = root?.getAttribute("data-reservation-id") ?? "";
  document.querySelector("[data-cancel]")?.addEventListener("click", async () => {
    if (!reservationId || !window.confirm("OK?")) return;
    const { error } = await actions.cancelReservation({ reservationId });
    if (error) alert(error.message);
    else window.location.reload();
  });
  document.querySelector("[data-refund]")?.addEventListener("click", async () => {
    if (!reservationId || !window.confirm("OK?")) return;
    const { error } = await actions.refundPayment({ reservationId });
    if (error) alert(error.message);
    else window.location.reload();
  });
</script>
