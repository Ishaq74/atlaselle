---
import type { Locale } from "@i18n/config";
import type { loadAdminDeliveries } from "@/modules/email-voyage/loaders/admin-email.loader";
import { VOYAGE_EMAIL_TEMPLATES, EMAIL_DELIVERY_STATUSES } from "@database/schemas/email-voyage.schema";

type Row = Awaited<ReturnType<typeof loadAdminDeliveries>>["rows"][number];

interface Props {
  rows: Row[];
  meta: { total: number; page: number; pageSize: number };
  locale: Locale;
  baseUrl: string;
  status?: string;
  canRetry: boolean;
}

const { rows, meta, locale, baseUrl, status, canRetry } = Astro.props;
const totalPages = Math.max(1, Math.ceil(meta.total / meta.pageSize));
const t = locale === "fr"
  ? { title: "Emails", status: "Statut", all: "Tous", template: "Modèle", to: "Destinataire", attempts: "Essais", retry: "Relancer", prev: "←", next: "→", of: "sur" }
  : { title: "Emails", status: "Status", all: "All", template: "Template", to: "Recipient", attempts: "Attempts", retry: "Retry", prev: "←", next: "→", of: "of" };
const retryable = ["failed", "dead_letter"];
---
<section class="mx-auto max-w-6xl px-6 py-10">
  <h1 class="text-3xl font-bold">{t.title} ({meta.total})</h1>
  <form method="get" class="mt-6 flex flex-wrap gap-3 text-sm">
    <select name="status" class="rounded-md border bg-background px-2 py-1.5" onchange="this.form.submit()">
      <option value="">{t.status} : {t.all}</option>
      {EMAIL_DELIVERY_STATUSES.map((s) => (
        <option value={s} selected={status === s}>{s}</option>
      ))}
    </select>
    <select name="templateKey" class="rounded-md border bg-background px-2 py-1.5" onchange="this.form.submit()">
      <option value="">{t.template} : {t.all}</option>
      {VOYAGE_EMAIL_TEMPLATES.map((k) => (
        <option value={k}>{k}</option>
      ))}
    </select>
  </form>
  <div class="mt-6 overflow-x-auto rounded-xl border">
    <table class="w-full text-left text-sm">
      <thead class="bg-muted/60">
        <tr><th class="px-4 py-2">{t.template}</th><th class="px-4 py-2">{t.to}</th><th class="px-4 py-2">{t.status}</th><th class="px-4 py-2">{t.attempts}</th><th class="px-4 py-2"></th></tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class="border-t" data-delivery-id={row.id} title={row.lastError ?? ""}>
            <td class="px-4 py-2 font-mono text-xs">{row.templateKey} · {row.locale}</td>
            <td class="px-4 py-2">{row.toEmail}</td>
            <td class="px-4 py-2"><span class="rounded-full bg-muted px-2 py-0.5 text-xs">{row.status}</span></td>
            <td class="px-4 py-2">{row.attempts}</td>
            <td class="px-4 py-2 text-right">
              {canRetry && retryable.includes(row.status) ? <button type="button" class="text-primary underline" data-retry>{t.retry}</button> : null}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <nav class="mt-4 flex items-center gap-3 text-sm" aria-label="Pagination">
    {meta.page > 1 ? <a class="rounded-md border px-3 py-1" href={`${baseUrl}?page=${meta.page - 1}${status ? `&status=${status}` : ""}`}>{t.prev}</a> : null}
    <span>{meta.page} {t.of} {totalPages}</span>
    {meta.page < totalPages ? <a class="rounded-md border px-3 py-1" href={`${baseUrl}?page=${meta.page + 1}${status ? `&status=${status}` : ""}`}>{t.next}</a> : null}
  </nav>
</section>

<script>
  import { actions } from "astro:actions";
  document.querySelectorAll("[data-retry]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const row = (btn as HTMLElement).closest("[data-delivery-id]");
      const id = row?.getAttribute("data-delivery-id") ?? "";
      if (!id) return;
      const { error } = await actions.retryEmailDelivery({ id });
      if (error) alert(error.message);
      else window.location.reload();
    });
  });
</script>
