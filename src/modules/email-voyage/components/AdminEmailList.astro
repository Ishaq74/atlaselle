---
import { NativeSelect, NativeSelectOption } from "@atoms/native-select";
import type { Locale } from "@i18n/config";
import type { loadAdminDeliveries } from "@/modules/email-voyage/loaders/admin-email.loader";
import { VOYAGE_EMAIL_TEMPLATES, EMAIL_DELIVERY_STATUSES } from "@database/schemas/email-voyage.schema";
import { getAdminDict, adminStatusLabel } from "@i18n/admin";
import { AdminResourceShell, DataView, statusTone } from "@/core/admin";
import AdminPagination from "@molecules/AdminPagination/AdminPagination.astro";
import { Table, TableHeader, TableHead, TableBody, TableRow, TableCell } from "@atoms/table";
import { Badge } from "@atoms/badge";
import Button from "@atoms/button/Button.astro";

type Row = Awaited<ReturnType<typeof loadAdminDeliveries>>["rows"][number];

interface Props {
  rows: Row[];
  meta: { total: number; page: number; pageSize: number };
  locale: Locale;
  baseUrl: string;
  status?: string;
  templateKey?: string;
  canRetry: boolean;
}

const { rows, meta, locale, baseUrl, status, templateKey, canRetry } = Astro.props;
const totalPages = Math.max(1, Math.ceil(meta.total / meta.pageSize));
const dict = getAdminDict(locale);
const t = dict.emails;
const c = dict.common;
const col = dict.columns;
const statusLabel = (value: string) => adminStatusLabel(dict, value);
const retryable = ["failed", "dead_letter"];
const hasFilters = Boolean(status || templateKey);
const paginationUrl = new URL(Astro.url.href);
---

<AdminResourceShell title={`${t.title} (${meta.total})`}>
  <div class="space-y-4 p-4 md:p-6">
    <input type="hidden" data-emails-i18n data-error={c.error} data-retry-done={t.retryDone} />
    <form method="get" class="grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-3" data-admin-filters aria-label={c.filter}>
      <div class="flex flex-col gap-1">
        <label for="email-filter-status" class="text-sm font-medium">{col.status}</label>
        <NativeSelect id="email-filter-status" name="status" size="sm" data-autosubmit>
          <NativeSelectOption value="">{c.all}</NativeSelectOption>
          {EMAIL_DELIVERY_STATUSES.map((s) => (
            <NativeSelectOption value={s} selected={status === s}>{statusLabel(s)}</NativeSelectOption>
          ))}
        </NativeSelect>
      </div>
      <div class="flex flex-col gap-1">
        <label for="email-filter-template" class="text-sm font-medium">{col.template}</label>
        <NativeSelect id="email-filter-template" name="templateKey" size="sm" data-autosubmit>
          <NativeSelectOption value="">{c.all}</NativeSelectOption>
          {VOYAGE_EMAIL_TEMPLATES.map((k) => (
            <NativeSelectOption value={k} selected={templateKey === k}>{k}</NativeSelectOption>
          ))}
        </NativeSelect>
      </div>
      <div class="flex items-end gap-2">
        <Button type="submit" size="sm" variant="primary">{c.apply}</Button>
        <Button size="sm" variant="outline" href={baseUrl}>{c.reset}</Button>
      </div>
    </form>

    <DataView
      listLabel={dict.views.list}
      tableLabel={dict.views.table}
      cardsLabel={dict.views.cards}
      showModeSelector={rows.length > 0}
    >
      {/* Slots directs exigés : un slot nommé dans une expression
          conditionnelle n'est pas enregistré par Astro — donc plus de
          sélecteur de vue et trois vues empilées. */}
          <div slot="table">
          {rows.length === 0 ? (
            <div class="rounded-lg border border-dashed p-10 text-center">
          <p class="font-medium">{c.noResults}</p>
          <p class="mt-1 text-sm text-muted-foreground">{c.noResultsHint}</p>
          {hasFilters ? <Button class="mt-4" size="sm" variant="outline" href={baseUrl}>{c.clearFilters}</Button> : null}
            </div>
          ) : (
          <Table aria-label={t.title}>
            <TableHeader>
              <TableRow>
                <TableHead scope="col">{col.template}</TableHead>
                <TableHead scope="col">{col.recipient}</TableHead>
                <TableHead scope="col">{col.status}</TableHead>
                <TableHead scope="col">{col.attempts}</TableHead>
                <TableHead scope="col"><span class="sr-only">{c.actions}</span></TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {rows.map((row) => (
                <TableRow data-delivery-id={row.id}>
                  <TableCell class="font-mono text-xs">{row.templateKey} · {row.locale}</TableCell>
                  <TableCell class="truncate">{row.toEmail}</TableCell>
                  <TableCell><Badge variant={statusTone(row.status)} size="sm">{statusLabel(row.status)}</Badge></TableCell>
                  <TableCell>{row.attempts}</TableCell>
                  <TableCell class="text-end">
                    {canRetry && retryable.includes(row.status) ? <Button size="sm" variant="outline" data-retry>{c.retry}</Button> : "—"}
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
          )}
          </div>

          <div slot="list" class="divide-y rounded-lg border" hidden={rows.length === 0}>
            {rows.map((row) => (
              <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3" data-delivery-id={row.id}>
                <div class="min-w-0">
                  <p class="truncate font-mono text-sm">{row.templateKey}</p>
                  <p class="truncate text-xs text-muted-foreground">{row.toEmail}</p>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                  <Badge variant={statusTone(row.status)} size="sm">{statusLabel(row.status)}</Badge>
                  <span class="text-xs text-muted-foreground">{col.attempts}: {row.attempts}</span>
                  {canRetry && retryable.includes(row.status) ? <Button size="sm" variant="outline" data-retry>{c.retry}</Button> : null}
                </div>
              </div>
            ))}
          </div>

          <div slot="cards" class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3" hidden={rows.length === 0}>
            {rows.map((row) => (
              <article class="flex flex-col gap-3 rounded-lg border p-4" data-delivery-id={row.id} title={row.lastError ?? ""}>
                <div class="flex items-start justify-between gap-2">
                  <h3 class="min-w-0 truncate font-mono text-sm font-medium">{row.templateKey}</h3>
                  <Badge variant={statusTone(row.status)} size="sm">{statusLabel(row.status)}</Badge>
                </div>
                <dl class="grid grid-cols-2 gap-2 text-sm">
                  <div class="col-span-2"><dt class="text-muted-foreground">{col.recipient}</dt><dd class="truncate">{row.toEmail}</dd></div>
                  <div><dt class="text-muted-foreground">{col.locale}</dt><dd>{row.locale}</dd></div>
                  <div><dt class="text-muted-foreground">{col.attempts}</dt><dd>{row.attempts}</dd></div>
                </dl>
                <div class="mt-auto flex justify-end">
                  {canRetry && retryable.includes(row.status) ? <Button size="sm" variant="outline" data-retry>{c.retry}</Button> : null}
                </div>
              </article>
            ))}
          </div>
    </DataView>

    <AdminPagination currentPage={meta.page} totalPages={totalPages} baseUrl={paginationUrl} />
  </div>
</AdminResourceShell>

<script>
  import { actions } from "astro:actions";
  import { toast } from "@atoms/toast";

  document.querySelectorAll<HTMLSelectElement>("form[data-admin-filters] select[data-autosubmit]").forEach((select) => {
    if (select.dataset.bound === "true") return;
    select.dataset.bound = "true";
    select.addEventListener("change", () => select.form?.requestSubmit());
  });

  const i18n = document.querySelector<HTMLInputElement>("[data-emails-i18n]");

  document.querySelectorAll<HTMLButtonElement>("[data-retry]").forEach((btn) => {
    if (btn.dataset.bound === "true") return;
    btn.dataset.bound = "true";
    btn.addEventListener("click", async () => {
      const id = btn.closest<HTMLElement>("[data-delivery-id]")?.getAttribute("data-delivery-id") ?? "";
      if (!id) return;
      const { error } = await actions.retryEmailDelivery({ id });
      if (error) toast.error(error.message ?? i18n?.dataset.error ?? "");
      else {
        toast.success(i18n?.dataset.retryDone ?? "");
        window.location.reload();
      }
    });
  });
</script>
