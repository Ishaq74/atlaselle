---
import type { Locale } from "@i18n/config";
import { LOCALES } from "@i18n/config";
import type { loadAdminTripFaqs } from "@/modules/trips/loaders/admin-contents.loader";

interface Props {
  tripId: string;
  faqs: Awaited<ReturnType<typeof loadAdminTripFaqs>>;
  locale: Locale;
  canUpdate: boolean;
}

const { tripId, faqs, locale, canUpdate } = Astro.props;
const t = locale === "fr"
  ? { title: "FAQ", link: "Lier une FAQ existante", create: "Nouvelle FAQ", save: "Enregistrer", unlink: "Délier", remove: "Supprimer", confirm: "Supprimer définitivement ?" }
  : { title: "FAQ", link: "Link an existing FAQ", create: "New FAQ", save: "Save", unlink: "Unlink", remove: "Delete", confirm: "Delete permanently?" };
---
<section class="space-y-4" data-trip-id={tripId}>
  <h2 class="text-xl font-bold">{t.title} ({faqs.linked.length})</h2>
  {faqs.linked.map(({ faq, translations }) => {
    const byLocale = new Map(translations.map((x) => [x.locale, x]));
    return (
      <details class="rounded-xl border p-4" data-faq-id={faq.id}>
        <summary class="cursor-pointer font-medium">{byLocale.get(locale)?.question ?? faq.id.slice(0, 8)}</summary>
        {canUpdate ? (
          <div class="mt-3 space-y-3">
            {LOCALES.map((loc: Locale) => {
              const tr = byLocale.get(loc);
              return (
                <form data-faq-tr data-id={faq.id} data-locale={loc} class="grid gap-2 rounded-lg bg-muted/40 p-3 text-sm">
                  <h4 class="font-bold uppercase">{loc}</h4>
                  <input type="hidden" name="expectedUpdatedAt" value={tr?.updatedAt instanceof Date ? tr.updatedAt.toISOString() : ""} />
                  <input name="question" value={tr?.question ?? ""} required maxlength="500" placeholder="question" class="rounded-md border bg-background p-2" />
                  <textarea name="answer" rows="3" required placeholder="answer" class="rounded-md border bg-background p-2">{tr?.answer ?? ""}</textarea>
                  <div><button type="submit" class="rounded-md bg-primary px-3 py-1.5 font-semibold text-primary-foreground">{t.save} ({loc})</button></div>
                </form>
              );
            })}
            <div class="flex gap-3">
              <button type="button" class="text-sm text-primary underline" data-faq-unlink>{t.unlink}</button>
              <button type="button" class="text-sm text-red-600 underline" data-faq-delete>{t.remove}</button>
            </div>
          </div>
        ) : null}
      </details>
    );
  })}
  {canUpdate ? (
    <div class="grid gap-4 md:grid-cols-2">
      <form data-faq-link class="space-y-2 rounded-xl border p-4 text-sm">
        <h3 class="font-semibold">{t.link}</h3>
        <select name="faqId" class="w-full rounded-md border bg-background p-2">
          {faqs.all.map((f) => (
            <option value={f.id}>{f.id.slice(0, 8)}</option>
          ))}
        </select>
        <button type="submit" class="rounded-md bg-primary px-3 py-1.5 font-semibold text-primary-foreground">{t.save}</button>
      </form>
      <form data-faq-create class="space-y-2 rounded-xl border p-4 text-sm">
        <h3 class="font-semibold">{t.create}</h3>
        <select name="locale" class="w-full rounded-md border bg-background p-2">
          {LOCALES.map((loc: Locale) => (
            <option value={loc}>{loc}</option>
          ))}
        </select>
        <input name="question" required maxlength="500" placeholder="question" class="w-full rounded-md border bg-background p-2" />
        <textarea name="answer" required rows="3" placeholder="answer" class="w-full rounded-md border bg-background p-2"></textarea>
        <button type="submit" class="rounded-md bg-primary px-3 py-1.5 font-semibold text-primary-foreground">{t.save}</button>
      </form>
    </div>
  ) : null}
</section>

<script>
  import { actions } from "astro:actions";
  import type { Locale } from "@i18n/config";
  const root = document.querySelector("section[data-trip-id]");
  const tripId = root?.getAttribute("data-trip-id") ?? "";

  document.querySelectorAll("[data-faq-tr]").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const target = e.currentTarget as HTMLFormElement | null;
      if (!target) return;
      const data = new FormData(target);
      const { error } = await actions.upsertFaqTranslation({
        faqId: target.getAttribute("data-id") ?? "",
        expectedUpdatedAt: String(data.get("expectedUpdatedAt") ?? "") || null,
        locale: (target.getAttribute("data-locale") ?? "en") as Locale,
        question: String(data.get("question") ?? ""),
        answer: String(data.get("answer") ?? ""),
      });
      if (error) alert(error.message);
      else window.location.reload();
    });
  });

  document.querySelectorAll("[data-faq-unlink]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const box = (btn as HTMLElement).closest("[data-faq-id]");
      const faqId = box?.getAttribute("data-faq-id") ?? "";
      if (!faqId) return;
      const { error } = await actions.unlinkFaqFromTrip({ tripId, faqId });
      if (error) alert(error.message);
      else window.location.reload();
    });
  });

  document.querySelectorAll("[data-faq-delete]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const box = (btn as HTMLElement).closest("[data-faq-id]");
      const id = box?.getAttribute("data-faq-id") ?? "";
      if (!id || !window.confirm("OK?")) return;
      const { error } = await actions.deleteFaq({ id });
      if (error) alert(error.message);
      else window.location.reload();
    });
  });

  document.querySelector("[data-faq-link]")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const target = e.currentTarget as HTMLFormElement | null;
    if (!target) return;
    const data = new FormData(target);
    const { error } = await actions.linkFaqToTrip({ tripId, faqId: String(data.get("faqId") ?? "") });
    if (error) alert(error.message);
    else window.location.reload();
  });

  document.querySelector("[data-faq-create]")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const target = e.currentTarget as HTMLFormElement | null;
    if (!target) return;
    const data = new FormData(target);
    const { error } = await actions.createFaq({
      tripId,
      locale: (String(data.get("locale") ?? "en")) as Locale,
      question: String(data.get("question") ?? ""),
      answer: String(data.get("answer") ?? ""),
    });
    if (error) alert(error.message);
    else window.location.reload();
  });
</script>
