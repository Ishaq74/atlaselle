---
import type { Locale } from "@i18n/config";
import { LOCALES } from "@i18n/config";
import type { AdminTripDetail } from "@/modules/trips/loaders/admin-trips.loader";
import type { TripStatus } from "@database/schemas/trips.schema";
import type { DepartureStatus } from "@database/schemas/departures.schema";

interface Props {
  detail: AdminTripDetail;
  revisions: { id: string; createdAt: Date }[];
  locale: Locale;
  baseUrl: string;
  canUpdate: boolean;
  canPublish: boolean;
}

const { detail, revisions, locale, baseUrl, canUpdate, canPublish } = Astro.props;
const { trip, translations, departures } = detail;
const trByLocale = new Map(translations.map((t) => [t.locale, t]));
const nextTransitions: Record<TripStatus, { to: string; label: string; publish: boolean }[]> = {
  draft: [{ to: "review", label: "→ review", publish: false }],
  review: [
    { to: "approved", label: "→ approved", publish: false },
    { to: "draft", label: "→ draft", publish: false },
  ],
  approved: [{ to: "published", label: "→ published", publish: true }],
  published: [
    { to: "unpublished", label: "→ unpublished", publish: true },
    { to: "archived", label: "→ archived", publish: false },
  ],
  unpublished: [
    { to: "published", label: "→ published", publish: true },
    { to: "archived", label: "→ archived", publish: false },
  ],
  archived: [{ to: "restored", label: "→ unpublished (restore)", publish: false }],
};
const transitions = nextTransitions[trip.status as TripStatus] ?? [];
const departureStatuses: DepartureStatus[] = ["draft", "open", "limited", "waitlist", "closed", "cancelled"];
const t = locale === "fr"
  ? { facts: "Faits", save: "Enregistrer", translations: "Traductions", revisions: "Révisions", restore: "Restaurer", departures: "Départs", status: "Statut", newDeparture: "Nouveau départ", start: "Début", end: "Fin", price: "Prix (centimes)", capacity: "Capacité min/max", saved: "Enregistré.", error: "Erreur : " }
  : { facts: "Facts", save: "Save", translations: "Translations", revisions: "Revisions", restore: "Restore", departures: "Departures", status: "Status", newDeparture: "New departure", start: "Start", end: "End", price: "Price (cents)", capacity: "Capacity min/max", saved: "Saved.", error: "Error: " };
---
<section class="mx-auto max-w-6xl space-y-10 px-6 py-10" data-trip-id={trip.id}>
  <div>
    <a class="text-sm text-primary underline" href={baseUrl}>← {trip.id}</a>
    <h1 class="mt-2 text-3xl font-bold">{trByLocale.get(locale)?.title ?? trip.id}</h1>
    <p class="mt-1 text-sm text-muted-foreground">{t.status} : <span class="font-semibold">{trip.status}</span></p>
  </div>

  {transitions.length > 0 ? (
    <div class="flex flex-wrap gap-2">
      {transitions.map((tr) =>
        (tr.publish ? canPublish : canUpdate) ? (
          <button type="button" class="rounded-md border px-4 py-2 text-sm font-semibold" data-transition={tr.to}>{tr.label}</button>
        ) : null,
      )}
    </div>
  ) : null}

  {canUpdate ? (
    <form data-facts-form class="space-y-4 rounded-xl border p-6">
      <h2 class="text-xl font-bold">{t.facts}</h2>
      <input type="hidden" name="expectedUpdatedAt" value={trip.updatedAt.toISOString()} />
      <div class="grid gap-4 sm:grid-cols-3">
        <label class="block text-sm">countryCode<input name="countryCode" value={trip.countryCode} maxlength="2" class="mt-1 w-full rounded-md border bg-background p-2" /></label>
        <label class="block text-sm">defaultCurrency<input name="defaultCurrency" value={trip.defaultCurrency} maxlength="3" class="mt-1 w-full rounded-md border bg-background p-2" /></label>
        <label class="block text-sm">difficulty<input name="difficulty" value={trip.difficulty} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
        <label class="block text-sm">difficultyLevel (1-5)<input name="difficultyLevel" type="number" min="1" max="5" value={trip.difficultyLevel} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
        <label class="block text-sm">durationDays<input name="durationDays" type="number" min="1" value={trip.durationDays} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
        <label class="block text-sm">durationNights<input name="durationNights" type="number" min="0" value={trip.durationNights} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
        <label class="block text-sm">groupMin<input name="groupMin" type="number" min="1" value={trip.groupMin} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
        <label class="block text-sm">groupMax<input name="groupMax" type="number" min="1" value={trip.groupMax} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
        <label class="block text-sm">arrivalAirport<input name="arrivalAirport" value={trip.arrivalAirport ?? ""} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
        <label class="block text-sm">departureAirport<input name="departureAirport" value={trip.departureAirport ?? ""} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
        <label class="block text-sm sm:col-span-3">accommodationStyle<input name="accommodationStyle" value={trip.accommodationStyle ?? ""} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
      </div>
      <button type="submit" class="rounded-md bg-primary px-4 py-2 font-semibold text-primary-foreground">{t.save}</button>
      <output class="block text-sm" data-form-message></output>
    </form>
  ) : null}

  <div class="space-y-6">
    <h2 class="text-xl font-bold">{t.translations}</h2>
    {LOCALES.map((loc: Locale) => {
      const tr = trByLocale.get(loc);
      return (
        <form data-translation-form={loc} class="space-y-3 rounded-xl border p-6">
          <h3 class="font-bold uppercase">{loc}{tr?.localeVisible ? " · visible" : ""}</h3>
          <input type="hidden" name="expectedUpdatedAt" value={tr?.updatedAt.toISOString() ?? ""} />
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block text-sm">slug (ASCII)<input name="slug" value={tr?.slug ?? ""} required class="mt-1 w-full rounded-md border bg-background p-2" /></label>
            <label class="block text-sm">title<input name="title" value={tr?.title ?? ""} required class="mt-1 w-full rounded-md border bg-background p-2" /></label>
            <label class="block text-sm">shortTitle<input name="shortTitle" value={tr?.shortTitle ?? ""} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
            <label class="block text-sm">metaTitle<input name="metaTitle" value={tr?.metaTitle ?? ""} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
            <label class="block text-sm sm:col-span-2">summary<textarea name="summary" required rows="2" class="mt-1 w-full rounded-md border bg-background p-2">{tr?.summary ?? ""}</textarea></label>
            <label class="block text-sm sm:col-span-2">overview<textarea name="overview" required rows="4" class="mt-1 w-full rounded-md border bg-background p-2">{tr?.overview ?? ""}</textarea></label>
            <label class="block text-sm sm:col-span-2">metaDescription<textarea name="metaDescription" rows="2" class="mt-1 w-full rounded-md border bg-background p-2">{tr?.metaDescription ?? ""}</textarea></label>
            <label class="inline-flex items-center gap-2 text-sm"><input type="checkbox" name="localeVisible" checked={tr?.localeVisible ?? false} /> localeVisible</label>
          </div>
          {canUpdate ? <button type="submit" class="rounded-md bg-primary px-4 py-2 font-semibold text-primary-foreground">{t.save} ({loc})</button> : null}
          <output class="block text-sm" data-form-message></output>
        </form>
      );
    })}
  </div>

  <div class="space-y-4">
    <h2 class="text-xl font-bold">{t.revisions} ({revisions.length})</h2>
    {revisions.length > 0 ? (
      <ul class="space-y-2 text-sm">
        {revisions.map((r) => (
          <li class="flex items-center justify-between gap-4 rounded-xl border px-4 py-2" data-revision-id={r.id}>
            <span class="font-mono text-xs">{r.id.slice(0, 8)} · {r.createdAt.toISOString().slice(0, 16).replace("T", " ")}</span>
            {canUpdate ? <button type="button" class="text-primary underline" data-restore>{t.restore}</button> : null}
          </li>
        ))}
      </ul>
    ) : null}
  </div>

  <div class="space-y-4">
    <h2 class="text-xl font-bold">{t.departures} ({departures.length})</h2>
    {departures.map((d) => (
      <details class="rounded-xl border p-4" data-departure-id={d.id}>
        <summary class="cursor-pointer text-sm font-semibold">
          {d.startDate.toISOString().slice(0, 10)} → {d.endDate.toISOString().slice(0, 10)} · {d.priceAmount} {d.currency} · {d.status}
        </summary>
        <div class="mt-3 flex flex-wrap items-center gap-3 text-sm">
          <span>{t.status} :</span>
          {canUpdate ? (
            <>
              <select data-departure-status class="rounded-md border bg-background px-2 py-1">
                {departureStatuses.map((s) => (
                  <option value={s} selected={d.status === s}>{s}</option>
                ))}
              </select>
              <button type="button" class="text-primary underline" data-departure-save>OK</button>
            </>
          ) : d.status}
        </div>
        {canUpdate ? (
          <form data-departure-edit class="mt-4 grid gap-3 text-sm sm:grid-cols-3">
            <input type="hidden" name="expectedUpdatedAt" value={d.updatedAt.toISOString()} />
            <label class="block">{t.start}<input name="startDate" type="date" value={d.startDate.toISOString().slice(0, 10)} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
            <label class="block">{t.end}<input name="endDate" type="date" value={d.endDate.toISOString().slice(0, 10)} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
            <label class="block">{t.price}<input name="priceAmount" type="number" min="0" value={d.priceAmount} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
            <label class="block">currency<input name="currency" value={d.currency} maxlength="3" class="mt-1 w-full rounded-md border bg-background p-2" /></label>
            <label class="block">capacityMin<input name="capacityMin" type="number" min="1" value={d.capacityMin} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
            <label class="block">capacityMax<input name="capacityMax" type="number" min="1" value={d.capacityMax} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
            <label class="block">deposit<input name="depositAmount" type="number" min="0" value={d.depositAmount} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
            <label class="block">depositType
              <select name="depositType" class="mt-1 w-full rounded-md border bg-background p-2">
                {(["fixed", "percent", "none"] as const).map((o) => (
                  <option value={o} selected={d.depositType === o}>{o}</option>
                ))}
              </select>
            </label>
            <label class="block">depositPercent<input name="depositPercent" type="number" min="0" max="100" value={d.depositPercent} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
            <label class="block">singleSupplement<input name="singleSupplementAmount" type="number" min="0" value={d.singleSupplementAmount} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
            <label class="block">tax<input name="taxAmount" type="number" min="0" value={d.taxAmount} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
            <label class="block">fee<input name="feeAmount" type="number" min="0" value={d.feeAmount} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
            <label class="block">discount<input name="discountAmount" type="number" min="0" value={d.discountAmount} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
            <label class="block">balanceDueDate<input name="balanceDueDate" type="date" value={d.balanceDueDate?.toISOString().slice(0, 10) ?? ""} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
            <label class="block">bookingDeadline<input name="bookingDeadline" type="date" value={d.bookingDeadline?.toISOString().slice(0, 10) ?? ""} class="mt-1 w-full rounded-md border bg-background p-2" /></label>
            <label class="block sm:col-span-3">pricingRules (JSON)<textarea name="pricingRules" rows="2" class="mt-1 w-full rounded-md border bg-background p-2 font-mono text-xs">{JSON.stringify(d.pricingRules ?? {})}</textarea></label>
            <div class="sm:col-span-3"><button type="submit" class="rounded-md bg-primary px-4 py-2 font-semibold text-primary-foreground">{t.save}</button> <output class="ml-3 text-sm" data-form-message></output></div>
          </form>
        ) : null}
      </details>
    ))}
    {canUpdate ? (
      <form data-departure-form class="grid gap-4 rounded-xl border p-6 sm:grid-cols-3">
        <h3 class="font-bold sm:col-span-3">{t.newDeparture}</h3>
        <label class="block text-sm">{t.start}<input name="startDate" type="date" required class="mt-1 w-full rounded-md border bg-background p-2" /></label>
        <label class="block text-sm">{t.end}<input name="endDate" type="date" required class="mt-1 w-full rounded-md border bg-background p-2" /></label>
        <label class="block text-sm">{t.price}<input name="priceAmount" type="number" min="0" required class="mt-1 w-full rounded-md border bg-background p-2" /></label>
        <label class="block text-sm">capacityMin<input name="capacityMin" type="number" min="1" value="6" class="mt-1 w-full rounded-md border bg-background p-2" /></label>
        <label class="block text-sm">capacityMax<input name="capacityMax" type="number" min="1" value="12" class="mt-1 w-full rounded-md border bg-background p-2" /></label>
        <label class="block text-sm">currency<input name="currency" value="EUR" maxlength="3" class="mt-1 w-full rounded-md border bg-background p-2" /></label>
        <div class="sm:col-span-3"><button type="submit" class="rounded-md bg-primary px-4 py-2 font-semibold text-primary-foreground">{t.save}</button> <output class="ml-3 text-sm" data-form-message></output></div>
      </form>
    ) : null}
  </div>
</section>

<script>
  import { actions } from "astro:actions";
  import type { Locale } from "@i18n/config";
  const root = document.querySelector("section[data-trip-id]");
  const tripId = root?.getAttribute("data-trip-id") ?? "";
  const say = (form: HTMLFormElement | null, ok: boolean, text: string): void => {
    const el = form?.querySelector("[data-form-message]");
    if (el) el.textContent = (ok ? "" : "Erreur : ") + text;
  };
  const num = (v: FormDataEntryValue | null): number | undefined => (v === "" || v == null ? undefined : Number(v));
  const str = (v: FormDataEntryValue | null): string | undefined => {
    const s = String(v ?? "");
    return s === "" ? undefined : s;
  };
  const nulStr = (v: FormDataEntryValue | null): string | null => {
    const s = String(v ?? "");
    return s === "" ? null : s;
  };
  const asForm = (e: Event): HTMLFormElement | null => e.currentTarget as HTMLFormElement | null;

  document.querySelector("[data-facts-form]")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = asForm(e);
    if (!form) return;
    const data = new FormData(form);
    const { error } = await actions.updateTrip({
      id: tripId,
      expectedUpdatedAt: String(data.get("expectedUpdatedAt") ?? "") || null,
      countryCode: str(data.get("countryCode"))?.toUpperCase(),
      defaultCurrency: str(data.get("defaultCurrency"))?.toUpperCase(),
      durationDays: num(data.get("durationDays")),
      durationNights: num(data.get("durationNights")),
      groupMin: num(data.get("groupMin")),
      groupMax: num(data.get("groupMax")),
      difficulty: str(data.get("difficulty")),
      difficultyLevel: num(data.get("difficultyLevel")),
      arrivalAirport: nulStr(data.get("arrivalAirport")),
      departureAirport: nulStr(data.get("departureAirport")),
      accommodationStyle: nulStr(data.get("accommodationStyle")),
    });
    if (error) say(form, false, error.message);
    else window.location.reload();
  });

  document.querySelectorAll("[data-translation-form]").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const target = asForm(e);
      if (!target) return;
      const data = new FormData(target);
      const locale = (target.getAttribute("data-translation-form") ?? "") as Locale;
      const { error } = await actions.upsertTripTranslation({
        tripId,
        expectedUpdatedAt: String(data.get("expectedUpdatedAt") ?? "") || null,
        locale,
        slug: String(data.get("slug") ?? ""),
        title: String(data.get("title") ?? ""),
        shortTitle: str(data.get("shortTitle")) ?? null,
        summary: String(data.get("summary") ?? ""),
        overview: String(data.get("overview") ?? ""),
        metaTitle: str(data.get("metaTitle")) ?? null,
        metaDescription: str(data.get("metaDescription")) ?? null,
        localeVisible: target.querySelector<HTMLInputElement>('input[name="localeVisible"]')?.checked ?? false,
      });
      if (error) say(target, false, error.message);
      else window.location.reload();
    });
  });

  const TRANSITION_ACTIONS: Record<string, () => ReturnType<typeof actions.publishTrip>> = {
    review: () => actions.submitTripForReview({ id: tripId }),
    approved: () => actions.approveTrip({ id: tripId }),
    published: () => actions.publishTrip({ id: tripId }),
    unpublished: () => actions.unpublishTrip({ id: tripId }),
    archived: () => actions.archiveTrip({ id: tripId }),
    restored: () => actions.restoreTrip({ id: tripId }),
  };
  document.querySelectorAll("[data-transition]")?.forEach((btn) => {
    btn.addEventListener("click", async () => {
      const to = btn.getAttribute("data-transition") ?? "";
      const fn = TRANSITION_ACTIONS[to];
      if (!fn) return;
      const { error } = await fn();
      if (error) alert(error.message);
      else window.location.reload();
    });
  });

  document.querySelectorAll("[data-departure-save]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const el = btn as HTMLElement;
      const row = el.closest("[data-departure-id]");
      const id = row?.getAttribute("data-departure-id") ?? "";
      const to = row?.querySelector<HTMLSelectElement>("[data-departure-status]")?.value ?? "";
      const { error } = await actions.setDepartureStatus({ id, to: to as "open" });
      if (error) alert(error.message);
      else window.location.reload();
    });
  });

  document.querySelectorAll("[data-restore]")?.forEach((btn) => {
    btn.addEventListener("click", async () => {
      const li = (btn as HTMLElement).closest("[data-revision-id]");
      const id = li?.getAttribute("data-revision-id") ?? "";
      if (!id) return;
      const { error } = await actions.restoreTripRevision({ id });
      if (error) alert(error.message);
      else window.location.reload();
    });
  });

  document.querySelectorAll("[data-departure-edit]").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const target = asForm(e);
      if (!target) return;
      const box = target.closest("[data-departure-id]");
      const id = box?.getAttribute("data-departure-id") ?? "";
      const data = new FormData(target);
      const el = target.querySelector("[data-form-message]");
      const dateOrNull = (v: FormDataEntryValue | null): Date | null => {
        const s = String(v ?? "");
        return s ? new Date(`${s}T00:00:00.000Z`) : null;
      };
      let pricingRules: Record<string, unknown> | undefined;
      try {
        const raw = String(data.get("pricingRules") ?? "{}").trim() || "{}";
        pricingRules = JSON.parse(raw) as Record<string, unknown>;
      } catch {
        if (el) el.textContent = "pricingRules : JSON invalide";
        return;
      }
      const { error } = await actions.updateDeparture({
        id,
        expectedUpdatedAt: String(data.get("expectedUpdatedAt") ?? "") || null,
        startDate: dateOrNull(data.get("startDate")) ?? undefined,
        endDate: dateOrNull(data.get("endDate")) ?? undefined,
        capacityMin: num(data.get("capacityMin")),
        capacityMax: num(data.get("capacityMax")),
        priceAmount: num(data.get("priceAmount")),
        currency: str(data.get("currency")),
        depositAmount: num(data.get("depositAmount")),
        depositType: (String(data.get("depositType") ?? "none") || "none") as "fixed" | "percent" | "none",
        depositPercent: num(data.get("depositPercent")),
        singleSupplementAmount: num(data.get("singleSupplementAmount")),
        taxAmount: num(data.get("taxAmount")),
        feeAmount: num(data.get("feeAmount")),
        discountAmount: num(data.get("discountAmount")),
        balanceDueDate: dateOrNull(data.get("balanceDueDate")),
        bookingDeadline: dateOrNull(data.get("bookingDeadline")),
        pricingRules,
      });
      if (error) {
        if (el) el.textContent = error.message;
      } else window.location.reload();
    });
  });

  document.querySelector("[data-departure-form]")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = asForm(e);
    if (!form) return;
    const data = new FormData(form);
    const { error } = await actions.createDeparture({
      tripId,
      startDate: new Date(String(data.get("startDate"))),
      endDate: new Date(String(data.get("endDate"))),
      capacityMin: Number(data.get("capacityMin")),
      capacityMax: Number(data.get("capacityMax")),
      priceAmount: Number(data.get("priceAmount")),
      currency: String(data.get("currency") || "EUR"),
    });
    if (error) say(form, false, error.message);
    else window.location.reload();
  });
</script>
