---
/**
 * TripPageHero — en-tête de la fiche voyage.
 *
 * Même grammaire que l'article du blog : fil d'Ariane, image de couverture,
 * titre, chapô, note, puis une barre de faits. Le voile de lisibilité est
 * construit sur `background` (voir HomeHero) : un seul réglage pour les deux
 * thèmes, le contraste ne dépend pas de la photo.
 */
import { Icon } from "astro-icon/components";
import type { Locale } from "@i18n/config";
import type { TripPageDTO } from "@/modules/trips/loaders/trip.loader";
import HomeAmbient from "@pages/HomePage/HomeAmbient.astro";

interface Props {
  trip: TripPageDTO;
  locale: Locale;
  title: string;
  summary: string;
  breadcrumb: { label: string; href: string }[];
  facts: { icon: string; label: string; value: string }[];
  ratingLabel: string;
}

const { trip, locale: _locale, title, summary, breadcrumb, facts, ratingLabel } = Astro.props as Props;
---

<section class="relative isolate overflow-hidden border-b border-border/60 bg-background">
  <HomeAmbient />

  {/* Couverture — décorative, la même image est reprise en carte sticky */}
  {trip.hero && (
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <img
        src={trip.hero.url}
        alt=""
        width={trip.hero.width ?? 1600}
        height={trip.hero.height ?? 900}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-full w-full object-cover"
      />
      <div class="home-trip-veil absolute inset-0"></div>
    </div>
  )}

  <div class="mx-auto max-w-7xl px-4 pb-10 pt-8 md:px-6 md:pb-14 md:pt-10">
    <nav aria-label="Fil d'Ariane" class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground">
      <a href={breadcrumb[0].href} class="transition-colors hover:text-foreground">{breadcrumb[0].label}</a>
      {breadcrumb.slice(1).map((crumb) => (
        <>
          <Icon name="mdi:chevron-right" class="size-3.5 shrink-0" />
          {crumb.href ? (
            <a href={crumb.href} class="transition-colors hover:text-foreground">{crumb.label}</a>
          ) : (
            <span class="font-medium text-foreground">{crumb.label}</span>
          )}
        </>
      ))}
    </nav>

    <h1 class="font-heading mt-6 max-w-4xl text-balance text-4xl font-extrabold tracking-tight md:text-5xl lg:text-6xl">
      {title}
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground">{summary}</p>

    {trip.ratingCount > 0 && (
      <p class="mt-5 flex items-center gap-2 text-sm">
        <span class="text-warning" aria-hidden="true">
          {"★".repeat(Math.round(trip.ratingAverage))}
          {"☆".repeat(5 - Math.round(trip.ratingAverage))}
        </span>
        <span class="font-semibold"><bdi>{trip.ratingAverage}/5</bdi></span>
        <span class="text-muted-foreground">
          · <bdi>{trip.ratingCount}</bdi> <bdi>{ratingLabel}</bdi>
        </span>
      </p>
    )}

    <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-border/60 pt-6 sm:grid-cols-4">
      {facts.map((fact) => (
        <div class="min-w-0">
          <dt class="flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[.18em] text-muted-foreground">
            <Icon name={fact.icon} class="size-3.5 shrink-0" />
            {fact.label}
          </dt>
          <dd class="mt-1.5 text-sm font-semibold leading-snug">
            <bdi>{fact.value}</bdi>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  /* Voile de la couverture : opaque sous le texte, ouvert sur la photo. */
  .home-trip-veil {
    background: linear-gradient(
      to top,
      var(--background) 0%,
      var(--background) 30%,
      color-mix(in oklch, var(--background) 78%, transparent) 60%,
      color-mix(in oklch, var(--background) 40%, transparent) 85%,
      transparent 100%
    );
  }
</style>
