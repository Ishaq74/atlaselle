---
import type { Locale } from "@i18n/config";
import type { AdminTripRow } from "@/modules/trips/loaders/admin-trips.loader";
import type { TripStatus } from "@database/schemas/trips.schema";

interface Props {
  rows: AdminTripRow[];
  meta: { total: number; page: number; pageSize: number };
  locale: Locale;
  baseUrl: string;
  search?: string;
  status?: string;
  countryCode?: string;
  statuses: TripStatus[];
  canCreate: boolean;
}

const { rows, meta, locale, baseUrl, search, status, countryCode, statuses, canCreate } = Astro.props;
const totalPages = Math.max(1, Math.ceil(meta.total / meta.pageSize));
const qs = (over: Record<string, string>) => {
  const p = new URLSearchParams();
  if (search) p.set("search", search);
  if (status) p.set("status", status);
  if (countryCode) p.set("countryCode", countryCode);
  for (const [k, v] of Object.entries(over)) {
    if (v) p.set(k, v);
    else p.delete(k);
  }
  const s = p.toString();
  return s ? `${baseUrl}?${s}` : baseUrl;
};
const t = locale === "fr"
  ? { title: "Voyages", search: "Rechercher", status: "Statut", country: "Pays", all: "Tous", updated: "Modifié", departures: "Départs", open: "Ouvrir", create: "Nouveau voyage", createButton: "Créer (brouillon)", prev: "←", next: "→", of: "sur" }
  : { title: "Trips", search: "Search", status: "Status", country: "Country", all: "All", updated: "Updated", departures: "Departures", open: "Open", create: "New trip", createButton: "Create (draft)", prev: "←", next: "→", of: "of" };
---
<section class="mx-auto max-w-6xl px-6 py-10">
  <h1 class="text-3xl font-bold">{t.title} ({meta.total})</h1>
  <form method="get" class="mt-6 flex flex-wrap gap-3 text-sm">
    <input type="search" name="search" value={search ?? ""} placeholder={t.search} class="rounded-md border bg-background px-3 py-1.5" />
    <select name="status" class="rounded-md border bg-background px-2 py-1.5" onchange="this.form.submit()">
      <option value="">{t.status} : {t.all}</option>
      {statuses.map((s) => (
        <option value={s} selected={status === s}>{s}</option>
      ))}
    </select>
    <input name="countryCode" value={countryCode ?? ""} placeholder={t.country} maxlength="2" class="w-20 rounded-md border bg-background px-3 py-1.5 uppercase" />
    <button type="submit" class="rounded-md bg-primary px-4 py-1.5 font-semibold text-primary-foreground">OK</button>
  </form>
  <div class="mt-6 overflow-x-auto rounded-xl border">
    <table class="w-full text-left text-sm">
      <thead class="bg-muted/60">
        <tr><th class="px-4 py-2">Titre</th><th class="px-4 py-2">Statut</th><th class="px-4 py-2">{t.country}</th><th class="px-4 py-2">{t.departures}</th><th class="px-4 py-2">{t.updated}</th><th class="px-4 py-2"></th></tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class="border-t">
            <td class="px-4 py-2 font-medium">{row.title ?? row.id}</td>
            <td class="px-4 py-2"><span class="rounded-full bg-muted px-2 py-0.5 text-xs">{row.status}</span></td>
            <td class="px-4 py-2">{row.countryCode}</td>
            <td class="px-4 py-2">{row.departuresCount}</td>
            <td class="px-4 py-2">{row.updatedAt.toISOString().slice(0, 10)}</td>
            <td class="px-4 py-2 text-right"><a class="text-primary underline" href={`${baseUrl}/${row.id}`}>{t.open}</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <nav class="mt-4 flex items-center gap-3 text-sm" aria-label="Pagination">
    {meta.page > 1 ? <a class="rounded-md border px-3 py-1" href={qs({ page: String(meta.page - 1) })}>{t.prev}</a> : null}
    <span>{meta.page} {t.of} {totalPages}</span>
    {meta.page < totalPages ? <a class="rounded-md border px-3 py-1" href={qs({ page: String(meta.page + 1) })}>{t.next}</a> : null}
  </nav>
  {canCreate ? (
    <form data-trip-create class="mt-8 grid gap-4 rounded-xl border p-6 text-sm sm:grid-cols-4">
      <h2 class="font-bold sm:col-span-4">{t.create}</h2>
      <label class="block">countryCode<input name="countryCode" value="FR" maxlength="2" required class="mt-1 w-full rounded-md border bg-background p-2 uppercase" /></label>
      <label class="block">durationDays<input name="durationDays" type="number" min="1" value="7" required class="mt-1 w-full rounded-md border bg-background p-2" /></label>
      <label class="block">durationNights<input name="durationNights" type="number" min="0" value="6" required class="mt-1 w-full rounded-md border bg-background p-2" /></label>
      <label class="block">groupMin<input name="groupMin" type="number" min="1" value="6" required class="mt-1 w-full rounded-md border bg-background p-2" /></label>
      <label class="block">groupMax<input name="groupMax" type="number" min="1" value="12" required class="mt-1 w-full rounded-md border bg-background p-2" /></label>
      <div class="sm:col-span-4"><button type="submit" class="rounded-md bg-primary px-4 py-2 font-semibold text-primary-foreground">{t.createButton}</button> <output class="ml-3 text-sm" data-form-message></output></div>
    </form>
  ) : null}
</section>

<script>
  import { actions } from "astro:actions";
  document.querySelector("[data-trip-create]")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement | null;
    if (!form) return;
    const data = new FormData(form);
    const el = form.querySelector("[data-form-message]");
    const { data: result, error } = await actions.createTrip({
      countryCode: String(data.get("countryCode") ?? "FR").toUpperCase(),
      durationDays: Number(data.get("durationDays")),
      durationNights: Number(data.get("durationNights")),
      groupMin: Number(data.get("groupMin")),
      groupMax: Number(data.get("groupMax")),
    });
    if (error || !result) {
      if (el) el.textContent = error?.message ?? "Error";
    } else {
      window.location.href = `${window.location.pathname}/${result.id}`;
    }
  });
</script>
