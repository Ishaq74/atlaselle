---
import type { Locale } from "@i18n/config";
import { LOCALES } from "@i18n/config";
import type { loadAdminItinerary } from "@/modules/itinerary/loaders/admin-itinerary.loader";
import { getAdminDict } from "@i18n/admin";
import Button from "@atoms/button/Button.astro";

type Days = Awaited<ReturnType<typeof loadAdminItinerary>>;

interface Props {
  tripId: string;
  days: Days;
  locale: Locale;
  canUpdate: boolean;
}

const { tripId, days, locale, canUpdate } = Astro.props;
const dict = getAdminDict(locale);
const t = dict.tripForm;
const f = dict.tripForm.fields;
const c = dict.common;
const inputClass = "mt-1 w-full rounded-md border bg-background p-2";
const FIELDS = [
  { key: "title", label: f.title, type: "input", required: true } as const,
  { key: "morning", label: f.morning, type: "textarea" } as const,
  { key: "afternoon", label: f.afternoon, type: "textarea" } as const,
  { key: "evening", label: f.evening, type: "textarea" } as const,
];
---
<section class="space-y-4" data-trip-id={tripId}>
  <h2 class="font-heading text-xl font-semibold">{t.itinerary} ({days.length})</h2>
  {days.map(({ day, translations }) => {
    const byLocale = new Map(translations.map((x) => [x.locale, x]));
    return (
      <details class="rounded-xl border p-4">
        <summary class="cursor-pointer font-semibold">{t.day} {day.dayNumber} — {byLocale.get(locale)?.title ?? day.location ?? `#${day.dayNumber}`}</summary>
        {canUpdate ? (
          <div class="mt-4 space-y-4">
            <form id={`itinerary-day-form-${day.id}`} name={`itinerary-day-form-${day.id}`} method="post" action={Astro.url.pathname} data-day-form={day.id} class="grid gap-3 text-sm sm:grid-cols-3">
              <input type="hidden" name="expectedUpdatedAt" value={day.updatedAt.toISOString()} />
              <div class="flex flex-col"><label for={`itinerary-day-location-${day.id}`}>{f.location}</label><input id={`itinerary-day-location-${day.id}`} name="location" value={day.location ?? ""} maxlength="200" class={inputClass} /></div>
              <div class="flex flex-col"><label for={`itinerary-day-route-${day.id}`}>{f.route}</label><input id={`itinerary-day-route-${day.id}`} name="route" value={day.route ?? ""} maxlength="300" class={inputClass} /></div>
              <div class="flex items-end gap-2">
                <Button type="submit" variant="primary" size="sm">{t.save}</Button>
                <Button type="button" variant="error" size="sm" data-day-delete data-confirm={t.deleteDay}>{t.remove}</Button>
              </div>
            </form>
            {LOCALES.map((loc: Locale) => {
              const tr = byLocale.get(loc);
              return (
                <form id={`itinerary-day-translation-form-${day.id}-${loc}`} name={`itinerary-day-translation-form-${day.id}-${loc}`} method="post" action={Astro.url.pathname} data-day-tr-form={day.id} data-locale={loc} class="grid gap-3 rounded-lg bg-muted/40 p-4 text-sm">
                  <h4 class="font-bold uppercase">{loc}</h4>
                  <input type="hidden" name="expectedUpdatedAt" value={tr?.updatedAt.toISOString() ?? ""} />
                  {FIELDS.map((entry) => (
                    <div class="flex flex-col">
                      <label for={`itinerary-day-${entry.key}-${day.id}-${loc}`}>{entry.label}</label>
                      {entry.type === "input" ? (
                        <input id={`itinerary-day-${entry.key}-${day.id}-${loc}`} name={entry.key} value={tr?.[entry.key] ?? ""} required={entry.required} maxlength="300" class={inputClass} />
                      ) : (
                        <textarea id={`itinerary-day-${entry.key}-${day.id}-${loc}`} name={entry.key} rows="2" class={inputClass}>{tr?.[entry.key] ?? ""}</textarea>
                      )}
                    </div>
                  ))}
                  <div class="flex flex-wrap gap-2">
                    <Button type="submit" variant="primary" size="sm">{t.save} ({loc})</Button>
                  </div>
                </form>
              );
            })}
          </div>
        ) : null}
      </details>
    );
  })}
  {canUpdate ? (
    <form id="itinerary-day-add-form" name="itinerary-day-add-form" method="post" action={Astro.url.pathname} data-day-add class="grid gap-3 rounded-xl border p-4 text-sm sm:grid-cols-4">
      <div class="flex flex-col"><label for="itinerary-day-add-number">{t.dayNumber}</label><input id="itinerary-day-add-number" name="dayNumber" type="number" min="1" required class={inputClass} /></div>
      <div class="flex flex-col"><label for="itinerary-day-add-location">{f.location}</label><input id="itinerary-day-add-location" name="location" maxlength="200" class={inputClass} /></div>
      <div class="flex flex-col"><label for="itinerary-day-add-route">{f.route}</label><input id="itinerary-day-add-route" name="route" maxlength="300" class={inputClass} /></div>
      <div class="flex items-end"><Button type="submit" variant="primary" size="sm">{t.addDay}</Button></div>
    </form>
  ) : null}
  <input type="hidden" data-itinerary-i18n data-error={c.error} data-confirm-label={c.confirm} data-cancel-label={c.cancel} />
</section>

<script>
  import { actions } from "astro:actions";
  import type { Locale } from "@i18n/config";
  import { toast } from "@atoms/toast";
  import { confirmAdminAction } from "@/core/admin";

  const root = document.querySelector("section[data-trip-id]");
  const tripId = root?.getAttribute("data-trip-id") ?? "";
  const i18n = document.querySelector<HTMLInputElement>("[data-itinerary-i18n]");
  const opt = (v: FormDataEntryValue | null): string | null => {
    const s = String(v ?? "");
    return s === "" ? null : s;
  };
  const fail = (message: string | null | undefined) => toast.error(message ?? i18n?.dataset.error ?? "");

  document.querySelectorAll<HTMLFormElement>("[data-day-form]").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const id = form.getAttribute("data-day-form") ?? "";
      const level = Number(data.get("activityLevel") ?? "");
      const { error } = await actions.updateItineraryDay({
        id,
        expectedUpdatedAt: String(data.get("expectedUpdatedAt") ?? "") || null,
        location: opt(data.get("location")),
        route: opt(data.get("route")),
        activityLevel: Number.isFinite(level) && level >= 1 && level <= 5 ? level : null,
      });
      if (error) fail(error.message);
      else window.location.reload();
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-day-delete]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = btn.closest<HTMLFormElement>("[data-day-form]")?.getAttribute("data-day-form") ?? "";
      if (!id) return;
      const message = btn.dataset.confirm ?? "";
      const ok = await confirmAdminAction({
        title: message,
        message,
        confirmLabel: i18n?.dataset.confirmLabel ?? "OK",
        cancelLabel: i18n?.dataset.cancelLabel ?? "",
      });
      if (!ok) return;
      const { error } = await actions.deleteItineraryDay({ id });
      if (error) fail(error.message);
      else window.location.reload();
    });
  });

  document.querySelectorAll<HTMLFormElement>("[data-day-tr-form]").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const { error } = await actions.upsertItineraryDayTranslation({
        dayId: form.getAttribute("data-day-tr-form") ?? "",
        expectedUpdatedAt: String(data.get("expectedUpdatedAt") ?? "") || null,
        locale: (form.getAttribute("data-locale") ?? "en") as Locale,
        title: String(data.get("title") ?? ""),
        morning: opt(data.get("morning")),
        afternoon: opt(data.get("afternoon")),
        evening: opt(data.get("evening")),
      });
      if (error) fail(error.message);
      else window.location.reload();
    });
  });

  document.querySelector<HTMLFormElement>("[data-day-add]")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const data = new FormData(form);
    const { error } = await actions.createItineraryDay({
      tripId,
      dayNumber: Number(data.get("dayNumber")),
      location: opt(data.get("location")),
      route: opt(data.get("route")),
    });
    if (error) fail(error.message);
    else window.location.reload();
  });
</script>
