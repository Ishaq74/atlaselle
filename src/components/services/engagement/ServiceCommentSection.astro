---
/**
 * Section « commentaires » d'une prestation.
 *
 * Gabarit aligné sur `components/blog/engagement/BlogCommentSection.astro` et
 * `components/trips/engagement/TripCommentSection.astro`, y compris les trois
 * états du statut : désactivé, fermé (lecture seule), ouvert (onglets).
 */
import { Icon } from "astro-icon/components";
import type { Locale } from "@i18n/config";
import { getServiceEngagementTranslations } from "@/modules/services/i18n/engagement";
import type { ServiceEngagementCommentRow } from "@/modules/services/loaders/service-engagement.loader";
import { toCommentItem } from "@/modules/services/engagement/adapter";
import EngagementTabs from "@/components/molecules/Engagement/EngagementTabs.astro";
import EngagementCommentThread from "@/components/molecules/Engagement/EngagementCommentThread.astro";
import ServiceCommentForm from "@/components/services/engagement/ServiceCommentForm.astro";
import { Card, CardContent } from "@atoms/card";

interface Props {
  comments: ServiceEngagementCommentRow[];
  isSignedIn: boolean;
  locale: Locale;
  action: string;
}

const { comments, isSignedIn, locale, action } = Astro.props as Props;
const t = getServiceEngagementTranslations(locale);

const hasComments = comments.length > 0;
const threadLabels = { reply: t.reviewReply, pending: t.pendingModeration, anonymous: t.anonymous };
---

<section class="flex flex-col gap-6" aria-labelledby="service-comments-title">
  <h2 id="service-comments-title" class="font-heading flex items-center gap-2 text-lg font-semibold">
    <Icon name="mdi:comment-outline" class="size-5 text-muted-foreground" />
    {t.commentTitle} (<bdi>{comments.length}</bdi>)
  </h2>

  <EngagementTabs
    defaultTab={hasComments ? "list" : "write"}
    listLabel={t.commentTitle}
    listCount={comments.length}
    writeLabel={t.submitComment}
  >
    <div slot="list" class="flex flex-col gap-6">
      {hasComments ? (
        comments.map((row) => (
          <EngagementCommentThread
            locale={locale}
            comment={toCommentItem(row, t.anonymous)}
            canReply={false}
            labels={threadLabels}
            showReport={isSignedIn}
            reportLabel={t.report}
          />
        ))
      ) : (
        <Card>
          <CardContent class="py-8 text-center text-sm text-muted-foreground">
            {t.noComments}
          </CardContent>
        </Card>
      )}
    </div>

    <div slot="write">
      {isSignedIn ? (
        <ServiceCommentForm locale={locale} action={action} />
      ) : (
        <Card>
          <CardContent class="py-8 text-center text-sm text-muted-foreground">
            {t.signInRequired}
          </CardContent>
        </Card>
      )}
    </div>
  </EngagementTabs>
</section>
