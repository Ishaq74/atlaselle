---
/**
 * Formulaire d'avis sur une prestation.
 *
 * Même découpage que `components/blog/engagement/BlogReviewForm.astro` : le markup
 * vient de l'atome partagé, la soumission de `client/engagement-forms.ts`, et
 * ce composant ne porte que les libellés du domaine.
 */
import type { Locale } from "@i18n/config";
import { getServiceEngagementTranslations } from "@/modules/services/i18n/engagement";
import EngagementReviewFormCard from "@/components/molecules/Engagement/EngagementReviewFormCard.astro";

interface Props {
  locale: Locale;
  /** Cible de la soumission native sans JavaScript (`formAction("createServiceReview", …)`). */
  action: string;
  serviceId: string;
}

const { locale, action, serviceId } = Astro.props as Props;
const t = getServiceEngagementTranslations(locale);
---

<EngagementReviewFormCard
  formId="service-review-form"
  action={action}
  labels={{
    title: t.submitReview,
    yourRating: t.reviewRating,
    titlePlaceholder: t.reviewTitlePlaceholder,
    content: t.reviewContent,
    recommend: t.reviewRecommended,
    submit: t.submitReview,
    error: t.error,
    submitted: t.success,
    ratingRequired: t.ratingRequired,
  }}
>
  <input slot="hidden" type="hidden" name="serviceId" value={serviceId} />
</EngagementReviewFormCard>

<script>
  import { initServiceEngagementForms } from "@/modules/services/client/engagement-forms";

  initServiceEngagementForms();
  document.addEventListener("astro:after-swap", initServiceEngagementForms);
</script>
