---
/**
 * AdminPagination — server-side pagination controls using the existing
 * Pagination atom set. Renders page links that append `?page=N` to the
 * current URL (preserving other query params).
 */
import {
  Pagination,
  PaginationContent,
  PaginationItem,
  PaginationLink,
  PaginationPrevious,
  PaginationNext,
  PaginationEllipsis,
} from '@atoms/pagination';
import { getCommonTranslations, getLocaleFromPath } from '@i18n/utils';

interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl?: URL;
  /** Query parameter driving the page number (defaults to `page`). */
  param?: string;
}

const { currentPage, totalPages, baseUrl, param = 'page' } = Astro.props;

// Libellés repris du dictionnaire commun : la locale est déduite de l'URL
// courante (`/{locale}/admin/...`) pour éviter de la propager partout.
const commonT = await getCommonTranslations(getLocaleFromPath(Astro.url.pathname));

if (!baseUrl || totalPages <= 1) return undefined;
const base: URL = baseUrl;

/** Build a URL for the given page number, keeping other query params. */
function pageUrl(page: number): string {
  const url = new URL(base);
  url.searchParams.set(param, String(page));
  return url.pathname + url.search;
}

/** Compute which page numbers to show (current ±2, plus first/last). */
function getPageNumbers(): (number | 'ellipsis')[] {
  const pages: (number | 'ellipsis')[] = [];
  const delta = 2;
  const rangeStart = Math.max(2, currentPage - delta);
  const rangeEnd = Math.min(totalPages - 1, currentPage + delta);

  pages.push(1);
  if (rangeStart > 2) pages.push('ellipsis');
  for (let i = rangeStart; i <= rangeEnd; i++) pages.push(i);
  if (rangeEnd < totalPages - 1) pages.push('ellipsis');
  if (totalPages > 1) pages.push(totalPages);

  return pages;
}

const items = getPageNumbers();
---

<Pagination class="mt-6" label={commonT.a11y.pagination}>
  <PaginationContent>
    {currentPage > 1 && (
      <PaginationItem>
        <PaginationPrevious href={pageUrl(currentPage - 1)} label={commonT.a11y.previousPage} />
      </PaginationItem>
    )}

    {items.map((item) =>
      item === 'ellipsis' ? (
        <PaginationItem>
          <PaginationEllipsis />
        </PaginationItem>
      ) : (
        <PaginationItem>
          <PaginationLink href={pageUrl(item)} isActive={item === currentPage}>
            {item}
          </PaginationLink>
        </PaginationItem>
      ),
    )}

    {currentPage < totalPages && (
      <PaginationItem>
        <PaginationNext href={pageUrl(currentPage + 1)} label={commonT.a11y.nextPage} />
      </PaginationItem>
    )}
  </PaginationContent>
</Pagination>
