---
/**
 * EngagementCommentForm — formulaire de question / commentaire, cœur
 * présentationnel partagé entre le blog et la fiche voyage.
 *
 * Les champs invité (nom, email) ne s'affichent que pour un visiteur non
 * connecté, comme sur le blog.
 */
import { Icon } from "astro-icon/components";
import { Card, CardContent, CardHeader, CardTitle } from "@atoms/card";
import { Textarea } from "@atoms/textarea";
import { Input } from "@atoms/input";
import { Label } from "@atoms/label";
import Button from "@atoms/button/Button.astro";

interface Props {
  formId: string;
  action: string;
  /** Invite le visiteur à s'identifier : champs nom + email. */
  showGuestFields: boolean;
  parentId?: string;
  labels: {
    title: string;
    content: string;
    submit: string;
    guestName: string;
    guestEmail: string;
    error: string;
    submitted: string;
  };
}

const { formId, action, showGuestFields, parentId, labels } = Astro.props as Props;
---

<Card>
  <CardHeader>
    <CardTitle class="text-base">{labels.title}</CardTitle>
  </CardHeader>
  <CardContent>
    {/* method="post" + action explicite : première barrière structurelle contre
        la soumission native en GET vers l'URL courante — pour un visiteur
        invité, ce sont guestName + guestEmail qui partaient dans la chaîne de
        requête. Le traitement réel est un appel astro:actions.
        Les messages de retour voyagent en data-* : le script reste sans i18n. */}
    <form
      id={formId}
      name={formId}
      method="post"
      action={action}
      class="space-y-4"
      data-engagement-comment-form
      data-t-error={labels.error}
      data-t-submitted={labels.submitted}
    >
      <slot name="hidden" />
      {parentId && <input type="hidden" name="parentId" value={parentId} />}

      {showGuestFields && (
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="space-y-1.5">
            <Label for={`${formId}-guest-name`}>{labels.guestName}</Label>
            <Input id={`${formId}-guest-name`} name="guestName" type="text" required />
          </div>
          <div class="space-y-1.5">
            <Label for={`${formId}-guest-email`}>{labels.guestEmail}</Label>
            <Input id={`${formId}-guest-email`} name="guestEmail" type="email" required />
          </div>
        </div>
      )}

      <div class="space-y-1.5">
        <Label for={`${formId}-content`}>{labels.content}</Label>
        <Textarea
          id={`${formId}-content`}
          name="content"
          rows={4}
          required
          placeholder={labels.content}
        />
      </div>

      <div class="flex items-center justify-between gap-3">
        <Button type="submit" size="sm">
          <Icon name="mdi:send" class="size-4" />
          {labels.submit}
        </Button>
        <p data-comment-status class="text-sm" aria-live="polite"></p>
      </div>
    </form>
  </CardContent>
</Card>
