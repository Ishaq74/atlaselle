---
/**
 * EngagementReviewStats — résumé de note et répartition.
 *
 * Cœur présentationnel partagé blog / fiche voyage : la moyenne, les étoiles
 * et la distribution utilisent le même atome `Progress` des deux côtés.
 */
import { Icon } from "astro-icon/components";
import { Card, CardContent } from "@atoms/card";
import { Progress } from "@atoms/progress";
import StarRating from "@/components/atoms/star-rating/StarRating.astro";

interface Props {
  average: number;
  total: number;
  /** Répartition 5→1. */
  distribution: { rating: number; count: number }[];
  ratingLabel: string;
}

const { average, total, distribution, ratingLabel } = Astro.props as Props;
---

{total > 0 && (
  <Card>
    <CardContent class="py-6">
      <div class="grid items-center gap-6 sm:grid-cols-2">
        <div class="text-center">
          <p class="font-heading text-5xl font-bold"><bdi>{average}</bdi></p>
          <div class="mt-2 inline-flex text-warning">
            <StarRating rating={average} size="sm" readOnly showValue={false} />
          </div>
          <p class="mt-1 text-sm text-muted-foreground">
            <bdi>{total}</bdi>&nbsp;<bdi>{ratingLabel}</bdi>
          </p>
        </div>
        <div class="flex flex-col gap-2">
          {[5, 4, 3, 2, 1].map((star) => {
            const row = distribution.find((d) => d.rating === star);
            const count = row ? row.count : 0;
            const percent = total > 0 ? (count / total) * 100 : 0;
            return (
              <div class="flex items-center gap-2 text-sm">
                <span class="w-3"><bdi>{star}</bdi></span>
                <Icon name="mdi:star" class="size-3 text-warning" />
                <Progress value={percent} variant="warning" class="h-2 flex-1" />
                <span class="w-8 text-end text-xs text-muted-foreground"><bdi>{count}</bdi></span>
              </div>
            );
          })}
        </div>
      </div>
    </CardContent>
  </Card>
)}
