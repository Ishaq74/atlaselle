---
/**
 * EngagementReactionButtons — barre de réactions (favori + réactions).
 *
 * Cœur PRÉSENTATIONNEL, sans script : le blog, la fiche voyage et la fiche
 * prestation rendent exactement le même markup, et chacun branche ses propres
 * actions dans `modules/<domaine>/client/`. Un seul design par construction, et
 * chaque page ne charge que les actions de son domaine.
 *
 * L'état actif est porté par `aria-pressed`, et le style actif par des variants
 * Tailwind `aria-pressed:*`. Le client se contente donc de retourner
 * l'attribut : il ne manipule aucune classe, donc le rendu ne peut pas diverger
 * de l'état accessible. C'est la correction du bug où un clic ne changeait rien
 * à l'écran parce que les classes basculées n'existaient pas.
 */
import { Icon } from "astro-icon/components";
import { Button } from "@atoms/button";

const ENGAGEMENT_REACTION_ICONS: Record<string, string> = {
  LIKE: "mdi:thumb-up",
  LOVE: "mdi:heart",
  FIRE: "mdi:fire",
  CLAP: "mdi:hand-clap",
};

interface Props {
  /** Clé de réaction active pour ce visiteur, ou null. */
  activeReaction: string | null;
  /** Compteurs par type de réaction. */
  counts?: Record<string, number>;
  /** Le favori est-il actif ? */
  isFavorite?: boolean;
  /** Le blog n'a pas de favori : on masque alors le bouton. */
  showFavorite?: boolean;
  /** Le visiteur est-il connecté (sinon la barre est masquée) ? */
  isSignedIn: boolean;
  labels: {
    favorite: string;
    unfavorite: string;
    reactions: string;
    reaction: string;
  };
}

const {
  activeReaction,
  counts,
  isFavorite = false,
  showFavorite = true,
  isSignedIn,
  labels,
} = Astro.props as Props;

const entries = Object.entries(ENGAGEMENT_REACTION_ICONS);
---

{isSignedIn && (
  <div class="flex flex-wrap items-center gap-2">
    {showFavorite && (
      <button
        type="button"
        data-engagement-favorite
        aria-pressed={isFavorite}
        data-favorite-label={labels.favorite}
        data-unfavorite-label={labels.unfavorite}
        class:list={[
          "inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-sm font-medium transition",
          "aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground",
          "hover:bg-muted hover:text-foreground aria-pressed:hover:bg-primary/90",
        ]}
      >
        <Icon name="mdi:bookmark" class="size-4" />
        <span data-engagement-favorite-label>{isFavorite ? labels.unfavorite : labels.favorite}</span>
      </button>
    )}

    <span class="me-2 text-sm font-medium text-muted-foreground">{labels.reaction}</span>
    {entries.map(([type, icon]) => {
      const count = counts?.[type] ?? 0;
      const isActive = activeReaction === type;
      return (
        // La classe `reaction-btn` reste sur le bouton : c'est un point de
        // crochage stable pour les tests et le CSS applicatif, indépendant des
        // classes Tailwind qui, elles, changent avec le design. L'état actif est
        // porté par aria-pressed, dont les variantes sont déclarées plus bas.
        <Button
          type="button"
          variant="outline"
          size="sm"
          class="reaction-btn gap-1.5 aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground aria-pressed:hover:bg-primary/90"
          data-engagement-reaction={type}
          data-engagement-reaction-label={`${labels.reactions} : ${type} ({count})`}
          aria-label={`${labels.reactions} : ${type} (${count})`}
          aria-pressed={isActive ? "true" : "false"}
        >
          <Icon name={icon} class="size-4" />
          <span><bdi>{count}</bdi></span>
        </Button>
      );
    })}
  </div>
)}
