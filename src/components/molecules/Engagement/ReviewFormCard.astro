---
/**
 * EngagementReviewForm — formulaire d'avis, cœur présentationnel partagé.
 *
 * Blog et fiche voyage rendent le même formulaire ; seul le script d'action
 * diffère. Champs exposés en `data-*` et champs masqués par slot, pour que
 * chaque domaine fournisse son propre identifiant sans dupliquer le markup.
 */
import { Icon } from "astro-icon/components";
import { Card, CardContent, CardHeader, CardTitle } from "@atoms/card";
import { Textarea } from "@atoms/textarea";
import { Input } from "@atoms/input";
import { Label } from "@atoms/label";
import Button from "@atoms/button/Button.astro";
import StarRating from "@/components/blog/comments/StarRating.astro";

interface Props {
  formId: string;
  action: string;
  labels: {
    title: string;
    yourRating: string;
    titlePlaceholder: string;
    content: string;
    recommend: string;
    submit: string;
    error: string;
    submitted: string;
    ratingRequired?: string;
  };
}

const { formId, action, labels } = Astro.props as Props;
---

<Card>
  <CardHeader>
    <CardTitle class="text-base">{labels.title}</CardTitle>
  </CardHeader>
  <CardContent>
    {/* method="post" + action explicite : première barrière structurelle contre
        la soumission native en GET vers l'URL courante. Le traitement réel est
        un appel astro:actions, sans route serveur de repli : l'action pointe
        vers la page courante, qui n'expose aucun export POST, donc une
        soumission native y est rejetée sans mutation.
        Les messages de retour voyagent en data-* : le script reste sans i18n. */}
    <form
      id={formId}
      name={formId}
      method="post"
      action={action}
      class="space-y-4"
      data-engagement-review-form
      data-t-error={labels.error}
      data-t-submitted={labels.submitted}
    >
      <slot name="hidden" />

      <div class="space-y-1.5">
        <StarRating
          name="rating"
          size="lg"
          required
          showValue={false}
          legend={labels.yourRating}
          invalidText={labels.ratingRequired}
        />
      </div>

      <div class="space-y-1.5">
        <Label for={`${formId}-title`}>{labels.titlePlaceholder}</Label>
        <Input id={`${formId}-title`} name="title" type="text" placeholder={labels.titlePlaceholder} />
      </div>

      <div class="space-y-1.5">
        <Label for={`${formId}-content`}>{labels.content}</Label>
        <Textarea
          id={`${formId}-content`}
          name="content"
          rows={4}
          required
          placeholder={labels.content}
        />
      </div>

      <div class="flex items-center gap-2">
        <input
          type="checkbox"
          id={`${formId}-recommended`}
          name="isRecommended"
          value="true"
          class="rounded"
          checked
        />
        <Label for={`${formId}-recommended`} class="text-sm font-normal">{labels.recommend}</Label>
      </div>

      <div class="flex items-center justify-between gap-3">
        <Button type="submit" size="sm">
          <Icon name="mdi:send" class="size-4" />
          {labels.submit}
        </Button>
        <p data-review-status class="text-sm" aria-live="polite"></p>
      </div>
    </form>
  </CardContent>
</Card>
