---
import type { AuthTranslations, Locale } from '@i18n/config';
import type { AppUser } from '@/lib/types';
import type { VoyageHealth } from '@/modules/trips/loaders/admin-health.loader';
import type { VoyageReportingRange, VoyageTripReportRow, VoyageDepartureReportRow } from '@/modules/trips/loaders/admin-reporting.loader';
import { getAdminDict, adminStatusLabel } from '@i18n/admin';
import { statusTone } from '@/core/admin';
import { Card, CardHeader, CardTitle, CardContent } from '@atoms/card';
import { Table, TableHeader, TableHead, TableBody, TableRow, TableCell } from '@atoms/table';
import { Badge } from '@atoms/badge';

interface Props {
  t: AuthTranslations;
  locale: Locale;
  user: AppUser;
  adminStats: { totalUsers: number; recentSignups: number };
  voyageStats?: VoyageHealth | null;
  voyageReporting?: VoyageReportingRange | null;
  voyageTripReports?: VoyageTripReportRow[] | null;
  voyageDepartureReports?: VoyageDepartureReportRow[] | null;
}

const { t, locale, adminStats, voyageStats, voyageReporting, voyageTripReports, voyageDepartureReports } = Astro.props;
const ta = t.admin;
const dict = getAdminDict(locale);
const s = dict.stats;
const col = dict.columns;
const periods = [
  { key: s.day as string, data: voyageReporting?.day },
  { key: s.week as string, data: voyageReporting?.week },
  { key: s.month as string, data: voyageReporting?.month },
];
const periodRows = [
  { label: col.applications, field: "applications" as const },
  { label: col.reservations, field: "reservations" as const },
  { label: s.revenue as string, field: "revenueGross" as const },
  { label: s.views as string, field: "views" as const },
];
---

<h1 class="font-heading mb-6 text-2xl font-semibold">{ta.tabs.stats}</h1>

<div class="grid gap-4 sm:grid-cols-2">
  <Card>
    <CardHeader><CardTitle class="text-sm text-muted-foreground">{ta.stats.totalUsers}</CardTitle></CardHeader>
    <CardContent><p class="text-3xl font-bold">{adminStats.totalUsers}</p></CardContent>
  </Card>
  <Card>
    <CardHeader>
      <CardTitle class="text-sm text-muted-foreground">{ta.stats.recentSignups}</CardTitle>
    </CardHeader>
    <CardContent>
      <p class="text-3xl font-bold">{adminStats.recentSignups}</p>
      <p class="mt-1 text-xs text-muted-foreground">{ta.stats.recentSignupsDescription}</p>
    </CardContent>
  </Card>
</div>

{voyageStats ? (
  <div class="mt-8">
    <h2 class="font-heading mb-4 text-xl font-semibold">{dict.trips.title}</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <Card><CardHeader><CardTitle class="text-sm text-muted-foreground">{s.pendingApplications as string}</CardTitle></CardHeader><CardContent><p class="text-3xl font-bold">{voyageStats.pendingApplications}</p></CardContent></Card>
      <Card><CardHeader><CardTitle class="text-sm text-muted-foreground">{s.openDepartures as string}</CardTitle></CardHeader><CardContent><p class="text-3xl font-bold">{voyageStats.openDepartures}</p></CardContent></Card>
      <Card><CardHeader><CardTitle class="text-sm text-muted-foreground">{s.upcomingDepartures7d as string}</CardTitle></CardHeader><CardContent><p class="text-3xl font-bold">{voyageStats.upcomingDepartures7d}</p></CardContent></Card>
      <Card><CardHeader><CardTitle class="text-sm text-muted-foreground">{s.recentReservations7d as string}</CardTitle></CardHeader><CardContent><p class="text-3xl font-bold">{voyageStats.recentReservations7d}</p></CardContent></Card>
      <Card><CardHeader><CardTitle class="text-sm text-muted-foreground">{s.failedPayments as string}</CardTitle></CardHeader><CardContent><p class="text-3xl font-bold">{voyageStats.failedPayments}</p></CardContent></Card>
      <Card><CardHeader><CardTitle class="text-sm text-muted-foreground">{s.balancesDue as string}</CardTitle></CardHeader><CardContent><p class="text-3xl font-bold">{voyageStats.balancesDue}</p></CardContent></Card>
      <Card><CardHeader><CardTitle class="text-sm text-muted-foreground">{s.unpublishedTrips as string}</CardTitle></CardHeader><CardContent><p class="text-3xl font-bold">{voyageStats.unpublishedTrips}</p></CardContent></Card>
      <Card><CardHeader><CardTitle class="text-sm text-muted-foreground">{s.pendingComments as string}</CardTitle></CardHeader><CardContent><p class="text-3xl font-bold"><bdi>{voyageStats.pendingComments}</bdi></p></CardContent></Card>
      <Card><CardHeader><CardTitle class="text-sm text-muted-foreground">{s.pendingReviews as string}</CardTitle></CardHeader><CardContent><p class="text-3xl font-bold"><bdi>{voyageStats.pendingReviews}</bdi></p></CardContent></Card>
      <Card><CardHeader><CardTitle class="text-sm text-muted-foreground">{s.pendingReports as string}</CardTitle></CardHeader><CardContent><p class="text-3xl font-bold"><bdi>{voyageStats.pendingReports}</bdi></p></CardContent></Card>
    </div>
  </div>
) : null}

{voyageReporting ? (
  <div class="mt-8">
    <h2 class="font-heading mb-4 text-xl font-semibold">{s.reporting as string}</h2>
    <div class="grid gap-4 sm:grid-cols-3">
      {periods.map(({ key, data }) => (
        <Card>
          <CardHeader><CardTitle class="text-sm text-muted-foreground">{key}</CardTitle></CardHeader>
          <CardContent>
            {data ? (
              <dl class="space-y-1 text-sm">
                {periodRows.map(({ label, field }) => (
                  <div class="flex justify-between gap-3">
                    <dt class="text-muted-foreground">{label}</dt>
                    <dd><bdi>{data[field]}</bdi></dd>
                  </div>
                ))}
              </dl>
            ) : null}
          </CardContent>
        </Card>
      ))}
    </div>
  </div>
) : null}

{voyageTripReports && voyageTripReports.length > 0 ? (
  <div class="mt-8">
    <h2 class="font-heading mb-4 text-xl font-semibold">{s.byTrip as string}</h2>
    <div class="overflow-x-auto rounded-xl border">
      <Table aria-label={s.byTrip as string}>
        <TableHeader>
          <TableRow>
            <TableHead scope="col">{dict.trips.title}</TableHead>
            <TableHead scope="col">{col.applications}</TableHead>
            <TableHead scope="col">{s.approval as string} %</TableHead>
            <TableHead scope="col">{col.reservations}</TableHead>
            <TableHead scope="col">{s.revenue as string}</TableHead>
            <TableHead scope="col">{dict.moderation.rating as string}</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {voyageTripReports.map((row) => (
            <TableRow>
              <TableCell class="font-medium">{row.title ?? row.tripId}</TableCell>
              <TableCell><bdi>{row.applications}</bdi></TableCell>
              <TableCell><bdi>{row.approvalRate}</bdi></TableCell>
              <TableCell><bdi>{row.reservations}</bdi></TableCell>
              <TableCell><bdi>{row.revenueGross}</bdi></TableCell>
              <TableCell><bdi>{row.ratingAverage}/5 ({row.ratingCount})</bdi></TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
    </div>
  </div>
) : null}

{voyageDepartureReports && voyageDepartureReports.length > 0 ? (
  <div class="mt-8">
    <h2 class="font-heading mb-4 text-xl font-semibold">{s.byDeparture as string}</h2>
    <div class="overflow-x-auto rounded-xl border">
      <Table aria-label={s.byDeparture as string}>
        <TableHeader>
          <TableRow>
            <TableHead scope="col">{s.departure as string}</TableHead>
            <TableHead scope="col">{col.status}</TableHead>
            <TableHead scope="col">{s.occupancy as string} %</TableHead>
            <TableHead scope="col">{s.revenue as string}</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {voyageDepartureReports.map((row) => (
            <TableRow>
              <TableCell><bdi>{row.startDate.toISOString().slice(0, 10)}</bdi></TableCell>
              <TableCell><Badge variant={statusTone(row.status)} size="sm">{adminStatusLabel(dict, row.status)}</Badge></TableCell>
              <TableCell><bdi>{row.occupancyRate}</bdi></TableCell>
              <TableCell><bdi>{row.revenueGross}</bdi></TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
    </div>
  </div>
) : null}
