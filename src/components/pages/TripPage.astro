---
import type { Locale } from "@i18n/config";
import type { Trip } from "@/data/trips";
import { tripUrl } from "@/data/trips";
const { trip, locale } = Astro.props as { trip: Trip; locale: Locale };
const copy = trip.translations[locale as Exclude<Locale, "es">] ?? trip.translations.en;
const applyUrl = locale === "fr" ? `/fr/candidature/${copy.slug}` : `/${locale}/apply/${copy.slug}`;
const labels = locale === "fr" ? { dates:"Dates", price:"À partir de", places:"Places restantes", difficulty:"Niveau", itinerary:"Itinéraire", included:"Ce qui est prévu", apply:"Déposer ma candidature", room:"Hébergement", deposit:"Acompte", due:"Solde à régler avant le" } : locale === "ar" ? { dates:"التواريخ", price:"ابتداءً من", places:"المقاعد المتبقية", difficulty:"المستوى", itinerary:"خط السير", included:"ما الذي ينتظرك", apply:"قدّم طلبك", room:"الإقامة", deposit:"الدفعة المقدمة", due:"الموعد النهائي للرصيد" } : { dates:"Dates", price:"From", places:"Places remaining", difficulty:"Difficulty", itinerary:"Itinerary", included:"What awaits", apply:"Apply for this journey", room:"Rooms", deposit:"Deposit", due:"Final payment due" };
---
<section class="bg-primary px-6 py-20 text-primary-foreground"><div class="mx-auto max-w-6xl"><p class="mb-4 text-sm font-semibold uppercase tracking-[.2em]">ATLASELLE</p><h1 class="max-w-4xl text-5xl font-bold tracking-tight">{copy.title}</h1><p class="mt-6 max-w-2xl text-xl opacity-90">{copy.summary}</p></div></section>
<section class="mx-auto grid max-w-6xl gap-12 px-6 py-14 lg:grid-cols-[1fr_20rem]"><div><h2 class="text-2xl font-bold">{labels.included}</h2><ul class="mt-5 space-y-3">{copy.highlights.map((item) => <li class="border-l-2 border-primary pl-4">{item}</li>)}</ul><h2 class="mt-14 text-2xl font-bold">{labels.itinerary}</h2><ol class="mt-6 space-y-7">{copy.itinerary.map((item, index) => <li class="grid gap-2 sm:grid-cols-[3rem_1fr]"><span class="font-semibold text-primary">{String(index + 1).padStart(2,"0")}</span><div><h3 class="font-semibold">{item.title}</h3><p class="mt-1 text-muted-foreground">{item.text}</p></div></li>)}</ol></div><aside class="h-fit rounded-xl border bg-muted/40 p-6"><dl class="space-y-5 text-sm"><div><dt class="text-muted-foreground">{labels.dates}</dt><dd class="mt-1 font-semibold">{trip.dates}</dd></div><div><dt class="text-muted-foreground">{labels.price}</dt><dd class="mt-1 text-2xl font-bold">€{trip.price.toLocaleString("en")}</dd></div><div><dt class="text-muted-foreground">{labels.places}</dt><dd class="mt-1 font-semibold">{trip.remainingPlaces} / {trip.capacity}</dd></div><div><dt class="text-muted-foreground">{labels.difficulty}</dt><dd class="mt-1">{copy.difficulty}</dd></div><div><dt class="text-muted-foreground">{labels.room}</dt><dd class="mt-1">{trip.roomRule}</dd></div><div><dt class="text-muted-foreground">{labels.deposit}</dt><dd class="mt-1">€{trip.deposit}</dd></div><div><dt class="text-muted-foreground">{labels.due}</dt><dd class="mt-1">{trip.finalPaymentDue}</dd></div></dl><a class="mt-7 block rounded-md bg-primary px-4 py-3 text-center font-semibold text-primary-foreground" href={applyUrl}>{labels.apply}</a></aside></section>
