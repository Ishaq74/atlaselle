---
import type { Locale } from "@i18n/config";
import { TRIPS, tripUrl } from "@/data/trips";
const { locale } = Astro.props as { locale: Locale };
const content = locale === "fr" ? {eyebrow:"Voyages en petit groupe",title:"Voyager avec attention.",intro:"Des itinéraires culturels pensés avec soin, des rencontres locales et le temps de vraiment habiter un lieu.",journeys:"Voyages à venir",cta:"Découvrir le voyage",trust:"Petits groupes · Hébergements choisis · Accompagnement attentif",interest:"Recevez les prochaines dates",interestText:"Restez informé·e des ouvertures et nouveaux itinéraires.",button:"Rejoindre la liste d’intérêt"} : locale === "ar" ? {eyebrow:"رحلات لمجموعات صغيرة",title:"سافر بعناية.",intro:"مسارات ثقافية مصممة بتأنٍ، ولقاءات محلية، ووقت حقيقي للانتماء إلى المكان.",journeys:"الرحلات القادمة",cta:"اكتشف الرحلة",trust:"مجموعات صغيرة · إقامات مختارة · مرافقة واعية",interest:"احصل على التواريخ القادمة",interestText:"ابقَ على اطلاع بمواعيد الفتح والمسارات الجديدة.",button:"انضم إلى قائمة الاهتمام"} : {eyebrow:"Small-group journeys",title:"Travel with attention.",intro:"Thoughtfully shaped cultural journeys, rooted local encounters, and time to truly inhabit a place.",journeys:"Upcoming journeys",cta:"Discover the journey",trust:"Small groups · Considered stays · Attentive hosting",interest:"Receive upcoming dates",interestText:"Stay close to new departures and journeys.",button:"Join the interest list"};
---
<section class="bg-primary px-6 py-24 text-primary-foreground"><div class="mx-auto max-w-6xl"><p class="text-sm font-semibold uppercase tracking-[.24em]">ATLASELLE · {content.eyebrow}</p><h1 class="mt-6 max-w-3xl text-5xl font-bold tracking-tight sm:text-7xl">{content.title}</h1><p class="mt-7 max-w-2xl text-xl leading-relaxed opacity-90">{content.intro}</p><p class="mt-12 text-sm font-medium">{content.trust}</p></div></section>
<section class="mx-auto max-w-6xl px-6 py-20"><h2 class="text-3xl font-bold">{content.journeys}</h2><div class="mt-8 grid gap-6 md:grid-cols-3">{TRIPS.map((trip) => { const copy = trip.translations[locale as Exclude<Locale,"es">] ?? trip.translations.en; return <article class="flex flex-col rounded-xl border p-6"><p class="text-sm text-primary">{trip.dates}</p><h3 class="mt-4 text-2xl font-bold">{copy.title}</h3><p class="mt-3 flex-1 text-muted-foreground">{copy.summary}</p><p class="mt-6 font-semibold">€{trip.price.toLocaleString("en")}</p><a class="mt-5 font-semibold text-primary underline" href={tripUrl(locale,trip)}>{content.cta} →</a></article>})}</div></section>
<section class="bg-muted px-6 py-16"><div class="mx-auto max-w-3xl text-center"><h2 class="text-3xl font-bold">{content.interest}</h2><p class="mt-4 text-muted-foreground">{content.interestText}</p><a class="mt-7 inline-block rounded-md bg-primary px-5 py-3 font-semibold text-primary-foreground" href={locale === "fr" ? "/fr/candidature/sicile-malte" : `/${locale}/apply/sicily-malta`}>{content.button}</a></div></section>
