---
import type { Locale, BlogTranslations } from "@i18n/config";
import {
  TRIP_SLUGS,
  getAboutPath,
  getApplyPath,
  getContactPath,
  getTripPath,
  getTripsBasePath,
} from "@i18n/routes";
import type { TripDaySample, TripSummaryDTO } from "@/modules/trips/loaders/trip.loader";
import type { ServiceListItem } from "@/modules/services/domain";
import type { BlogPostListItem } from "@/lib/blog/types";
import HomeHero from "@pages/HomePage/HomeHero.astro";
import HomeMarquee from "@pages/HomePage/HomeMarquee.astro";
import HomeJourneys from "@pages/HomePage/HomeJourneys.astro";
import HomeDayJourney from "@pages/HomePage/HomeDayJourney.astro";
import HomeAbout from "@pages/HomePage/HomeAbout.astro";
import HomeServices from "@pages/HomePage/HomeServices.astro";
import HomeBlog from "@pages/HomePage/HomeBlog.astro";
import HomeClosing from "@pages/HomePage/HomeClosing.astro";
import HomeScrollExperience from "@pages/HomePage/HomeScrollExperience.astro";

interface Props {
  locale: Locale;
  trips: TripSummaryDTO[];
  services?: ServiceListItem[];
  posts?: BlogPostListItem[];
  blogT?: BlogTranslations | null;
  blogBaseUrl?: string;
  days?: TripDaySample[];
}

const {
  locale,
  trips,
  services = [],
  posts = [],
  blogT = null,
  blogBaseUrl = `/${locale}/blog`,
  days = [],
} = Astro.props as Props;

const tripsBase = getTripsBasePath(locale);
const servicesBase = `/${locale}/services`;
const aboutHref = getAboutPath(locale);
const contactHref = getContactPath(locale);
const applyHref = getApplyPath(locale, TRIP_SLUGS["sicily-malta"][locale]);

const visibleTrips = trips.slice(0, 6);
const withHero = trips.filter((t) => t.hero?.url);
const heroImages = withHero.slice(0, 3);
const heroTrip = heroImages[0] ?? trips[0] ?? null;
const featureTrip = heroTrip;
const featureHref = featureTrip ? getTripPath(locale, featureTrip.slug) : tripsBase;

type Meta = { value: string; label: string; countTo?: number };
type Phase = { key: "morning" | "afternoon" | "evening"; label: string; time: string; note: string };

const content = {
  fr: {
    chapter: { departure: "Chapitre 01", day: "Chapitre 02", steps: "Chapitre 03", group: "Chapitre 04", services: "Chapitre 05", journal: "Chapitre 06", back: "Chapitre 07" },
    credit: "Photographies — destinations Atlaselle",
    marquee: ["Petits groupes 6–14", "Hébergements choisis", "Guides locales", "Assurance expliquée", "Rythme respecté"],
    heroPrimary: "Découvrir les voyages",
    heroSecondary: "Nos services",
    dayEyebrow: "Une journée type",
    dayTitle: "On ne traverse pas un lieu. On l'habite.",
    dayIntro: "Voici une journée réelle, celle que nous proposons : des heures calmes, un rythme choisi, et le temps de rencontrer. Rien n'est pressé — c'est tout l'intérêt.",
    dayCta: "Voir le programme complet",
    phases: [
      { key: "morning", label: "Matin", time: "08:30", note: "Petit-déjeuner chez l'habitante" },
      { key: "afternoon", label: "Après-midi", time: "15:00", note: "Atelier d'artisans, temps libre" },
      { key: "evening", label: "Soir", time: "20:00", note: "Dîner partagé, puis la nuit" },
    ] as Phase[],
    metaLabels: { distance: "Distance", altitude: "Altitude", meal: "Repas", night: "Nuit" },
    dayFallback: {
      morning: "Petit-déjeuner pris chez l'habitante, puis départ vers le village voisin avec notre guide locale.",
      afternoon: "Visite d'un atelier d'artisans, temps libre pour celles qui le souhaitent, puis retour à l'hébergement.",
      evening: "Dîner partagé autour d'une même table, puis la nuit pour écouter le quartier s'endormir.",
    },
    meta: [
      { value: "6–14", label: "voyageuses par groupe" },
      { value: "4.9/5", label: "note des voyageuses", countTo: 4.9 },
      { value: "100k€+", label: "couverture assurance" },
    ] as Meta[],
  },
  en: {
    chapter: { departure: "Chapter 01", day: "Chapter 02", steps: "Chapter 03", group: "Chapter 04", services: "Chapter 05", journal: "Chapter 06", back: "Chapter 07" },
    credit: "Photography — Atlaselle destinations",
    marquee: ["Groups 6–14", "Considered stays", "Local guides", "Insurance explained", "Unhurried rhythm"],
    heroPrimary: "Discover journeys",
    heroSecondary: "Our services",
    dayEyebrow: "A typical day",
    dayTitle: "We don't cross a place. We inhabit it.",
    dayIntro: "This is a real day, the kind we propose: unhurried hours, a chosen rhythm, and time to meet. Nothing is rushed — that is the whole point.",
    dayCta: "See the full itinerary",
    phases: [
      { key: "morning", label: "Morning", time: "08:30", note: "Breakfast at your host's home" },
      { key: "afternoon", label: "Afternoon", time: "15:00", note: "Artisan workshop, free time" },
      { key: "evening", label: "Evening", time: "20:00", note: "Shared dinner, then the night" },
    ] as Phase[],
    metaLabels: { distance: "Distance", altitude: "Altitude", meal: "Meal", night: "Night" },
    dayFallback: {
      morning: "Breakfast at your host's home, then out to the neighbouring village with our local guide.",
      afternoon: "A visit to an artisan workshop, free time for whoever wants it, then back to the lodging.",
      evening: "A shared dinner around one table, then the night to listen to the neighbourhood settle.",
    },
    meta: [
      { value: "6–14", label: "travellers per group" },
      { value: "4.9/5", label: "traveller rating", countTo: 4.9 },
      { value: "€100k+", label: "required cover" },
    ] as Meta[],
  },
  es: {
    chapter: { departure: "Capítulo 01", day: "Capítulo 02", steps: "Capítulo 03", group: "Capítulo 04", services: "Capítulo 05", journal: "Capítulo 06", back: "Capítulo 07" },
    credit: "Fotografía — destinos Atlaselle",
    marquee: ["Grupos 6–14", "Alojamientos elegidos", "Guías locales", "Seguro explicado", "Ritmo respetado"],
    heroPrimary: "Descubrir los viajes",
    heroSecondary: "Nuestros servicios",
    dayEyebrow: "Un día tipo",
    dayTitle: "No atravesamos un lugar. Lo habitamos.",
    dayIntro: "Este es un día real, el que proponemos: horas sin prisa, un ritmo elegido y tiempo para encontrarse. Nada corre — ese es todo el interés.",
    dayCta: "Ver el programa completo",
    phases: [
      { key: "morning", label: "Mañana", time: "08:30", note: "Desayuno en casa de la anfitriona" },
      { key: "afternoon", label: "Tarde", time: "15:00", note: "Taller de artesanos, tiempo libre" },
      { key: "evening", label: "Noche", time: "20:00", note: "Cena compartida y la noche" },
    ] as Phase[],
    metaLabels: { distance: "Distancia", altitude: "Altitud", meal: "Comida", night: "Noche" },
    dayFallback: {
      morning: "Desayuno en casa de la anfitriona y salida al pueblo vecino con nuestra guía local.",
      afternoon: "Visita a un taller de artesanos, tiempo libre para quien quiera y vuelta al alojamiento.",
      evening: "Cena compartida alrededor de una misma mesa y la noche para escuchar al barrio dormirse.",
    },
    meta: [
      { value: "6–14", label: "viajeras por grupo" },
      { value: "4.9/5", label: "nota de las viajeras", countTo: 4.9 },
      { value: "100k€+", label: "cobertura exigida" },
    ] as Meta[],
  },
  ar: {
    chapter: { departure: "الفصل 01", day: "الفصل 02", steps: "الفصل 03", group: "الفصل 04", services: "الفصل 05", journal: "الفصل 06", back: "الفصل 07" },
    credit: "الصور — وجهات أطلسال",
    marquee: ["مجموعات 6–14", "إقامات مختارة", "مرشدات محليات", "تأمين مشروح", "إيقاع محترم"],
    heroPrimary: "اكتشف الرحلات",
    heroSecondary: "خدماتنا",
    dayEyebrow: "يوم نموذجي",
    dayTitle: "لا نعبر المكان، بل نسكنه.",
    dayIntro: "هذا يوم حقيقي، هو اليوم الذي نعرضه: ساعات دون استعجال، إيقاع مختار، ووقت للقاء. لا شيء مستعجل — وهذا هو جوهر الفكرة.",
    dayCta: "اطّلع على البرنامج الكامل",
    phases: [
      { key: "morning", label: "الصباح", time: "08:30", note: "فطور عند مضيفة الدار" },
      { key: "afternoon", label: "بعد الظهر", time: "15:00", note: "ورشة حرفيين ووقت حر" },
      { key: "evening", label: "المساء", time: "20:00", note: "عشاء مشترك ثم الليل" },
    ] as Phase[],
    metaLabels: { distance: "المسافة", altitude: "الارتفاع", meal: "الوجبة", night: "المبيت" },
    dayFallback: {
      morning: "فطور عند مضيفة الدار، ثم الانطلاق إلى القرية المجاورة مع مرشدتنا المحلية.",
      afternoon: "زيارة ورشة حرفيين، ووقت حر لمن desires ذلك، ثم العودة إلى الإقامة.",
      evening: "عشاء مشترك حول مائدة واحدة، ثم الليل للاستماع إلى هدوء الحي.",
    },
    meta: [
      { value: "6–14", label: "مسافرة في المجموعة" },
      { value: "4.9/5", label: "تقييم المسافرات", countTo: 4.9 },
      { value: "+100k€", label: "التغطية المطلوبة" },
    ] as Meta[],
  },
}[locale];

const c = content;
const heroImageArgs = heroImages.map((t) => ({
  url: t.hero!.url,
  alt: t.hero!.alt || t.title,
  width: t.hero!.width,
  height: t.hero!.height,
}));
---

<HomeHero
  chapter={c.chapter.departure}
  eyebrow={locale === "fr" ? "Voyages en petit groupe" : locale === "es" ? "Viajes en grupo pequeño" : locale === "ar" ? "رحلات لمجموعات صغيرة" : "Small-group journeys"}
  title={locale === "fr" ? "Voyager avec attention." : locale === "es" ? "Viajar con atención." : locale === "ar" ? "سافر بعناية." : "Travel with attention."}
  intro={locale === "fr" ? "Des itinéraires culturels pensés avec soin, des rencontres locales et le temps de vraiment habiter un lieu." : locale === "es" ? "Itinerarios culturales pensados con cuidado, encuentros locales y tiempo para habitar de verdad un lugar." : locale === "ar" ? "مسارات ثقافية مصممة بتأنٍ، ولقاءات محلية، ووقت حقيقي للانتماء إلى المكان." : "Thoughtfully shaped cultural journeys, rooted local encounters, and time to truly inhabit a place."}
  primaryLabel={c.heroPrimary}
  primaryHref={tripsBase}
  secondaryLabel={c.heroSecondary}
  secondaryHref={servicesBase}
  meta={c.meta}
  images={heroImageArgs}
  credit={c.credit}
  tripTitle={heroTrip?.title}
  tripDates={heroTrip?.dates}
  tripHref={featureHref}
/>

<HomeMarquee items={c.marquee} />

{days.length > 0 && (
  <HomeDayJourney
    tripTitle={featureTrip?.title ?? null}
    tripHref={featureHref}
    ctaLabel={c.dayCta}
    days={days}
    eyebrow={c.dayEyebrow}
    title={c.dayTitle}
    intro={c.dayIntro}
    phases={c.phases}
    metaLabels={c.metaLabels}
    fallback={c.dayFallback}
  />
)}

<HomeJourneys
  locale={locale}
  trips={visibleTrips}
  chapter={c.chapter.steps}
  eyebrow={locale === "fr" ? "Départs à venir" : locale === "es" ? "Próximas salidas" : locale === "ar" ? "المغادرات القادمة" : "Upcoming departures"}
  title={locale === "fr" ? "Les étapes" : locale === "es" ? "Las etapas" : locale === "ar" ? "المراحل" : "The stages"}
  intro={locale === "fr" ? "Nos prochains départs en petits groupes — mêmes fiches, mêmes prix, mêmes disponibilités que sur la page voyages." : locale === "es" ? "Nuestras próximas salidas en grupos pequeños — mismas fichas, precios y disponibilidad que en la página de viajes." : locale === "ar" ? "مغادراتنا القادمة بمجموعات صغيرة — نفس البطاقات والأسعار والتوفر كما في صفحة الرحلات." : "Our next small-group departures — same cards, prices and availability as the journeys page."}
  allLabel={locale === "fr" ? "Tous les voyages" : locale === "es" ? "Todos los viajes" : locale === "ar" ? "كل الرحلات" : "All journeys"}
  allHref={tripsBase}
/>

<HomeAbout locale={locale} chapter={c.chapter.group} aboutHref={aboutHref} contactHref={contactHref} />

{services.length > 0 && (
  <HomeServices
    locale={locale}
    services={services}
    chapter={c.chapter.services}
    eyebrow={locale === "fr" ? "Sur mesure" : locale === "es" ? "A medida" : locale === "ar" ? "حسب الطلب" : "Tailored"}
    title={locale === "fr" ? "Nos services" : locale === "es" ? "Nuestros servicios" : locale === "ar" ? "خدماتنا" : "Our services"}
    intro={locale === "fr" ? "Assurance, accompagnement et prestations choisies pour voyager sereine." : locale === "es" ? "Seguro, acompañamiento y prestaciones elegidas para viajar tranquila." : locale === "ar" ? "تأمين ومرافقة وخدمات مختارة لتسافري بطمأنينة." : "Insurance, hosting and curated extras for travelling with ease."}
    allLabel={locale === "fr" ? "Tous les services" : locale === "es" ? "Todos los servicios" : locale === "ar" ? "كل الخدمات" : "All services"}
    allHref={servicesBase}
  />
)}

{blogT && posts.length > 0 && (
  <HomeBlog
    locale={locale}
    blogT={blogT}
    posts={posts}
    baseUrl={blogBaseUrl}
    chapter={c.chapter.journal}
    eyebrow={locale === "fr" ? "Carnet de route" : locale === "es" ? "Cuaderno de ruta" : locale === "ar" ? "دفتر الطريق" : "Field notes"}
    title={locale === "fr" ? "Le carnet" : locale === "es" ? "El cuaderno" : locale === "ar" ? "الدفتر" : "The journal"}
    intro={locale === "fr" ? "Récits, conseils et coulisses de nos itinéraires." : locale === "es" ? "Relatos, consejos y entre bastidores de nuestros itinerarios." : locale === "ar" ? "قصص ونصائح وكواليس مساراتنا." : "Stories, tips and behind-the-scenes from our itineraries."}
    allLabel={locale === "fr" ? "Tous les articles" : locale === "es" ? "Todos los artículos" : locale === "ar" ? "كل المقالات" : "All articles"}
  />
)}

<HomeClosing
  chapter={c.chapter.back}
  interest={locale === "fr" ? "Recevez les prochaines dates" : locale === "es" ? "Recibe las próximas fechas" : locale === "ar" ? "احصل على التواريخ القادمة" : "Receive upcoming dates"}
  interestText={locale === "fr" ? "Restez informée des ouvertures et nouveaux itinéraires." : locale === "es" ? "Mantente informada de las aperturas y nuevos itinerarios." : locale === "ar" ? "ابقَ على اطلاع بمواعيد الفتح والمسارات الجديدة." : "Stay close to new departures and journeys."}
  button={locale === "fr" ? "Rejoindre la liste d'intérêt" : locale === "es" ? "Unirse a la lista de interés" : locale === "ar" ? "انضم إلى قائمة الاهتمام" : "Join the interest list"}
  applyHref={applyHref}
  faqTitle={locale === "fr" ? "Questions fréquentes" : locale === "es" ? "Preguntas frecuentes" : locale === "ar" ? "الأسئلة الشائعة" : "Frequently asked questions"}
  faqIntro={locale === "fr" ? "Les réponses aux questions que l'on nous pose le plus souvent avant un départ." : locale === "es" ? "Las respuestas a las preguntas que más nos hacen antes de una salida." : locale === "ar" ? "إجابات عن الأسئلة الأكثر تكراراً قبل المغادرة." : "Answers to the questions we hear most often before a departure."}
  faqs={
    locale === "fr"
      ? [
          ["Comment réserver un voyage ?", "Déposez votre candidature sur la page du voyage : nous confirmons la disponibilité avant tout paiement. L'acompte de 500 € n'est demandé qu'après acceptation."],
          ["Puis-je partir seule ?", "Oui — la moitié de nos voyageuses s'inscrivent seules. Les groupes de 6 à 14 sont composés avec soin, et chaque jour prévoit du temps libre pour celles qui le souhaitent."],
          ["Les vols internationaux sont-ils inclus ?", "Non, sauf mention expresse sur la page du voyage. Nous pouvons les réserver pour vous, et nous vous conseillons d'attendre la confirmation du départ avant tout achat non remboursable."],
          ["L'assurance voyage est-elle obligatoire ?", "Oui. Une couverture comprenant au minimum 100 000 € de frais médicaux et 250 000 € d'évacuation est exigée, avec justificatif sous 14 jours après le premier paiement. Notre service d'assurance (39 €) vous couvre en cinq minutes si besoin."],
          ["Puis-je demander une chambre individuelle ?", "Oui, selon disponibilité. Le supplément éventuel vous est communiqué avant confirmation, jamais après."],
          ["Le voyage est-il adapté si je prie ou si je jeûne ?", "Oui. Les temps calmes sont prévus chaque jour, les espaces de prière sont identifiés, et nos programmes s'adaptent pendant le Ramadan sans que personne n'ait à se justifier."],
          ["Puis-je payer en plusieurs fois ?", "Oui, sans frais. Le solde est dû 28 jours avant le départ, et nous pouvons étaler les échéances — écrivez-nous."],
        ]
      : locale === "es"
        ? [
            ["¿Cómo reservo un viaje?", "Envía tu candidatura en la página del viaje: confirmamos la disponibilidad antes de cualquier pago. El depósito de 500 € solo se pide tras la aceptación."],
            ["¿Puedo viajar sola?", "Sí — la mitad de nuestras viajeras se apuntan solas. Los grupos de 6 a 14 se componen con cuidado, y cada día prevé tiempo libre para quien lo desee."],
            ["¿Los vuelos internacionales están incluidos?", "No, salvo mención expresa en la página del viaje. Podemos reservarlos por ti y te aconsejamos esperar la confirmación de la salida antes de cualquier compra no reembolsable."],
            ["¿El seguro de viaje es obligatorio?", "Sí. Se exige una cobertura mínima de 100 000 € en gastos médicos y 250 000 € en evacuación, con justificante en 14 días tras el primer pago. Nuestro servicio de seguro (39 €) te cubre en cinco minutos si lo necesitas."],
            ["¿Puedo pedir una habitación individual?", "Sí, según disponibilidad. El suplemento eventual se te comunica antes de la confirmación, nunca después."],
            ["¿El viaje es adecuado si rezo o ayuno?", "Sí. Los tiempos de calma están previstos cada día, los espacios de oración están identificados y nuestros programas se adaptan durante el Ramadán sin que nadie tenga que justificarse."],
            ["¿Puedo pagar a plazos?", "Sí, sin coste. El saldo vence 28 días antes de la salida y podemos fraccionar los plazos — escríbenos."],
          ]
        : locale === "ar"
          ? [
              ["كيف أحجز رحلة؟", "قدّم طلبك على صفحة الرحلة؛ نؤكد التوفر قبل أي دفع. ولا تُطلب الدفعة المقدمة (500 يورو) إلا بعد القبول."],
              ["هل يمكنني السفر وحدي؟", "نعم — نصف مسافراتنا يسجلن بمفردهن. تُبنى المجموعات المكونة من 6 إلى 14 بعناية، مع وقت حر كل يوم لمن تشاء."],
              ["هل الرحلات الجوية الدولية مشمولة؟", "لا، ما لم يرد نص صريح في صفحة الرحلة. يمكننا حجزها لك، وننصحك بانتظار تأكيد المغادرة قبل أي شراء غير قابل للاسترداد."],
              ["هل تأمين السفر إلزامي؟", "نعم. تُشترط تغطية لا تقل عن 100 000 يورو للنفقات الطبية و250 000 يورو للإخلاء، مع إثبات خلال 14 يوماً من الدفعة الأولى. خدمة التأمين لدينا (39 يورو) تغطيك في خمس دقائق عند الحاجة."],
              ["هل يمكنني طلب غرفة مفردة؟", "نعم، بحسب التوفر. وأي رسوم إضافية نبلغك بها قبل التأكيد، وليس بعده أبداً."],
              ["هل الرحلة مناسبة إذا كنت أصلي أو أصوم؟", "نعم. الأوقات الهادئة مدرجة كل يوم، وأماكن الصلاة محددة، وتتكيف برامجنا خلال رمضان دون أن يضطر أحد لتبرير نفسه."],
              ["هل يمكنني الدفع على أقساط؟", "نعم، دون رسوم. يستحق الرصيد قبل 28 يوماً من المغادرة، ويمكننا تقسيط المواعيد — راسلينا."],
            ]
          : [
              ["How do I book a trip?", "Submit your application on the trip page: we confirm availability before any payment is due. The €500 deposit is only requested after acceptance."],
              ["Can I travel alone?", "Yes — half of our travellers book alone. Groups of 6 to 14 are assembled with care, and every day includes free time for those who want it."],
              ["Are international flights included?", "No, unless the trip page explicitly says so. We can book them for you, and we advise waiting for departure confirmation before any nonrefundable purchase."],
              ["Is travel insurance mandatory?", "Yes. Coverage of at least €100,000 in medical expenses and €250,000 in evacuation is required, with proof within 14 days of the first payment. Our insurance service (€39) covers you in five minutes if needed."],
              ["Can I request a single room?", "Yes, subject to availability. Any supplement is communicated before confirmation, never after."],
              ["Is the trip suitable if I pray or fast?", "Yes. Quiet time is built into every day, prayer spaces are identified, and our programmes adapt during Ramadan without anyone having to justify themselves."],
              ["Can I pay in instalments?", "Yes, at no extra cost. The balance is due 28 days before departure, and we can spread the deadlines — just write to us."],
            ]
  }
/>

<HomeScrollExperience />
