---
import type { Locale, BlogTranslations } from "@i18n/config";
import type { BlogPostListItem } from "@/lib/blog/types";
import PostCardGrid from "@/components/blog/cards/PostCardGrid.astro";
import HomeAmbient from "@pages/HomePage/HomeAmbient.astro";
import ScrollReveal from "@wow/ScrollReveal.astro";

interface Props {
  locale: Locale;
  blogT: BlogTranslations;
  posts: BlogPostListItem[];
  baseUrl: string;
  chapter: string;
  eyebrow: string;
  title: string;
  intro: string;
  allLabel: string;
}

const { locale, blogT, posts, baseUrl, chapter, eyebrow, title, intro, allLabel } = Astro.props as Props;
---

<section class="relative isolate overflow-hidden border-t border-border/60 bg-background" aria-labelledby="home-blog">
  <HomeAmbient />
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div data-home-reveal>
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
        <p class="font-mono text-[11px] uppercase tracking-[.3em] text-muted-foreground">
          <span class="text-primary">{chapter}</span>
          <span class="mx-2 opacity-40">—</span>
          {eyebrow}
        </p>
        <h2 id="home-blog" class="mt-5 text-balance text-3xl font-bold tracking-tight sm:text-4xl" data-split="lines">{title}</h2>
        <p class="mt-4 text-lg text-muted-foreground">{intro}</p>
        </div>
        <a href={baseUrl} class="inline-flex items-center gap-2 rounded-full border bg-background px-5 py-2.5 text-sm font-semibold transition hover:-translate-y-0.5 hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
          {allLabel} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post, i) => (
        <ScrollReveal delay={(i % 3) * 90} distance={28}>
          <PostCardGrid locale={locale} blogT={blogT} post={post} baseUrl={baseUrl} />
        </ScrollReveal>
      ))}
    </div>
  </div>
</section>
