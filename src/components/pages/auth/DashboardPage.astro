---
import type { AuthTranslations, Locale } from '@i18n/config';
interface Props { t: AuthTranslations; locale: Locale; user: { name?: string | null; email?: string | null }; }
const { t, user } = Astro.props;
---
<section class="mx-auto max-w-3xl px-6 py-12"><p class="text-sm font-semibold uppercase tracking-wider text-primary">ATLASELLE</p><h1 class="mt-3 text-3xl font-bold">{t.dashboard.title}</h1><p class="mt-4 text-muted-foreground">{user.name || user.email}</p></section>
