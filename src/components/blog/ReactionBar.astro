---
import type { BlogTranslations } from "@i18n/config";
import type { BlogReactionType } from "@/lib/blog/constants";
import ReactionButtons from "@/components/molecules/Engagement/ReactionButtons.astro";

interface Props {
  blogT: BlogTranslations;
  postId: string;
  reactionCounts: Record<BlogReactionType, number>;
  userReaction?: BlogReactionType | null;
}

const { blogT, postId, reactionCounts, userReaction } = Astro.props;
---

{/* Le markup vient du cœur partagé : le blog et la fiche voyage sont donc
    identiques par construction, seul le script d'action diffère. */}
<div
  data-reaction-bar
  data-post-id={postId}
  data-t-error={blogT.labels.genericError}
  data-t-updated={blogT.labels.reactionUpdated}
>
  <ReactionButtons
    activeReaction={userReaction ?? null}
    counts={reactionCounts as unknown as Record<string, number>}
    showFavorite={false}
    isSignedIn={true}
    labels={{
      favorite: "",
      unfavorite: "",
      reactions: blogT.labels.reactions,
      reaction: blogT.labels.reactions,
    }}
  />
</div>

<script>
  import { actions } from 'astro:actions';
  import { toast } from '@atoms/toast';
  import { BLOG_REACTION_TYPES, type BlogReactionType } from '@/lib/blog/constants';

  function isReactionType(value: string): value is BlogReactionType {
    return (BLOG_REACTION_TYPES as readonly string[]).includes(value);
  }

  function init() {
    document.querySelectorAll<HTMLButtonElement>('[data-engagement-reaction]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const bar = btn.closest('[data-reaction-bar]') as HTMLElement | null;
        const postId = bar?.dataset.postId;
        const reactionType = btn.dataset.engagementReaction;
        const errorText = bar?.dataset.tError ?? 'Error';
        const updatedText = bar?.dataset.tUpdated ?? 'Reaction updated';

        if (!postId || !reactionType || !isReactionType(reactionType)) return;

        const { error } = await actions.toggleBlogReaction({
          postId,
          reactionType,
        });

        if (error) {
          toast.error(error.message ?? errorText);
        } else {
          toast.success(updatedText);
          // Mise à jour locale : on évite un rechargement complet (scroll
          // préservé, pas de second téléchargement JS/CSS ni second comptage).
          const wasActive = btn.getAttribute('aria-pressed') === 'true';
          btn.setAttribute('aria-pressed', wasActive ? 'false' : 'true');
          btn.classList.toggle('variant-primary', !wasActive);
          btn.classList.toggle('variant-outline', wasActive);
          const countEl = btn.querySelector('span');
          if (countEl) {
            const current = parseInt(countEl.textContent ?? '0', 10) || 0;
            countEl.textContent = String(wasActive ? Math.max(0, current - 1) : current + 1);
          }
        }
      });
    });
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
