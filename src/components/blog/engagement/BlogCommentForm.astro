---
/**
 * Formulaire de commentaire sur un article de blog.
 *
 * Le markup vient de l'atome partagé `EngagementCommentFormCard` ; la
 * soumission est dans `modules/blog/client/engagement-forms.ts`.
 */
import type { BlogTranslations, Locale } from "@i18n/config";
import type { AppUser } from "@/lib/types";
import EngagementCommentFormCard from "@/components/molecules/Engagement/EngagementCommentFormCard.astro";

interface Props {
  locale: Locale;
  blogT: BlogTranslations;
  postId: string;
  user: AppUser | null;
  /** Rattache le commentaire à un parent (réponse). */
  parentId?: string;
}

const { blogT, postId, user, parentId } = Astro.props;
---

{/* `showGuestFields` suit la session : un visiteur connecté n'a pas à ressaisir
    son nom et son e-mail. */}
<EngagementCommentFormCard
  formId="comment-form"
  action={Astro.url.pathname}
  showGuestFields={!user}
  parentId={parentId}
  labels={{
    title: blogT.labels.writeComment,
    content: blogT.labels.writeComment,
    submit: blogT.labels.submitComment,
    guestName: blogT.labels.guestNameLabel,
    guestEmail: blogT.labels.guestEmailLabel,
    error: blogT.labels.genericError,
    submitted: blogT.labels.commentSubmitted,
  }}
>
  <input type="hidden" name="postId" value={postId} slot="hidden" />
</EngagementCommentFormCard>

<script>
  import { initBlogEngagementForms } from "@/modules/blog/client/engagement-forms";

  initBlogEngagementForms();
  document.addEventListener("astro:after-swap", initBlogEngagementForms);
</script>
