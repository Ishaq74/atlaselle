---
import { Icon } from "astro-icon/components";
import { LOCALES, LOCALE_LABELS, type Locale } from "@/core/localization";
import type { BlogTranslations } from "@i18n/config";
import type { BlogPostStatus } from "@/modules/blog/domain";
import { buildBlogPostHref } from "@/modules/blog/utils";
import { Table, TableHeader, TableHead, TableBody, TableRow, TableCell } from "@atoms/table";
import { NativeSelect, NativeSelectOption } from "@atoms/native-select";
import { Badge } from "@atoms/badge";
import Button from "@atoms/button/Button.astro";
import { Pagination, PaginationContent, PaginationItem, PaginationLink, PaginationNext, PaginationPrevious } from "@atoms/pagination";
import { DataView } from "@/core/admin";
import { getAdminDict } from "@i18n/admin";

interface AdminPostRow { post: { id: string; status: BlogPostStatus; viewCount: number; seoScore: number | null; isFeatured: boolean; isSticky: boolean; publishedAt: Date | null; createdAt: Date; updatedAt: Date }; translation: { title: string; slug: string } | null; author: { id: string; name: string | null } | null; categories: { id: string; slug: string; name: string | null }[] }
interface FilterOptions { categories: { id: string; name: string }[]; tags: { id: string; name: string }[]; authors: { id: string; name: string | null }[] }
interface Props {
  locale: Locale;
  blogT: BlogTranslations;
  rows: AdminPostRow[];
  meta: { total: number; page: number; limit: number; totalPages: number; hasNextPage: boolean; hasPrevPage: boolean };
  baseAdminUrl: string;
  basePublicUrl: string;
  canCreate: boolean;
  canUpdate: boolean;
  canPublish: boolean;
  canDelete: boolean;
  filterOptions: FilterOptions;
}
const { blogT, rows, meta, baseAdminUrl, basePublicUrl, canCreate, canUpdate, canPublish, canDelete, filterOptions, locale } = Astro.props;
const dict = getAdminDict(locale);
const params = new URLSearchParams(Astro.url.searchParams);
const current = { search: params.get("search") ?? "", status: params.get("status") ?? "", categoryId: params.get("categoryId") ?? "", tagId: params.get("tagId") ?? "", authorId: params.get("authorId") ?? "", featured: params.get("featured") ?? "", sticky: params.get("sticky") ?? "", translationLocale: params.get("translationLocale") ?? locale, sortBy: params.get("sortBy") ?? "updatedAt", sortOrder: params.get("sortOrder") ?? "desc" };
function buildPageUrl(page: number): string { const url = new URL(Astro.url.href); if (page === 1) url.searchParams.delete("page"); else url.searchParams.set("page", String(page)); return url.pathname + url.search; }
function statusVariant(status: BlogPostStatus) { return status === "PUBLISHED" ? "success" : status === "DRAFT" ? "warning" : status === "ARCHIVED" ? "secondary" : "error"; }
const pageTokens: Array<number | null> = [];
for (let i = 1; i <= meta.totalPages; i += 1) { if (i === 1 || i === meta.totalPages || (i >= meta.page - 1 && i <= meta.page + 1)) pageTokens.push(i); else if (pageTokens[pageTokens.length - 1] !== null) pageTokens.push(null); }
---
<div class="space-y-4">
  <div class="flex items-center justify-between gap-3 flex-wrap"><h2 class="font-heading text-lg font-semibold">{blogT.admin.posts}</h2>{canCreate && <Button size="sm" href={`${baseAdminUrl}/new`}><Icon name="mdi:plus" class="size-4" />{blogT.admin.newPost}</Button>}</div>
  <DataView listLabel={dict.views.list} tableLabel={dict.views.table} cardsLabel={dict.views.cards}>
    <Fragment slot="toolbar-start">
      <form method="get" class="grid w-full gap-3 rounded-lg border p-4 sm:grid-cols-2 lg:grid-cols-5" aria-label={blogT.labels.search}>
        <input name="search" value={current.search} placeholder={blogT.labels.search} aria-label={blogT.labels.search} class="h-9 rounded-md border bg-background px-3 text-sm lg:col-span-2" />
        <NativeSelect name="status" size="sm" aria-label={blogT.admin.status}><NativeSelectOption value="">{blogT.admin.status}</NativeSelectOption>{(["DRAFT", "PUBLISHED", "ARCHIVED", "DELETED"] as const).map((status) => <NativeSelectOption value={status} selected={current.status === status}>{blogT.statuses[status]}</NativeSelectOption>)}</NativeSelect>
        <NativeSelect name="categoryId" size="sm" aria-label={blogT.labels.category}><NativeSelectOption value="">{blogT.labels.categories}</NativeSelectOption>{filterOptions.categories.map((category) => <NativeSelectOption value={category.id} selected={current.categoryId === category.id}>{category.name}</NativeSelectOption>)}</NativeSelect>
        <NativeSelect name="authorId" size="sm" aria-label={blogT.labels.byAuthor}><NativeSelectOption value="">{blogT.labels.byAuthor}</NativeSelectOption>{filterOptions.authors.map((author) => <NativeSelectOption value={author.id} selected={current.authorId === author.id}>{author.name ?? blogT.admin.sidebar.unknownAuthor}</NativeSelectOption>)}</NativeSelect>
        <div class="flex flex-wrap gap-2 sm:col-span-2 lg:col-span-5">
          <NativeSelect name="tagId" size="sm" aria-label={blogT.labels.tag}><NativeSelectOption value="">{blogT.labels.tags}</NativeSelectOption>{filterOptions.tags.map((tag) => <NativeSelectOption value={tag.id} selected={current.tagId === tag.id}>{tag.name}</NativeSelectOption>)}</NativeSelect>
          <NativeSelect name="featured" size="sm" aria-label={blogT.labels.featured}><NativeSelectOption value="">{blogT.labels.featured}</NativeSelectOption><NativeSelectOption value="true" selected={current.featured === "true"}>✓</NativeSelectOption><NativeSelectOption value="false" selected={current.featured === "false"}>×</NativeSelectOption></NativeSelect>
          <NativeSelect name="sticky" size="sm" aria-label={blogT.labels.sticky}><NativeSelectOption value="">{blogT.labels.sticky}</NativeSelectOption><NativeSelectOption value="true" selected={current.sticky === "true"}>✓</NativeSelectOption><NativeSelectOption value="false" selected={current.sticky === "false"}>×</NativeSelectOption></NativeSelect>
          <NativeSelect name="translationLocale" size="sm" aria-label={blogT.admin.localeSwitcher.title}><NativeSelectOption value="">{blogT.admin.localeSwitcher.title}</NativeSelectOption>{LOCALES.map((loc) => <NativeSelectOption value={loc} selected={current.translationLocale === loc}>{LOCALE_LABELS[loc]}</NativeSelectOption>)}</NativeSelect>
          <NativeSelect name="sortBy" size="sm" aria-label={blogT.admin.sortField}><NativeSelectOption value="updatedAt" selected={current.sortBy === "updatedAt"}>{blogT.admin.fields.updatedAt}</NativeSelectOption><NativeSelectOption value="createdAt" selected={current.sortBy === "createdAt"}>{blogT.admin.fields.createdAt}</NativeSelectOption><NativeSelectOption value="publishedAt" selected={current.sortBy === "publishedAt"}>{blogT.admin.fields.publishedAt}</NativeSelectOption><NativeSelectOption value="title" selected={current.sortBy === "title"}>{blogT.admin.fields.title}</NativeSelectOption><NativeSelectOption value="viewCount" selected={current.sortBy === "viewCount"}>{blogT.admin.views}</NativeSelectOption></NativeSelect>
          <NativeSelect name="sortOrder" size="sm" aria-label={blogT.admin.sortOrder}><NativeSelectOption value="desc" selected={current.sortOrder === "desc"}>↓</NativeSelectOption><NativeSelectOption value="asc" selected={current.sortOrder === "asc"}>↑</NativeSelectOption></NativeSelect>
          <Button type="submit" size="sm">{blogT.labels.search}</Button><Button type="button" size="sm" variant="outline" href={Astro.url.pathname}>{blogT.labels.reset}</Button>
        </div>
      </form>
    </Fragment>

    <div slot="table" class="overflow-x-auto rounded-lg border">
      <Table>
        <TableHeader><TableRow><TableHead>{blogT.admin.fields.title}</TableHead><TableHead>{blogT.labels.categories}</TableHead><TableHead>{blogT.labels.byAuthor}</TableHead><TableHead>{blogT.admin.status}</TableHead><TableHead>{blogT.admin.fields.publishedAt}</TableHead><TableHead>{blogT.admin.seoScore}</TableHead><TableHead>{blogT.admin.views}</TableHead><TableHead>{blogT.admin.actions}</TableHead></TableRow></TableHeader>
        <TableBody>
          {rows.map((row) => { const editUrl = `${baseAdminUrl}/${row.post.id}/edit`; const publicUrl = row.translation ? buildBlogPostHref(basePublicUrl, row.translation.slug, row.categories[0]?.slug ?? null) : null; return <TableRow><TableCell><div class="min-w-48 space-y-0.5"><p class="font-medium">{row.translation?.title ?? row.post.id}</p><p class="text-xs text-muted-foreground">{row.translation?.slug ?? "—"}</p><div class="flex gap-1">{row.post.isFeatured && <Badge variant="outline" size="sm">{blogT.labels.featured}</Badge>}{row.post.isSticky && <Badge variant="outline" size="sm">{blogT.labels.sticky}</Badge>}</div></div></TableCell><TableCell><div class="flex min-w-32 flex-wrap gap-1">{row.categories.slice(0, 3).map((category) => <Badge variant="outline" size="sm">{category.name ?? category.slug}</Badge>)}</div></TableCell><TableCell class="whitespace-nowrap">{row.author?.name ?? blogT.admin.sidebar.unknownAuthor}</TableCell><TableCell><Badge variant={statusVariant(row.post.status)} size="sm">{blogT.statuses[row.post.status]}</Badge></TableCell><TableCell class="whitespace-nowrap text-sm">{row.post.publishedAt?.toLocaleDateString(locale) ?? "—"}</TableCell><TableCell>{row.post.seoScore ?? "—"}</TableCell><TableCell>{row.post.viewCount}</TableCell><TableCell><div class="flex min-w-52 flex-wrap items-center gap-1"><Button size="icon-sm" variant="ghost" href={editUrl} aria-label={blogT.admin.editPost}><Icon name="mdi:pencil" class="size-4" /></Button>{publicUrl && <Button size="icon-sm" variant="ghost" href={publicUrl} aria-label={blogT.admin.preview}><Icon name="mdi:open-in-new" class="size-4" /></Button>}{row.post.status === "DRAFT" && canPublish && <Button size="icon-sm" variant="ghost" class="publish-btn text-success" data-post-id={row.post.id} aria-label={blogT.admin.publish}><Icon name="mdi:publish" class="size-4" /></Button>}{row.post.status === "PUBLISHED" && canPublish && <Button size="icon-sm" variant="ghost" class="unpublish-btn" data-post-id={row.post.id} aria-label={blogT.admin.saveDraft}><Icon name="mdi:publish-off" class="size-4" /></Button>}{(row.post.status === "DRAFT" || row.post.status === "PUBLISHED") && canUpdate && <Button size="icon-sm" variant="ghost" class="archive-btn" data-post-id={row.post.id} aria-label={blogT.admin.archive}><Icon name="mdi:archive" class="size-4" /></Button>}{(row.post.status === "ARCHIVED" || row.post.status === "DELETED") && canUpdate && <Button size="icon-sm" variant="ghost" class="restore-btn" data-post-id={row.post.id} aria-label={blogT.admin.saveDraft}><Icon name="mdi:restore" class="size-4" /></Button>}{canCreate && <Button size="icon-sm" variant="ghost" class="duplicate-btn" data-post-id={row.post.id} aria-label={blogT.admin.newPost}><Icon name="mdi:content-copy" class="size-4" /></Button>}{canDelete && row.post.status !== "DELETED" && <Button size="icon-sm" variant="ghost" class="delete-btn text-error" data-post-id={row.post.id} aria-label={blogT.admin.delete}><Icon name="mdi:delete" class="size-4" /></Button>}</div></TableCell></TableRow>; })}
        </TableBody>
      </Table>
    </div>

    <div slot="cards" class="grid gap-3">
      {rows.map((row) => {
        const editUrl = `${baseAdminUrl}/${row.post.id}/edit`;
        const publicUrl = row.translation ? buildBlogPostHref(basePublicUrl, row.translation.slug, row.categories[0]?.slug ?? null) : null;
        return <article class="rounded-lg border p-4">
          <div class="flex items-start justify-between gap-3"><div class="min-w-0"><h3 class="font-medium">{row.translation?.title ?? row.post.id}</h3><p class="truncate text-xs text-muted-foreground">{row.translation?.slug ?? "—"}</p></div><Badge variant={statusVariant(row.post.status)} size="sm">{blogT.statuses[row.post.status]}</Badge></div>
          <div class="mt-3 flex flex-wrap gap-1">{row.categories.map((category) => <Badge variant="outline" size="sm">{category.name ?? category.slug}</Badge>)}{row.post.isFeatured && <Badge variant="outline" size="sm">{blogT.labels.featured}</Badge>}{row.post.isSticky && <Badge variant="outline" size="sm">{blogT.labels.sticky}</Badge>}</div>
          <dl class="mt-3 grid grid-cols-2 gap-2 text-sm"><div><dt class="text-muted-foreground">{blogT.labels.byAuthor}</dt><dd>{row.author?.name ?? blogT.admin.sidebar.unknownAuthor}</dd></div><div><dt class="text-muted-foreground">{blogT.admin.views}</dt><dd>{row.post.viewCount}</dd></div><div><dt class="text-muted-foreground">{blogT.admin.seoScore}</dt><dd>{row.post.seoScore ?? "—"}</dd></div><div><dt class="text-muted-foreground">{blogT.admin.fields.publishedAt}</dt><dd>{row.post.publishedAt?.toLocaleDateString(locale) ?? "—"}</dd></div></dl>
          <div class="mt-4 flex flex-wrap gap-1"><Button size="sm" variant="outline" href={editUrl}>{blogT.admin.editPost}</Button>{publicUrl && <Button size="sm" variant="ghost" href={publicUrl}>{blogT.admin.preview}</Button>}{row.post.status === "DRAFT" && canPublish && <Button size="sm" variant="ghost" class="publish-btn" data-post-id={row.post.id}>{blogT.admin.publish}</Button>}{row.post.status === "PUBLISHED" && canPublish && <Button size="sm" variant="ghost" class="unpublish-btn" data-post-id={row.post.id}>{blogT.admin.saveDraft}</Button>}{(row.post.status === "DRAFT" || row.post.status === "PUBLISHED") && canUpdate && <Button size="sm" variant="ghost" class="archive-btn" data-post-id={row.post.id}>{blogT.admin.archive}</Button>}{(row.post.status === "ARCHIVED" || row.post.status === "DELETED") && canUpdate && <Button size="sm" variant="ghost" class="restore-btn" data-post-id={row.post.id}>{blogT.admin.saveDraft}</Button>}{canCreate && <Button size="sm" variant="ghost" class="duplicate-btn" data-post-id={row.post.id}>{blogT.admin.newPost}</Button>}{canDelete && row.post.status !== "DELETED" && <Button size="sm" variant="ghost" class="delete-btn text-error" data-post-id={row.post.id}>{blogT.admin.delete}</Button>}</div>
        </article>;
      })}
    </div>

    <div slot="list" class="divide-y rounded-lg border">
      {rows.map((row) => {
        const editUrl = `${baseAdminUrl}/${row.post.id}/edit`;
        const publicUrl = row.translation ? buildBlogPostHref(basePublicUrl, row.translation.slug, row.categories[0]?.slug ?? null) : null;
        return <div class="flex flex-wrap items-center gap-3 px-4 py-3">
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 flex-wrap">
              <a href={editUrl} class="truncate text-sm font-medium hover:underline">{row.translation?.title ?? row.post.id}</a>
              <Badge variant={statusVariant(row.post.status)} size="sm">{blogT.statuses[row.post.status]}</Badge>
              {row.post.isFeatured && <Badge variant="outline" size="sm">{blogT.labels.featured}</Badge>}
              {row.post.isSticky && <Badge variant="outline" size="sm">{blogT.labels.sticky}</Badge>}
            </div>
            <p class="truncate text-xs text-muted-foreground">{row.author?.name ?? blogT.admin.sidebar.unknownAuthor} · {blogT.admin.views} {row.post.viewCount} · {row.post.publishedAt?.toLocaleDateString(locale) ?? "—"}</p>
          </div>
          <div class="flex shrink-0 flex-wrap items-center gap-1">
            {row.post.status === "DRAFT" && canPublish && <Button size="icon-sm" variant="ghost" class="publish-btn text-success" data-post-id={row.post.id} aria-label={blogT.admin.publish}><Icon name="mdi:publish" class="size-4" /></Button>}
            {row.post.status === "PUBLISHED" && canPublish && <Button size="icon-sm" variant="ghost" class="unpublish-btn" data-post-id={row.post.id} aria-label={blogT.admin.saveDraft}><Icon name="mdi:file-document-edit" class="size-4" /></Button>}
            {(row.post.status === "DRAFT" || row.post.status === "PUBLISHED") && canUpdate && <Button size="icon-sm" variant="ghost" class="archive-btn" data-post-id={row.post.id} aria-label={blogT.admin.archive}><Icon name="mdi:archive" class="size-4" /></Button>}
            {(row.post.status === "ARCHIVED" || row.post.status === "DELETED") && canUpdate && <Button size="icon-sm" variant="ghost" class="restore-btn" data-post-id={row.post.id} aria-label={blogT.admin.saveDraft}><Icon name="mdi:restore" class="size-4" /></Button>}
            {canCreate && <Button size="icon-sm" variant="ghost" class="duplicate-btn" data-post-id={row.post.id} aria-label={blogT.admin.newPost}><Icon name="mdi:content-copy" class="size-4" /></Button>}
            {canDelete && row.post.status !== "DELETED" && <Button size="icon-sm" variant="ghost" class="delete-btn text-error" data-post-id={row.post.id} aria-label={blogT.admin.delete}><Icon name="mdi:delete" class="size-4" /></Button>}
            {publicUrl && <Button size="icon-sm" variant="ghost" href={publicUrl} aria-label={blogT.admin.preview}><Icon name="mdi:open-in-new" class="size-4" /></Button>}
            <Button size="icon-sm" variant="ghost" href={editUrl} aria-label={blogT.admin.editPost}><Icon name="mdi:pencil" class="size-4" /></Button>
          </div>
        </div>;
      })}
    </div>
  </DataView>
  {meta.totalPages > 1 && <Pagination class="mt-6"><PaginationContent>{meta.hasPrevPage && <PaginationItem><PaginationPrevious href={buildPageUrl(meta.page - 1)} /></PaginationItem>}{pageTokens.map((token) => token === null ? <PaginationItem><span class="px-2 text-muted-foreground">…</span></PaginationItem> : <PaginationItem><PaginationLink href={buildPageUrl(token)} isActive={token === meta.page} aria-current={token === meta.page ? "page" : undefined}>{token}</PaginationLink></PaginationItem>)}{meta.hasNextPage && <PaginationItem><PaginationNext href={buildPageUrl(meta.page + 1)} /></PaginationItem>}</PaginationContent></Pagination>}
  <input type="hidden" id="admin-post-list-data" data-t-error={blogT.admin.feedback.genericError} data-t-confirm-delete={blogT.admin.feedback.confirmDeletePost} data-confirm-archive={getAdminDict(locale).common.confirmArchive} data-confirm-label={getAdminDict(locale).common.confirm} data-cancel-label={getAdminDict(locale).common.cancel} />
</div>
<script>
  import { initAdminPostList } from "@/modules/blog/client/admin-post-list";

  initAdminPostList();
  document.addEventListener("astro:after-swap", initAdminPostList);
</script>
