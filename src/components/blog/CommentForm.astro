---
import type { Locale } from "@i18n/config";
import type { BlogTranslations } from "@i18n/config";
import type { AppUser } from "@/lib/types";
import CommentFormCard from "@/components/molecules/Engagement/CommentFormCard.astro";

interface Props {
  locale: Locale;
  blogT: BlogTranslations;
  postId: string;
  user: AppUser | null;
  parentId?: string;
}

const { blogT, postId, user, parentId } = Astro.props;
---

{/* Le formulaire vient du cœur partagé : même markup que la fiche voyage,
    seul le script d'action ci-dessous est propre au blog. */}
<CommentFormCard
  formId="comment-form"
  action={Astro.url.pathname}
  showGuestFields={!user}
  parentId={parentId}
  labels={{
    title: blogT.labels.writeComment,
    content: blogT.labels.writeComment,
    submit: blogT.labels.submitComment,
    guestName: blogT.labels.guestNameLabel,
    guestEmail: blogT.labels.guestEmailLabel,
    error: blogT.labels.genericError,
    submitted: blogT.labels.commentSubmitted,
  }}
>
  <input type="hidden" name="postId" value={postId} slot="hidden" />
</CommentFormCard>

<script>
  import { actions } from 'astro:actions';
  import { toast } from '@atoms/toast';

  function init() {
    document.querySelectorAll<HTMLFormElement>('#comment-form').forEach((form) => {
      if (form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      const errorText = form.dataset.tError ?? 'Error';
      const submittedText = form.dataset.tSubmitted ?? 'Comment submitted';

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const postId = String(formData.get('postId') ?? '');
        const content = String(formData.get('content') ?? '').trim();
        const parentId = formData.get('parentId') ? String(formData.get('parentId')) : undefined;
        const guestName = formData.get('guestName') ? String(formData.get('guestName')) : undefined;
        const guestEmail = formData.get('guestEmail') ? String(formData.get('guestEmail')) : undefined;

        if (!postId || !content) return;

        const { error } = await actions.createBlogComment({
          postId,
          content,
          parentId,
          guestName,
          guestEmail,
        });

        if (error) {
          toast.error(error.message ?? errorText);
        } else {
          toast.success(submittedText);
          form.reset();
          // Le commentaire part en modération (PENDING) et n'est pas public
          // avant validation : recharger la page serait du gaspillage (scroll
          // perdu, JS/CSS re-téléchargés, compteur de vues relancé). Le toast
          // suffit.
        }
      });
    });
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
