---
import { Icon } from "astro-icon/components";
import type { BlogTranslations } from "@i18n/config";
import { Button } from "@atoms/button";

/**
 * Libellés du partage. Repris du blog par défaut, mais surchargeables pour
 * qu'un autre domaine (fiche voyage) réutilise le même composant sans copier
 * le design.
 */
export interface ShareLabels {
  share: string;
  shareOnX: string;
  shareOnFacebook: string;
  shareOnLinkedIn: string;
  copyLink: string;
  linkCopied: string;
  copyLinkError: string;
}

interface Props {
  /** Rétrocompatible : le blog passe ses traductions. */
  blogT?: BlogTranslations;
  labels?: Partial<ShareLabels>;
  url: string;
  title: string;
}

const { blogT, labels: labelOverrides, url, title } = Astro.props as Props;

const l: ShareLabels = {
  share: labelOverrides?.share ?? blogT?.labels.share ?? "Partager",
  shareOnX: labelOverrides?.shareOnX ?? blogT?.labels.shareOnX ?? "Partager sur X",
  shareOnFacebook: labelOverrides?.shareOnFacebook ?? blogT?.labels.shareOnFacebook ?? "Partager sur Facebook",
  shareOnLinkedIn: labelOverrides?.shareOnLinkedIn ?? blogT?.labels.shareOnLinkedIn ?? "Partager sur LinkedIn",
  copyLink: labelOverrides?.copyLink ?? blogT?.labels.copyLink ?? "Copier le lien",
  linkCopied: labelOverrides?.linkCopied ?? blogT?.labels.linkCopied ?? "Lien copié.",
  copyLinkError: labelOverrides?.copyLinkError ?? blogT?.labels.copyLinkError ?? "Impossible de copier le lien.",
};

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
---

<div class="flex flex-wrap items-center gap-2" data-share-bar data-t-copied={l.linkCopied} data-t-copy-error={l.copyLinkError}>
  <span class="me-2 text-sm font-medium text-muted-foreground">{l.share}</span>
  <Button
    type="button"
    variant="outline"
    size="icon-sm"
    href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={l.shareOnX}
  >
    <Icon name="mdi:twitter" class="size-4" />
  </Button>
  <Button
    type="button"
    variant="outline"
    size="icon-sm"
    href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={l.shareOnFacebook}
  >
    <Icon name="mdi:facebook" class="size-4" />
  </Button>
  <Button
    type="button"
    variant="outline"
    size="icon-sm"
    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={l.shareOnLinkedIn}
  >
    <Icon name="mdi:linkedin" class="size-4" />
  </Button>
  <Button
    type="button"
    variant="outline"
    size="icon-sm"
    id="copy-link-btn"
    aria-label={l.copyLink}
  >
    <Icon name="mdi:link" class="size-4" />
  </Button>
</div>

<script>
  import { toast } from '@atoms/toast';

  function init() {
    const btn = document.getElementById('copy-link-btn');
    const bar = btn?.closest('[data-share-bar]') as HTMLElement | null;
    const copiedText = bar?.dataset.tCopied ?? 'Link copied';
    const copyErrorText = bar?.dataset.tCopyError ?? 'Could not copy link';

    btn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        toast.success(copiedText);
      } catch {
        toast.error(copyErrorText);
      }
    });
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
