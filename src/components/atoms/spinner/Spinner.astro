---
import Loader2 from "@tabler/icons/outline/loader-2.svg";
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

type Props = Omit<HTMLAttributes<"svg">, "role" | "aria-label"> & {
  /** Libellé accessible (à traduire par l'appelant). */
  label?: string;
};

export const spinner = tv({
  base: "size-4 animate-spin",
});

const { class: className, label = "Loading", ...rest } = Astro.props;
---

<Loader2
  role="status"
  aria-label={label}
  class={spinner({ class: className })}
  {...rest}
  data-slot="spinner"
/>
