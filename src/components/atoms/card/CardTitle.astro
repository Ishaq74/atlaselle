---
import type { HTMLTag, Polymorphic } from "astro/types";
import { tv } from "tailwind-variants";

type Props<Tag extends HTMLTag = "div"> = Polymorphic<{ as: Tag }>;

export const cardTitle = tv({
  base: "font-heading text-xl leading-snug font-medium group-data-[size=sm]/card:text-base",
});

const { class: className, as: Tag = "div", ...rest } = Astro.props;
---

<Tag class={cardTitle({ class: className })} {...rest} data-slot="card-title">
  <slot />
</Tag>
