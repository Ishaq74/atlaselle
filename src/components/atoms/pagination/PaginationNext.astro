---
import ChevronRight from "@tabler/icons/outline/chevron-right.svg";
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

import { ButtonVariants } from "@atoms/button";

import PaginationLink from "./PaginationLink.astro";

type Props = HTMLAttributes<"a"> & {
  size?: VariantProps<typeof ButtonVariants.button>["size"];
  /** Libellé accessible (à traduire par l'appelant). */
  label?: string;
};

export const paginationNext = tv({ base: "group gap-1" });

const { class: className, size = "md", label = "Go to next page", ...rest } = Astro.props;
---

<PaginationLink
  aria-label={label}
  size={size}
  class={paginationNext({ class: className })}
  {...rest}
  data-slot="pagination-next"
>
  <slot />
  <slot name="icon">
    <ChevronRight class="size-4 transition-transform group-hover:translate-x-1 rtl:rotate-180" />
  </slot>
</PaginationLink>
