---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Icon } from 'astro-icon/components';
import { LOCALES, LOCALE_LABELS, type Locale } from '@i18n/config';
import { toLocale, mapStaticSlugPath, type StaticSlugMaps } from '@i18n/utils';
import frCommon from '@/i18n/fr/common';
import enCommon from '@/i18n/en/common';
import esCommon from '@/i18n/es/common';
import arCommon from '@/i18n/ar/common';
import frAuth from '@/i18n/fr/auth';
import enAuth from '@/i18n/en/auth';
import esAuth from '@/i18n/es/auth';
import arAuth from '@/i18n/ar/auth';
import {
  APPLY_SEGMENT,
  TRIP_LIST_SEGMENT,
  getApplyPath,
  getTripPath,
  getTripSlug,
  resolveTripSlug,
} from '@i18n/routes';
import {
  Dropdown,
  DropdownContent,
  DropdownItem,
  DropdownTrigger,
} from '@atoms/dropdown';

const FLAG_ICONS: Record<Locale, string> = {
  fr: 'circle-flags:fr',
  en: 'circle-flags:gb',
  es: 'circle-flags:es',
  ar: 'circle-flags:sa',
};

interface Props {
  label?: string;
}

const currentLocale = toLocale(Astro.currentLocale);
const currentPath = Astro.url.pathname;
const { label = 'Switch language' } = Astro.props;

// Extract the path after the locale prefix (e.g. /fr/about → /about)
const pathWithoutLocale = currentPath.replace(new RegExp(`^/${currentLocale}(?=/|$)`), '') || '/';

// Tables synchrones (mêmes sources que [slug].astro et auth/[slug].astro — zéro dérive).
const STATIC_MAPS: StaticSlugMaps = {
  pageRoutes: { fr: frCommon.pageRoutes, en: enCommon.pageRoutes, es: esCommon.pageRoutes, ar: arCommon.pageRoutes },
  authRoutes: { fr: frAuth.routes, en: enAuth.routes, es: esAuth.routes, ar: arAuth.routes },
};

function localizedHref(loc: Locale): string {
  const tripSegments = [...new Set(Object.values(TRIP_LIST_SEGMENT))].join('|');
  const tripMatch = currentPath.match(new RegExp(`^/(?:en|fr|es|ar)/(?:${tripSegments})/([^/]+)$`));
  if (tripMatch) {
    const tripId = resolveTripSlug(currentLocale, tripMatch[1]);
    if (tripId) return getTripPath(loc, getTripSlug(tripId, loc));
  }
  const applySegments = [...new Set(Object.values(APPLY_SEGMENT))].join('|');
  const isApply = currentPath.match(new RegExp(`^/(?:en|fr|es|ar)/(?:${applySegments})/([^/]+)$`));
  if (isApply) {
    const tripId = resolveTripSlug(currentLocale, isApply[1]);
    if (tripId) return getApplyPath(loc, getTripSlug(tripId, loc));
  }
  // Slugs structurels (about/contact/legal, auth, universelle terms — TODO §7.6 : page équivalente ou repli, jamais de contenu d'une autre langue)
  const mapped = mapStaticSlugPath(currentLocale, loc, pathWithoutLocale, STATIC_MAPS);
  if (mapped) return mapped;
  return getRelativeLocaleUrl(loc, pathWithoutLocale);
}
---

<Dropdown>
  <DropdownTrigger
    class="text-muted-foreground hover:text-foreground inline-flex size-9 cursor-pointer items-center justify-center rounded-md transition-colors"
    aria-label={label}
  >
      <Icon name={FLAG_ICONS[currentLocale]} class="size-5 rounded-sm" />
  </DropdownTrigger>
  <DropdownContent align="end">
    {LOCALES.map((loc: Locale) => {
      const isActive = loc === currentLocale;
      const href = localizedHref(loc);
      return (
        <DropdownItem
          as="a"
          href={href}
          class:list={[isActive && 'bg-accent font-medium']}
        >
          <Icon name={FLAG_ICONS[loc]} class="size-4 shrink-0 rounded-sm" />
          {LOCALE_LABELS[loc]}
        </DropdownItem>
      );
    })}
  </DropdownContent>
</Dropdown>
