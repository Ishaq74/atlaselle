---
interface Props {
  title?: string;
  description?: string;
  formSelector?: string;
}

const {
  title,
  description,
  formSelector = "form[data-admin-form], form#blog-post-form, form[method='post']",
} = Astro.props;
---
<section class="space-y-6" data-admin-form-shell data-form-selector={formSelector}>
  {(title || description) && (
    <header>
      {title ? <h1 class="font-heading text-2xl font-semibold">{title}</h1> : null}
      {description ? <p class="mt-1 text-sm text-muted-foreground">{description}</p> : null}
    </header>
  )}
  <slot />
</section>

<script>
  import { registerAdminDirtyGuard } from "@/core/admin/dirty-guard";

  function initAdminFormShell() {
    document.querySelectorAll<HTMLElement>("[data-admin-form-shell]").forEach((shell) => {
      const selector = shell.dataset.formSelector ?? "form[data-admin-form], form[method='post']";
      registerAdminDirtyGuard({ formSelector: selector, root: shell });
    });
    // Les formulaires hors shell suivent la même implémentation : un seul état,
    // un seul écouteur `beforeunload` pour tout le back-office.
    registerAdminDirtyGuard();
  }

  initAdminFormShell();
  document.addEventListener("astro:after-swap", initAdminFormShell);
</script>
