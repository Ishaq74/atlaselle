---
/**
 * TripItinerary — le programme, jour par jour.
 *
 * Une timeline verticale : c'est la même métaphore que le fil du chapitre 02
 * de l'accueil, et le voyage se lit alors comme un récit plutôt qu'une liste.
 */
import { Icon } from "astro-icon/components";
import ScrollReveal from "@wow/ScrollReveal.astro";

interface Props {
  itinerary: { title: string; text: string }[];
  dayLabel: (index: number) => string;
}

const { itinerary, dayLabel } = Astro.props as Props;
---

<section aria-labelledby="trip-itinerary">
  <ol class="relative flex flex-col gap-8 ps-10 sm:gap-10 sm:ps-12">
    <span
      class="pointer-events-none absolute inset-y-2 start-0 w-px bg-border"
      aria-hidden="true"
    ></span>
    {itinerary.map((day, index) => (
      <li class="relative" data-itinerary-day={index}>
        <ScrollReveal distance={24}>
          <span
            class="absolute -start-10 top-0.5 grid size-7 place-items-center rounded-full border bg-background font-mono text-[11px] font-bold text-primary sm:-start-12"
            aria-hidden="true"
          >
            {String(index + 1).padStart(2, "0")}
          </span>
          <p class="font-mono text-[10px] uppercase tracking-[.2em] text-muted-foreground">
            {dayLabel(index)}
          </p>
          <h3 class="font-heading mt-1.5 text-xl font-semibold tracking-tight">{day.title}</h3>
          {day.text && <p class="mt-2.5 leading-relaxed text-muted-foreground">{day.text}</p>}
        </ScrollReveal>
      </li>
    ))}
    {itinerary.length === 0 && (
      <li class="flex items-center gap-2 text-sm text-muted-foreground">
        <Icon name="mdi:information-outline" class="size-4 shrink-0" />
        <span>Le programme détaillé est communiqué après acceptation de votre candidature.</span>
      </li>
    )}
  </ol>
</section>
