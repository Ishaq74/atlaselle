---
/**
 * TripBookingCard — la carte de réservation collante.
 *
 * C'est la seule action de la page : elle reste donc visible en permanence
 * pendant que le voyageur lit le programme. Le prix, l'acompte et la date
 * limite du solde sont affichés ensemble — c'est la transparence qui fait
 * accepter la candidature.
 */
import { Icon } from "astro-icon/components";
import { Card, CardContent } from "@atoms/card";
import { Button } from "@atoms/button";
import { isLastSeats } from "@/modules/availability/domain/availability";

interface Props {
  locale: string;
  price: number;
  pricePrefix: string;
  dates: string;
  remainingPlaces: number;
  capacity: number;
  status: "open" | "interest-list";
  /** Admin connecté : conserve le ratio exact X/Y (outil de gestion). */
  isAdmin?: boolean;
  deposit: number;
  /** Early bird recalculé serveur — affiché seulement quand la fenêtre est active. */
  earlyBird?: { active: boolean; discount: number; fullPayment: boolean; until: string } | null;
  finalPaymentDue: string;
  roomRule: string;
  difficulty: string;
  applyUrl: string;
  labels: {
    status: string;
    open: string;
    interest: string;
    places: string;
    lastSeat: string;
    lastSpots: string;
    priceFrom: string;
    deposit: string;
    balance: string;
    earlyBirdPrefix: string;
    earlyBirdUntil: string;
    fullPayment: string;
    lodging: string;
    difficulty: string;
    apply: string;
    reassurance: string;
  };
}

const {
  price,
  pricePrefix,
  dates,
  remainingPlaces,
  capacity,
  status,
  deposit,
  earlyBird = null,
  finalPaymentDue,
  roomRule,
  difficulty,
  applyUrl,
  labels,
  isAdmin = false,
} = Astro.props as Props;

const open = status === "open";
/** Early bird actif uniquement : la promo s'éteint d'elle-même une fois la fenêtre passée. */
const eb = earlyBird !== null && earlyBird.active ? earlyBird : null;
---

<Card class="overflow-hidden">
  <CardContent>
    <div class="flex flex-col gap-5">
      {/* Statut + prix — l'information la plus scrutée */}
      <div>
        <span
          class:list={[
            "inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold",
            {"bg-success/10 text-success": open, "bg-primary/15 text-primary": !open},
          ]}
        >
          <Icon name={open ? "mdi:calendar-check" : "mdi:calendar-clock"} class="size-3.5" />
          {open ? labels.open : labels.interest}
        </span>
        <p class="mt-3 flex items-baseline gap-2">
          <span class="text-3xl font-bold tracking-tight">
            <bdi>{pricePrefix}{price.toLocaleString("en")}</bdi>
          </span>
          <span class="text-sm text-muted-foreground">{labels.priceFrom}</span>
        </p>
        <p class="mt-1 text-sm text-muted-foreground"><bdi>{dates}</bdi></p>
      </div>

      {/* Early bird — la remise s'affiche avec sa borne : l'échéance régénère
          l'urgence, la bascule intégral supprime l'acompte (une seule ligne). */}
      {eb && (
        <p class="flex items-center gap-2 rounded-lg bg-primary/10 px-3 py-2 text-sm font-semibold text-primary">
          <Icon name="mdi:ticket-percent" class="size-4 shrink-0" aria-hidden="true" />
          <span>
            {labels.earlyBirdPrefix}<bdi>{eb.discount.toLocaleString("en")}{pricePrefix}</bdi>
            {eb.until ? <span> {labels.earlyBirdUntil} <bdi>{eb.until}</bdi></span> : null}
          </span>
        </p>
      )}

      {/* Rareté ≤ 2 — le seul signal public : un bandeau d'urgence, jamais
          un compteur (le chiffre naît de la rareté, pas d'un ratio). */}
      {open && isLastSeats(remainingPlaces) && (
        <p class="flex items-center gap-2 rounded-lg bg-warning/10 px-3 py-2 text-sm font-semibold text-warning-foreground">
          <Icon name="mdi:fire" class="size-4 shrink-0 text-warning" aria-hidden="true" />
          {remainingPlaces === 1 ? labels.lastSeat : labels.lastSpots}
        </p>
      )}

      {/* Ratio exact + jauge — réservé à l'admin : outil de gestion, pas
          d'affichage public (un visiteur ne voit jamais ce bloc). */}
      {open && isAdmin && (
        <div>
          <div class="flex items-center justify-between gap-3 text-sm">
            <span class="text-muted-foreground">{labels.places}</span>
            <span class="font-semibold tabular-nums">
              <bdi>{remainingPlaces}</bdi>&nbsp;/&nbsp;<bdi>{capacity}</bdi>
            </span>
          </div>
          <progress
            class="h-1.5 w-full overflow-hidden rounded-full"
            value={remainingPlaces}
            max={capacity}
            aria-label={labels.places}
            style="accent-color: var(--color-primary)"
          >
            {remainingPlaces} / {capacity}
          </progress>
        </div>
      )}

      {/* Détails financiers — la transparence avant l'engagement. Paiement
          intégral early bird : l'acompte devient la totalité, le solde saute. */}
      <dl class="flex flex-col gap-3 border-t border-border/60 pt-4 text-sm">
        <div class="flex items-baseline justify-between gap-3">
          <dt class="text-muted-foreground">{eb?.fullPayment ? labels.fullPayment : labels.deposit}</dt>
          <dd class="font-semibold"><bdi>{pricePrefix}{deposit.toLocaleString("en")}</bdi></dd>
        </div>
        {finalPaymentDue && !eb?.fullPayment && (
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-muted-foreground">{labels.balance}</dt>
            <dd class="text-end font-semibold"><bdi>{finalPaymentDue}</bdi></dd>
          </div>
        )}
        {difficulty && (
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-muted-foreground">{labels.difficulty}</dt>
            <dd class="font-semibold"><bdi>{difficulty}</bdi></dd>
          </div>
        )}
        {roomRule && (
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-muted-foreground">{labels.lodging}</dt>
            <dd class="text-end font-semibold">{roomRule}</dd>
          </div>
        )}
      </dl>

      <Button href={applyUrl} variant="primary" size="lg" class="w-full rounded-full">
        {labels.apply}
        <Icon name="mdi:arrow-right" class="size-4 rtl:rotate-180" />
      </Button>

      <p class="flex items-start gap-2 text-xs leading-relaxed text-muted-foreground">
        <Icon name="mdi:shield-check-outline" class="mt-0.5 size-4 shrink-0 text-primary" />
        {labels.reassurance}
      </p>
    </div>
  </CardContent>
</Card>
