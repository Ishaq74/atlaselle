---
import { NativeSelect, NativeSelectOption } from "@atoms/native-select";
import type { Locale } from "@i18n/config";
import { LOCALES } from "@i18n/config";
import type { loadAdminTripFaqs } from "@/modules/trips/loaders/admin-contents.loader";
import { getAdminDict } from "@i18n/admin";
import Button from "@atoms/button/Button.astro";

interface Props {
  tripId: string;
  faqs: Awaited<ReturnType<typeof loadAdminTripFaqs>>;
  locale: Locale;
  canUpdate: boolean;
}

const { tripId, faqs, locale, canUpdate } = Astro.props;
const dict = getAdminDict(locale);
const t = dict.tripForm;
const f = dict.tripForm.fields;
const c = dict.common;
const inputClass = "w-full rounded-md border bg-background p-2";
---
<section class="space-y-4" data-trip-id={tripId}>
  <h2 class="font-heading text-xl font-semibold">{t.faq} ({faqs.linked.length})</h2>
  {faqs.linked.map(({ faq, translations }) => {
    const byLocale = new Map(translations.map((x) => [x.locale, x]));
    return (
      <details class="rounded-xl border p-4" data-faq-id={faq.id}>
        <summary class="cursor-pointer font-medium">{byLocale.get(locale)?.question ?? faq.id.slice(0, 8)}</summary>
        {canUpdate ? (
          <div class="mt-3 space-y-3">
            {LOCALES.map((loc: Locale) => {
              const tr = byLocale.get(loc);
              return (
                <form id={`faq-translation-form-${faq.id}-${loc}`} name={`faq-translation-form-${faq.id}-${loc}`} method="post" action={Astro.url.pathname} data-faq-tr data-id={faq.id} data-locale={loc} class="grid gap-2 rounded-lg bg-muted/40 p-3 text-sm">
                  <h4 class="font-bold uppercase">{loc}</h4>
                  <input type="hidden" name="expectedUpdatedAt" value={tr?.updatedAt instanceof Date ? tr.updatedAt.toISOString() : ""} />
                  <div class="flex flex-col">
                    <label for={`faq-question-${faq.id}-${loc}`}>{f.question}</label>
                    <input id={`faq-question-${faq.id}-${loc}`} name="question" value={tr?.question ?? ""} required maxlength="500" class="rounded-md border bg-background p-2" />
                  </div>
                  <div class="flex flex-col">
                    <label for={`faq-answer-${faq.id}-${loc}`}>{f.answer}</label>
                    <textarea id={`faq-answer-${faq.id}-${loc}`} name="answer" rows="3" required class="rounded-md border bg-background p-2">{tr?.answer ?? ""}</textarea>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    <Button type="submit" variant="primary" size="sm">{t.save} ({loc})</Button>
                  </div>
                </form>
              );
            })}
            <div class="flex flex-wrap gap-3">
              <Button type="button" variant="outline" size="sm" data-faq-unlink data-confirm={t.unlinkFaq}>{t.unlink}</Button>
              <Button type="button" variant="error" size="sm" data-faq-delete data-confirm={t.deleteFaq}>{t.remove}</Button>
            </div>
          </div>
        ) : null}
      </details>
    );
  })}
  {canUpdate ? (
    <div class="grid gap-4 md:grid-cols-2">
      <form id="faq-link-form" name="faq-link-form" method="post" action={Astro.url.pathname} data-faq-link class="space-y-2 rounded-xl border p-4 text-sm">
        <h3 class="font-semibold">{t.linkFaq}</h3>
        <div class="flex flex-col">
          <label for="faq-link-select">{f.question}</label>
          <NativeSelect id="faq-link-select" name="faqId" size="sm">
            {faqs.all.map((entry) => (
              <NativeSelectOption value={entry.id}>{entry.id.slice(0, 8)}</NativeSelectOption>
            ))}
          </NativeSelect>
        </div>
        <Button type="submit" variant="primary" size="sm">{t.save}</Button>
      </form>
      <form id="faq-create-form" name="faq-create-form" method="post" action={Astro.url.pathname} data-faq-create class="space-y-2 rounded-xl border p-4 text-sm">
        <h3 class="font-semibold">{t.newFaq}</h3>
        <div class="flex flex-col">
          <label for="faq-create-locale">{dict.columns.locale}</label>
          <NativeSelect id="faq-create-locale" name="locale" size="sm">
            {LOCALES.map((loc: Locale) => (
              <NativeSelectOption value={loc}>{loc}</NativeSelectOption>
            ))}
          </NativeSelect>
        </div>
        <div class="flex flex-col">
          <label for="faq-create-question">{f.question}</label>
          <input id="faq-create-question" name="question" required maxlength="500" class={inputClass} />
        </div>
        <div class="flex flex-col">
          <label for="faq-create-answer">{f.answer}</label>
          <textarea id="faq-create-answer" name="answer" required rows="3" class={inputClass}></textarea>
        </div>
        <Button type="submit" variant="primary" size="sm">{t.save}</Button>
      </form>
    </div>
  ) : null}
  <input type="hidden" data-faq-i18n data-error={c.error} data-confirm-label={c.confirm} data-cancel-label={c.cancel} data-linked={t.linkFaqDone} />
</section>

<script>
  import { actions } from "astro:actions";
  import type { Locale } from "@i18n/config";
  import { toast } from "@atoms/toast";
  import { confirmAdminAction } from "@/core/admin";

  const root = document.querySelector("section[data-trip-id]");
  const tripId = root?.getAttribute("data-trip-id") ?? "";
  const i18n = document.querySelector<HTMLInputElement>("[data-faq-i18n]");
  const fail = (message: string | null | undefined) => toast.error(message ?? i18n?.dataset.error ?? "");
  const ask = async (message: string) =>
    confirmAdminAction({
      title: message,
      message,
      confirmLabel: i18n?.dataset.confirmLabel ?? "OK",
      cancelLabel: i18n?.dataset.cancelLabel ?? "",
    });

  document.querySelectorAll<HTMLFormElement>("[data-faq-tr]").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const { error } = await actions.upsertFaqTranslation({
        faqId: form.getAttribute("data-id") ?? "",
        expectedUpdatedAt: String(data.get("expectedUpdatedAt") ?? "") || null,
        locale: (form.getAttribute("data-locale") ?? "en") as Locale,
        question: String(data.get("question") ?? ""),
        answer: String(data.get("answer") ?? ""),
      });
      if (error) fail(error.message);
      else window.location.reload();
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-faq-unlink]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const faqId = btn.closest<HTMLElement>("[data-faq-id]")?.getAttribute("data-faq-id") ?? "";
      if (!faqId) return;
      const message = btn.dataset.confirm ?? "";
      if (message && !(await ask(message))) return;
      const { error } = await actions.unlinkFaqFromTrip({ tripId, faqId });
      if (error) fail(error.message);
      else window.location.reload();
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-faq-delete]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = btn.closest<HTMLElement>("[data-faq-id]")?.getAttribute("data-faq-id") ?? "";
      if (!id) return;
      const message = btn.dataset.confirm ?? "";
      if (message && !(await ask(message))) return;
      const { error } = await actions.deleteFaq({ id });
      if (error) fail(error.message);
      else window.location.reload();
    });
  });

  document.querySelector<HTMLFormElement>("[data-faq-link]")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const data = new FormData(form);
    const { error } = await actions.linkFaqToTrip({ tripId, faqId: String(data.get("faqId") ?? "") });
    if (error) fail(error.message);
    else {
      toast.success(i18n?.dataset.linked ?? "");
      window.location.reload();
    }
  });

  document.querySelector<HTMLFormElement>("[data-faq-create]")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const data = new FormData(form);
    const { error } = await actions.createFaq({
      tripId,
      locale: (String(data.get("locale") ?? "en")) as Locale,
      question: String(data.get("question") ?? ""),
      answer: String(data.get("answer") ?? ""),
    });
    if (error) fail(error.message);
    else window.location.reload();
  });
</script>
