---
import type { Locale } from "@i18n/config";
import { LOCALES } from "@i18n/config";
import type { loadAdminContents } from "@/modules/trips/loaders/admin-contents.loader";
import { getAdminDict } from "@i18n/admin";
import Button from "@atoms/button/Button.astro";

type Contents = Awaited<ReturnType<typeof loadAdminContents>>;

interface Props {
  tripId: string;
  contents: Contents;
  locale: Locale;
  canUpdate: boolean;
}

const { tripId, contents, locale, canUpdate } = Astro.props;
const dict = getAdminDict(locale);
const t = dict.tripForm;
const f = dict.tripForm.fields;
const c = dict.common;
const inputClass = "rounded-md border bg-background p-2";

const blocks = [
  { kind: "highlight", title: t.highlights, items: contents.highlights.map((h) => ({ id: h.highlight.id, title: h.translations.find((x) => x.locale === locale)?.title ?? h.highlight.id.slice(0, 8), translations: h.translations })) },
  { kind: "inclusion", title: t.inclusions, items: contents.inclusions.map((i) => ({ id: i.inclusion.id, title: i.translations.find((x) => x.locale === locale)?.text ?? i.inclusion.id.slice(0, 8), translations: i.translations })) },
  { kind: "exclusion", title: t.exclusions, items: contents.exclusions.map((e) => ({ id: e.exclusion.id, title: e.translations.find((x) => x.locale === locale)?.text ?? e.exclusion.id.slice(0, 8), translations: e.translations })) },
] as const;
---
<section class="space-y-8" data-trip-contents data-trip-id={tripId}>
  {blocks.map((block) => (
    <div>
      <h2 class="font-heading text-xl font-semibold">{block.title} ({block.items.length})</h2>
      <div class="mt-3 space-y-3">
        {block.items.map((item) => (
          <details class="rounded-xl border p-4" data-content-id={item.id} data-kind={block.kind}>
            <summary class="cursor-pointer font-medium">{item.title}</summary>
            {canUpdate ? (
              <div class="mt-3 space-y-3">
                {LOCALES.map((loc: Locale) => {
                  const tr = (item.translations as { locale: string; title?: string | null; description?: string | null; text?: string | null; updatedAt?: Date }[]).find((x) => x.locale === loc);
                  const isHighlight = block.kind === "highlight";
                  return (
                    <form id={`content-translation-form-${item.id}-${loc}`} name={`content-translation-form-${item.id}-${loc}`} method="post" action={Astro.url.pathname} data-content-tr data-kind={block.kind} data-id={item.id} data-locale={loc} class="grid gap-2 rounded-lg bg-muted/40 p-3 text-sm">
                      <h4 class="font-bold uppercase">{loc}</h4>
                      <input type="hidden" name="expectedUpdatedAt" value={tr?.updatedAt instanceof Date ? tr.updatedAt.toISOString() : ""} />
                      {isHighlight ? (
                        <>
                          <div class="flex flex-col">
                            <label for={`content-title-${item.id}-${loc}`}>{f.title}</label>
                            <input id={`content-title-${item.id}-${loc}`} name="title" value={tr?.title ?? ""} required maxlength="300" class={inputClass} />
                          </div>
                          <div class="flex flex-col">
                            <label for={`content-description-${item.id}-${loc}`}>{f.description}</label>
                            <textarea id={`content-description-${item.id}-${loc}`} name="description" rows="2" class={inputClass}>{tr?.description ?? ""}</textarea>
                          </div>
                        </>
                      ) : (
                        <div class="flex flex-col">
                          <label for={`content-text-${item.id}-${loc}`}>{f.text}</label>
                          <textarea id={`content-text-${item.id}-${loc}`} name="text" rows="2" required class={inputClass}>{tr?.text ?? ""}</textarea>
                        </div>
                      )}
                      <div class="flex flex-wrap gap-2">
                        <Button type="submit" variant="primary" size="sm">{t.save} ({loc})</Button>
                      </div>
                    </form>
                  );
                })}
                <Button type="button" variant="error" size="sm" data-content-delete data-confirm={t.deleteItemConfirm}>{t.remove}</Button>
              </div>
            ) : null}
          </details>
        ))}
      </div>
      {canUpdate ? (
        <form id={`content-add-form-${block.kind}`} name={`content-add-form-${block.kind}`} method="post" action={Astro.url.pathname} data-content-add={block.kind} class="mt-3 flex gap-2 text-sm">
          <Button type="submit" variant="outline" size="sm">+ {c.create}</Button>
        </form>
      ) : null}
    </div>
  ))}
  <input type="hidden" data-contents-i18n data-error={c.error} data-confirm-label={c.confirm} data-cancel-label={c.cancel} />
</section>

<script>
  import { initAdminContentsSection } from "@/modules/trips/client/admin-contents";

  initAdminContentsSection();
  document.addEventListener("astro:after-swap", initAdminContentsSection);
</script>
