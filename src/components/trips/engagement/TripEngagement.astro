---
/**
 * TripEngagement — chef d'orchestre des avis et questions d'un voyage.
 *
 * Même architecture que `components/services/detail/ServiceEngagement.astro` :
 *   - la présentation vient des atomes partagés de `molecules/Engagement` ;
 *   - les données viennent du loader `loadTripEngagement` ;
 *   - le branchement des actions est dans `modules/trips/client/engagement.ts` ;
 *   - la traduction domaine → contrats est dans `modules/trips/engagement/adapter.ts`.
 *
 * Le découpage en sections reprend celui du blog et des services :
 * `TripReviewSection` et `TripCommentSection`.
 */
import type { Locale } from "@i18n/config";
import type { TripEngagementDTO } from "@/modules/trips/loaders/trip-engagement.loader";
import { getTripEngagementTranslations } from "@/modules/trips/i18n/engagement";
import TripReviewSection from "@/components/trips/engagement/TripReviewSection.astro";
import TripCommentSection from "@/components/trips/engagement/TripCommentSection.astro";

interface Props {
  tripId: string;
  locale: Locale;
  commentStatus: "OPEN" | "CLOSED" | "DISABLED";
  allowReviews: boolean;
  engagement: TripEngagementDTO;
  isSignedIn: boolean;
}

const { tripId, locale, commentStatus, allowReviews, engagement, isSignedIn } = Astro.props as Props;
const t = getTripEngagementTranslations(locale);
---

<section
  class="flex flex-col gap-10"
  id="trip-engagement"
  data-trip-engagement
  data-trip-id={tripId}
  data-t-pending={t.pendingModeration}
  data-t-success={t.success}
  data-t-error={t.error}
>
  <TripReviewSection
    tripId={tripId}
    locale={locale}
    allowReviews={allowReviews}
    engagement={engagement}
    isSignedIn={isSignedIn}
  />

  <TripCommentSection
    tripId={tripId}
    locale={locale}
    commentStatus={commentStatus}
    engagement={engagement}
    isSignedIn={isSignedIn}
  />
</section>

<script>
  import { bindTripEngagement } from "@/modules/trips/client/engagement";

  bindTripEngagement();
  document.addEventListener("astro:after-swap", bindTripEngagement);
</script>
