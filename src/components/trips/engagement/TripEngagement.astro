---
/**
 * TripEngagement — avis et questions sur un voyage.
 *
 * MÊME design que l'article du blog, par construction : les onglets, le
 * résumé de note, les cartes d'avis et les fils de discussion sont les
 * composants partagés de `components/molecules/Engagement`. Seul le script
 * d'action diffère (`createTripReview` / `createTripComment`).
 *
 * Le composant reste présentationnel : les données viennent du loader
 * `loadTripEngagement`.
 */
import { Icon } from "astro-icon/components";
import type { Locale } from "@i18n/config";
import type { TripEngagementDTO } from "@/modules/trips/loaders/trip-engagement.loader";
import { getTripEngagementTranslations } from "@/modules/trips/i18n/engagement";
import { Card, CardContent } from "@atoms/card";
import EngagementTabs from "@/components/molecules/Engagement/EngagementTabs.astro";
import EngagementReviewStats from "@/components/molecules/Engagement/EngagementReviewStats.astro";
import EngagementReviewCard, {
  type EngagementReviewItem,
} from "@/components/molecules/Engagement/EngagementReviewCard.astro";
import EngagementCommentThread, {
  type EngagementCommentItem,
} from "@/components/molecules/Engagement/EngagementCommentThread.astro";
import EngagementReviewFormCard from "@/components/molecules/Engagement/EngagementReviewFormCard.astro";
import EngagementCommentFormCard from "@/components/molecules/Engagement/EngagementCommentFormCard.astro";

interface Props {
  tripId: string;
  locale: Locale;
  commentStatus: "OPEN" | "CLOSED" | "DISABLED";
  allowReviews: boolean;
  engagement: TripEngagementDTO;
  isSignedIn: boolean;
}

const { tripId, locale, commentStatus, allowReviews, engagement, isSignedIn } = Astro.props as Props;

const t = getTripEngagementTranslations(locale);
const { ratingAverage, ratingCount, distribution, reviews, comments } = engagement;

const hasReviews = reviews.length > 0;
const hasComments = comments.length > 0;
const reviewTab = hasReviews ? "list" : "write";
const commentTab = hasComments ? "list" : "write";

const reviewLabels = {
  recommended: t.recommended,
  notRecommended: t.notRecommended,
  helpful: t.helpful,
  helpfulMark: t.helpfulMark,
  helpfulUnmark: t.helpfulUnmark,
  report: t.report,
  reply: t.reply,
};
const threadLabels = { reply: t.reply, pending: "…", anonymous: "—" };

const toReviewItem = (review: TripEngagementDTO["reviews"][number]): EngagementReviewItem => ({
  id: review.id,
  rating: review.rating,
  title: review.title,
  content: review.content,
  isRecommended: review.isRecommended,
  helpfulCount: review.helpfulCount,
  createdAt: review.createdAt,
  authorName: review.authorName ?? threadLabels.anonymous,
  authorImage: null,
  viewerHelpful: review.viewerHelpful,
});

const toCommentItem = (comment: TripEngagementDTO["comments"][number]): EngagementCommentItem => ({
  id: comment.id,
  content: comment.content,
  createdAt: comment.createdAt,
  authorName: comment.authorName ?? comment.guestName ?? threadLabels.anonymous,
  authorImage: null,
  status: "APPROVED",
  replies: (comment.replies ?? []).map(toCommentItem),
});
---

<section
  class="flex flex-col gap-10"
  id="trip-engagement"
  data-trip-engagement
  data-trip-id={tripId}
  data-t-pending={t.pendingModeration}
  data-t-success={t.success}
  data-t-error={t.error}
>
  {/* ── Avis ─────────────────────────────────────────────────────────────── */}
  <section class="flex flex-col gap-6" aria-labelledby="trip-reviews-title">
    <h2 id="trip-reviews-title" class="font-heading flex items-center gap-2 text-lg font-semibold">
      <Icon name="mdi:star-outline" class="size-5 text-muted-foreground" />
      {t.reviewTitle} ({reviews.length})
    </h2>

    {!allowReviews ? (
      <Card>
        <CardContent class="py-8 text-center text-sm text-muted-foreground">{t.reviewsDisabled}</CardContent>
      </Card>
    ) : (
      <>
        <EngagementReviewStats
          average={ratingAverage}
          total={ratingCount}
          distribution={distribution}
          ratingLabel={t.ratingLabel}
        />

        <EngagementTabs
          defaultTab={reviewTab}
          listLabel={t.reviewTitle}
          listCount={reviews.length}
          writeLabel={t.writeReview}
          listIcon="mdi:message-star-outline"
          id="trip-reviews-tabs"
        >
          <div slot="list" class="flex flex-col gap-4">
            {hasReviews ? (
              reviews.map((review) => (
                <EngagementReviewCard
                  locale={locale}
                  review={toReviewItem(review)}
                  isSignedIn={isSignedIn}
                  labels={reviewLabels}
                />
              ))
            ) : (
              <Card>
                <CardContent class="py-8 text-center text-sm text-muted-foreground">{t.noReviews}</CardContent>
              </Card>
            )}
          </div>

          <div slot="write">
            {isSignedIn ? (
              <EngagementReviewFormCard
                formId="trip-review-form"
                action={Astro.url.pathname}
                labels={{
                  title: t.submitReview,
                  yourRating: t.reviewRating,
                  titlePlaceholder: t.reviewTitleLabel,
                  content: t.reviewContent,
                  recommend: t.reviewRecommended,
                  submit: t.submitReview,
                  error: t.error,
                  submitted: t.success,
                }}
              >
                <input type="hidden" name="tripId" value={tripId} slot="hidden" />
              </EngagementReviewFormCard>
            ) : (
              <Card>
                <CardContent class="py-8 text-center text-sm text-muted-foreground">
                  {t.signInRequired}
                </CardContent>
              </Card>
            )}
          </div>
        </EngagementTabs>
      </>
    )}
  </section>

  {/* ── Questions ─────────────────────────────────────────────────────────── */}
  <section class="flex flex-col gap-6" aria-labelledby="trip-comments-title">
    <h2 id="trip-comments-title" class="font-heading flex items-center gap-2 text-lg font-semibold">
      <Icon name="mdi:comment-outline" class="size-5 text-muted-foreground" />
      {t.commentTitle} ({comments.length})
    </h2>

    {commentStatus === "DISABLED" ? (
      <Card>
        <CardContent class="py-8 text-center text-sm text-muted-foreground">{t.commentsDisabled}</CardContent>
      </Card>
    ) : commentStatus === "CLOSED" ? (
      hasComments ? (
        <div class="flex flex-col gap-6">
          {comments.map((comment) => (
            <EngagementCommentThread
              locale={locale}
              comment={toCommentItem(comment)}
              canReply={false}
              labels={threadLabels}
            />
          ))}
        </div>
      ) : (
        <Card>
          <CardContent class="py-8 text-center text-sm text-muted-foreground">{t.noComments}</CardContent>
        </Card>
      )
    ) : (
      <EngagementTabs
        defaultTab={commentTab}
        listLabel={t.commentTitle}
        listCount={comments.length}
        writeLabel={t.writeComment}
        id="trip-comments-tabs"
      >
        <div slot="list" class="flex flex-col gap-6">
          {hasComments ? (
            comments.map((comment) => (
              <EngagementCommentThread
                locale={locale}
                comment={toCommentItem(comment)}
                canReply={commentStatus === "OPEN"}
                labels={threadLabels}
              />
            ))
          ) : (
            <Card>
              <CardContent class="py-8 text-center text-sm text-muted-foreground">{t.noComments}</CardContent>
            </Card>
          )}
        </div>

        <div slot="write">
          {isSignedIn ? (
            <EngagementCommentFormCard
              formId="trip-comment-form"
              action={Astro.url.pathname}
              showGuestFields={false}
              labels={{
                title: t.writeComment,
                content: t.commentContent,
                submit: t.submitComment,
                guestName: "",
                guestEmail: "",
                error: t.error,
                submitted: t.success,
              }}
            >
              <input type="hidden" name="tripId" value={tripId} slot="hidden" />
            </EngagementCommentFormCard>
          ) : (
            <Card>
              <CardContent class="py-8 text-center text-sm text-muted-foreground">
                {t.signInRequired}
              </CardContent>
            </Card>
          )}
        </div>
      </EngagementTabs>
    )}
  </section>
</section>

<script>
  import { actions } from "astro:actions";
  import { toast } from "@atoms/toast";

  /**
   * Les avis et questions d'un voyage passent par les actions voyage. Le
   * markup, lui, vient des composants partagés — seule cette couche change.
   */
  function initTripEngagement(root: HTMLElement): void {
    if (root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    const tripId = root.getAttribute("data-trip-id");
    if (!tripId) return;
    const label = (name: string) => root.getAttribute(`data-t-${name}`) ?? "";

    root.querySelectorAll<HTMLButtonElement>("[data-engagement-helpful]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const reviewId = btn.dataset.engagementHelpful;
        if (!reviewId) return;
        const isHelpful = btn.dataset.value !== "true";
        const { error } = await actions.voteTripReviewHelpful({ reviewId, isHelpful });
        if (error) {
          toast.error(error.message ?? label("error"));
          return;
        }
        btn.dataset.value = String(isHelpful);
        btn.setAttribute("aria-pressed", String(isHelpful));
        toast.success(label("success"));
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-engagement-report-review]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        btn.disabled = true;
        const { error } = await actions.createTripReport({
          tripId,
          reviewId: btn.dataset.engagementReportReview,
          reason: "OTHER",
        });
        btn.disabled = false;
        if (error) toast.error(error.message ?? label("error"));
        else toast.success(label("success"));
      });
    });

    const reviewForm = root.querySelector<HTMLFormElement>("#trip-review-form");
    reviewForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submit = reviewForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submit) submit.disabled = true;
      const data = new FormData(reviewForm);
      const { error } = await actions.createTripReview({
        tripId,
        rating: Number(data.get("rating")),
        title: String(data.get("title") ?? ""),
        content: String(data.get("content") ?? ""),
        isRecommended: data.get("isRecommended") === "true",
      });
      const status = reviewForm.querySelector<HTMLElement>("[data-review-status]");
      if (status) status.textContent = error ? error.message : label("pending");
      if (!error) {
        reviewForm.reset();
        toast.success(label("success"));
      }
      if (submit) submit.disabled = false;
    });

    const commentForm = root.querySelector<HTMLFormElement>("#trip-comment-form");
    commentForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submit = commentForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submit) submit.disabled = true;
      const data = new FormData(commentForm);
      const { error } = await actions.createTripComment({
        tripId,
        content: String(data.get("content") ?? ""),
      });
      const status = commentForm.querySelector<HTMLElement>("[data-comment-status]");
      if (status) status.textContent = error ? error.message : label("pending");
      if (!error) {
        commentForm.reset();
        toast.success(label("success"));
      }
      if (submit) submit.disabled = false;
    });
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-trip-engagement]").forEach(initTripEngagement);
  }

  init();
  document.addEventListener("astro:after-swap", init);
</script>
