---
/**
 * Formulaire de question sur un voyage.
 *
 * Même découpage que `components/blog/engagement/BlogCommentForm.astro` et
 * `components/services/engagement/ServiceCommentForm.astro`.
 */
import type { Locale } from "@i18n/config";
import { getTripEngagementTranslations } from "@/modules/trips/i18n/engagement";
import EngagementCommentFormCard from "@/components/molecules/Engagement/EngagementCommentFormCard.astro";

interface Props {
  tripId: string;
  locale: Locale;
  action: string;
}

const { tripId, locale, action } = Astro.props as Props;
const t = getTripEngagementTranslations(locale);
---

{/* Pas de champ nom/e-mail : la question est rattachée à la session. */}
<EngagementCommentFormCard
  formId="trip-comment-form"
  action={action}
  showGuestFields={false}
  labels={{
    title: t.writeComment,
    content: t.commentContent,
    submit: t.submitComment,
    guestName: "",
    guestEmail: "",
    error: t.error,
    submitted: t.success,
  }}
>
  <input type="hidden" name="tripId" value={tripId} slot="hidden" />
</EngagementCommentFormCard>

<script>
  import { initTripEngagementForms } from "@/modules/trips/client/engagement-forms";

  initTripEngagementForms();
  document.addEventListener("astro:after-swap", initTripEngagementForms);
</script>
