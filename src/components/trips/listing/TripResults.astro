---
import { Icon } from "astro-icon/components";
import type { Locale } from "@i18n/config";
import type { TripSummaryDTO } from "@/modules/trips/loaders/trip.loader";
import TripCard from "@/components/trips/listing/TripCard.astro";
import TripViewToggle from "@/components/trips/search/TripViewToggle.astro";

interface Props {
  locale: Locale;
  trips: TripSummaryDTO[];
  total: number;
  variant: "grid" | "list";
  emptyLabel: string;
  resetLabel: string;
  baseUrl: string;
}

const { locale, trips, total, variant, emptyLabel, resetLabel, baseUrl } = Astro.props as Props;

const countLabel = { fr: "voyage", en: "journey", es: "viaje", ar: "رحلة" }[locale];
---

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <p class="flex items-center gap-2 text-sm text-muted-foreground">
    <Icon name="mdi:map-marker-path" class="size-4 shrink-0" />
    <span class="tabular-nums"><strong class="font-semibold text-foreground">{total}</strong> {countLabel}{total > 1 ? "s" : ""}</span>
  </p>
  <TripViewToggle locale={locale} />
</div>

{trips.length === 0 ? (
  <div class="rounded-2xl border border-dashed px-6 py-20 text-center">
    <Icon name="mdi:compass-off-outline" class="mx-auto size-10 text-muted-foreground/50" />
    <p class="mt-4 text-lg font-semibold">{emptyLabel}</p>
    <a href={baseUrl} class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline">
      {resetLabel}
      <Icon name="mdi:arrow-right" class="size-4 rtl:rotate-180" />
    </a>
  </div>
) : variant === "list" ? (
  <div class="flex flex-col gap-4">
    {trips.map((trip) => (
      <TripCard trip={trip} locale={locale} variant="list" />
    ))}
  </div>
) : (
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {trips.map((trip) => (
      <TripCard trip={trip} locale={locale} variant="grid" />
    ))}
  </div>
)}
