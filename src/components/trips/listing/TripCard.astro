---
import { Icon } from "astro-icon/components";
import type { Locale } from "@i18n/config";
import { getTripPath } from "@i18n/routes";
import type { TripSummaryDTO } from "@/modules/trips/loaders/trip.loader";

interface Props {
  trip: TripSummaryDTO;
  locale: Locale;
  /**
   * `grid` = carte verticale (grille), `list` = ligne horizontale (vue liste).
   * Même composant que la page d'accueil et que la page voyages : une seule
   * source de vérité pour le rendu d'un voyage.
   */
  variant?: "grid" | "list";
}

const { trip, locale, variant = "grid" } = Astro.props as { trip: TripSummaryDTO; locale: Locale; variant?: "grid" | "list" };
const href = getTripPath(locale, trip.slug);
const list = variant === "list";
const pricePrefix = trip.currency === "EUR" ? "€" : `${trip.currency} `;
const labels =
  locale === "fr"
    ? { from: "À partir de", duration: "jours", discover: "Découvrir", open: "Disponible", interest: "Liste d'intérêt", detail: "Voir le programme" }
    : locale === "es"
      ? { from: "Desde", duration: "días", discover: "Descubrir", open: "Disponible", interest: "Lista de interés", detail: "Ver el programa" }
      : locale === "ar"
        ? { from: "ابتداءً من", duration: "أيام", discover: "اكتشف", open: "متاح", interest: "قائمة الاهتمام", detail: "عرض البرنامج" }
        : { from: "From", duration: "days", discover: "Discover", open: "Available", interest: "Interest list", detail: "View itinerary" };
const statusLabel = trip.status === "open" ? labels.open : labels.interest;
---

{list ? (
  <article class="group relative grid gap-0 overflow-hidden rounded-xl border bg-card transition hover:border-primary/40 hover:shadow-md focus-within:ring-2 focus-within:ring-primary/60 md:grid-cols-[18rem_1fr]">
    <div class="relative min-h-44 overflow-hidden bg-muted md:min-h-full">
      {trip.hero ? (
        <img src={trip.hero.url} alt={trip.hero.alt} width={trip.hero.width ?? 800} height={trip.hero.height ?? 450} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
      ) : (
        <div class="absolute inset-0 bg-gradient-to-br from-primary/80 to-primary" aria-hidden="true"></div>
      )}
      <span class="absolute bottom-4 start-4 rounded-full bg-background/90 px-3 py-1 text-xs font-semibold backdrop-blur">
        {statusLabel}
      </span>
    </div>
    <div class="flex min-w-0 flex-col gap-3 p-5 sm:p-6">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <h2 class="font-heading min-w-0 text-xl font-bold tracking-tight sm:text-2xl">
          <a href={href} class="after:absolute after:inset-0 focus-visible:outline-none">{trip.title}</a>
        </h2>
        <p class="shrink-0 text-end text-sm text-muted-foreground">
          {labels.from}{" "}
          <span class="text-lg font-bold text-foreground"><bdi>{pricePrefix}{trip.priceFrom.toLocaleString("en")}</bdi></span>
        </p>
      </div>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
        <span class="inline-flex items-center gap-1.5"><Icon name="mdi:calendar-blank-outline" class="size-4 text-primary" /><bdi>{trip.dates}</bdi></span>
        <span aria-hidden="true">·</span>
        <span class="inline-flex items-center gap-1.5"><Icon name="mdi:calendar-week-outline" class="size-4 text-primary" /><bdi>{trip.durationDays} {labels.duration}</bdi></span>
        <span aria-hidden="true">·</span>
        <span class="inline-flex items-center gap-1.5"><Icon name="mdi:hiking" class="size-4 text-primary" /><bdi>{trip.difficulty}</bdi></span>
      </p>
      {trip.summary && <p class="line-clamp-2 text-sm leading-relaxed">{trip.summary}</p>}
      <div class="mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-border/50 pt-4">
        {trip.ratingCount > 0 ? (
          <p class="flex items-center gap-1.5 text-sm">
            <span class="text-warning" aria-hidden="true">{"★".repeat(Math.round(trip.ratingAverage))}{"☆".repeat(5 - Math.round(trip.ratingAverage))}</span>
            <bdi>{trip.ratingAverage}/5</bdi>
            <span class="text-muted-foreground"><bdi>({trip.ratingCount})</bdi></span>
          </p>
        ) : (
          <span></span>
        )}
        <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary">
          {labels.detail}
          <Icon name="mdi:arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5 rtl:rotate-180" />
        </span>
      </div>
    </div>
  </article>
) : (
  <article class="group relative flex flex-col overflow-hidden rounded-xl border bg-card transition hover:border-primary/40 hover:shadow-md focus-within:ring-2 focus-within:ring-primary/60">
    {trip.hero ? (
      <div class="relative h-44 overflow-hidden">
        <img src={trip.hero.url} alt={trip.hero.alt} width={trip.hero.width ?? 800} height={trip.hero.height ?? 450} loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
        <span class="absolute bottom-4 start-4 rounded-full bg-background/90 px-3 py-1 text-xs font-semibold backdrop-blur">
          {statusLabel}
        </span>
      </div>
    ) : (
      <div class="relative flex h-44 items-end bg-gradient-to-br from-primary/80 to-primary p-5">
        <span class="rounded-full bg-background/90 px-3 py-1 text-xs font-semibold">
          {statusLabel}
        </span>
      </div>
    )}
    <div class="flex flex-1 flex-col p-6">
      <h2 class="font-heading text-xl font-bold tracking-tight">
        <a href={href} class="after:absolute after:inset-0 focus-visible:outline-none">{trip.title}</a>
      </h2>
      <p class="mt-2 flex flex-wrap items-center gap-x-2 text-sm text-muted-foreground">
        <bdi>{trip.dates}</bdi>
        <span aria-hidden="true">·</span>
        <bdi>{trip.durationDays} {labels.duration}</bdi>
        <span aria-hidden="true">·</span>
        <bdi>{trip.difficulty}</bdi>
      </p>
      {trip.ratingCount > 0 && (
        <p class="mt-2 flex items-center gap-1.5 text-sm">
          <span class="text-warning" aria-hidden="true">{"★".repeat(Math.round(trip.ratingAverage))}{"☆".repeat(5 - Math.round(trip.ratingAverage))}</span>
          <bdi>{trip.ratingAverage}/5</bdi>
          <span class="text-muted-foreground"><bdi>({trip.ratingCount})</bdi></span>
        </p>
      )}
      {trip.summary && <p class="mt-3 line-clamp-3 text-sm leading-relaxed">{trip.summary}</p>}
      <div class="mt-auto flex items-center justify-between gap-3 pt-5">
        <p class="text-sm text-muted-foreground">
          {labels.from}{" "}
          <span class="text-lg font-bold text-foreground"><bdi>{pricePrefix}{trip.priceFrom.toLocaleString("en")}</bdi></span>
        </p>
        <span class="inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-primary">
          {labels.discover}
          <Icon name="mdi:arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5 rtl:rotate-180" />
        </span>
      </div>
    </div>
  </article>
)}
