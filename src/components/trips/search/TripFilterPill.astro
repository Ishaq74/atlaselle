---
/**
 * TripFilterPill — un filtre sous forme de pastille.
 *
 * Un lien, pas un <select> : l'état des filtres vit dans l'URL, donc chaque
 * pastille se partage, se met en favori et fonctionne sans JavaScript.
 */
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  label: string;
  active: boolean;
  showCheck?: boolean;
}

const { href, label, active, showCheck = true } = Astro.props as Props;
---

<a
  href={href}
  aria-current={active ? "true" : undefined}
  class:list={[
    "inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary",
    {"border-primary bg-primary text-primary-foreground": active, "text-muted-foreground hover:border-primary hover:text-foreground": !active},
  ]}
>
  {active && showCheck && <Icon name="mdi:check" class="size-3.5" />}
  {label}
</a>
