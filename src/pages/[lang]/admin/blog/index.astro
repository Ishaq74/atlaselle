---
import { requirePermission } from "@/lib/auth-guards";
import { getBlogTranslations } from "@i18n/utils";
import { getBlogCategories, getBlogTags, getBlogModerationQueue } from "@/modules/blog/loaders/blog.loader";
import { getBlogAdminPostData, getBlogAdminAuthors, getBlogAdminTags, getBlogAdminCategories, countBlogTaxonomy } from "@/modules/blog/loaders/blog-admin.loader";
import { getBlogAdminModerationCount, getBlogModerationTotals } from "@/modules/blog/loaders/admin/blog-admin-moderation.loader";
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import BlogAdminPage from "@/components/blog/admin/BlogAdminPage.astro";
import { hasBlogPermission } from "@/actions/blog/_helpers";
import { LOCALES, type Locale } from "@i18n/config";

export const prerender = false;
const result = await requirePermission(Astro, { blog: ["read"], blogCategory: ["read"], blogTag: ["read"], blogComment: ["read"], blogReview: ["read"] });
if ("redirect" in result) return result.redirect;
const { locale, authT, user } = result;
const blogT = await getBlogTranslations(locale);
const p = Astro.url.searchParams;
const page = Math.max(1, Number(p.get("page") ?? "1") || 1);
const boolParam = (key: string) => p.get(key) === null ? undefined : p.get(key) === "true";
const requestedLocale = p.get("translationLocale") as Locale | null;
const translationLocale = requestedLocale && LOCALES.includes(requestedLocale) ? requestedLocale : locale;
const filters = {
  page,
  translationLocale,
  search: p.get("search") || undefined,
  status: (p.get("status") || undefined) as import("@/lib/blog/constants").BlogPostStatus | undefined,
  categoryId: p.get("categoryId") || undefined,
  tagId: p.get("tagId") || undefined,
  authorId: p.get("authorId") || undefined,
  featured: boolParam("featured"),
  sticky: boolParam("sticky"),
  sortBy: (p.get("sortBy") || "updatedAt") as "createdAt" | "updatedAt" | "publishedAt" | "title" | "viewCount",
  sortOrder: (p.get("sortOrder") || "desc") as "asc" | "desc",
};
const baseAdminUrl = `/${locale}/admin/blog`;
const basePublicUrl = `/${locale}/${blogT.routes.blog}`;
const [canCreate, canUpdate, canPublish, canDelete] = await Promise.all([
  hasBlogPermission(Astro, { blog: ["create"] }),
  hasBlogPermission(Astro, { blog: ["update"] }),
  hasBlogPermission(Astro, { blog: ["publish"] }),
  hasBlogPermission(Astro, { blog: ["delete"] }),
]);

// Onglet actif (liaison profonde) + pagination de la file de modération.
const TAB_VALUES = ["posts", "categories", "tags", "moderation", "stats"] as const;
const requestedTab = p.get("tab") ?? "";
const activeTab = (TAB_VALUES as readonly string[]).includes(requestedTab)
  ? (requestedTab as (typeof TAB_VALUES)[number])
  : "posts";
const moderationLimit = 10;
const TAXONOMY_PAGE_SIZE = 20;
const [moderationTotals, taxonomyTotals] = await Promise.all([
  getBlogModerationTotals(),
  countBlogTaxonomy(),
]);
const moderationTotal = Math.max(moderationTotals.comments, moderationTotals.reviews, moderationTotals.reports);
const moderationTotalPages = Math.max(1, Math.ceil(moderationTotal / moderationLimit));
const moderationPage = Math.min(
  Math.max(1, Number(p.get("modPage") ?? "1") || 1),
  moderationTotalPages,
);
const categoriesTotalPages = Math.max(1, Math.ceil(taxonomyTotals.categories / TAXONOMY_PAGE_SIZE));
const tagsTotalPages = Math.max(1, Math.ceil(taxonomyTotals.tags / TAXONOMY_PAGE_SIZE));
const categoriesPage = Math.min(
  Math.max(1, Number(p.get("catPage") ?? "1") || 1),
  categoriesTotalPages,
);
const tagsPage = Math.min(
  Math.max(1, Number(p.get("tagPage") ?? "1") || 1),
  tagsTotalPages,
);

const [{ rows, meta, stats }, categoryRows, tagRows, moderation, authors, adminTags, adminCategories, moderationCount] = await Promise.all([
  getBlogAdminPostData(locale, filters),
  getBlogCategories(locale, { limit: TAXONOMY_PAGE_SIZE, offset: (categoriesPage - 1) * TAXONOMY_PAGE_SIZE }),
  getBlogTags(locale, { limit: TAXONOMY_PAGE_SIZE, offset: (tagsPage - 1) * TAXONOMY_PAGE_SIZE }),
  getBlogModerationQueue({ page: moderationPage, limit: moderationLimit }),
  getBlogAdminAuthors(),
  getBlogAdminTags(locale),
  getBlogAdminCategories(locale),
  getBlogAdminModerationCount(),
]);
const categories = categoryRows.map((item) => ({ id: item.id, slug: item.slug, name: item.translation?.name ?? item.slug, description: item.translation?.description ?? null, color: item.color, icon: item.icon, parentId: item.parentId, sortOrder: item.sortOrder, postCount: item.postCount }));
const tags = tagRows.map((item) => ({ id: item.id, slug: item.slug, name: item.translation?.name ?? item.slug, color: item.color, postCount: item.postCount }));
const filterOptions = { categories: adminCategories.map(({ id, name }) => ({ id, name })), tags: adminTags.map(({ id, name }) => ({ id, name })), authors };
---
<BaseLayout title={blogT.admin.title} description={blogT.admin.title}>
  <AuthLayout title={blogT.admin.title}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="blog" />
    <BlogAdminPage locale={locale} blogT={blogT} title={blogT.admin.title} posts={rows} postsMeta={meta} stats={stats} moderationCount={moderationCount} categories={categories} tags={tags} categoriesPage={categoriesPage} categoriesTotalPages={categoriesTotalPages} tagsPage={tagsPage} tagsTotalPages={tagsTotalPages} taxonomyBaseUrl={new URL(Astro.url.href)} parentOptions={adminCategories} moderation={moderation} activeTab={activeTab} moderationPage={moderationPage} moderationTotalPages={moderationTotalPages} moderationBaseUrl={new URL(Astro.url.href)} baseAdminUrl={baseAdminUrl} basePublicUrl={basePublicUrl} userId={user.id} canCreate={canCreate} canUpdate={canUpdate} canPublish={canPublish} canDelete={canDelete} filterOptions={filterOptions} />
  </AuthLayout>
</BaseLayout>
