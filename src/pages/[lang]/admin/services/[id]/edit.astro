---
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import { requirePermission } from "@lib/auth-guards";
import { hasServicePermission } from "@/modules/services/permissions";
import { getServiceAdminById } from "@/modules/services/admin";
import { getServiceTranslations } from "@/modules/services/i18n";
import ServiceLocaleSwitcher from "@/modules/services/components/ui/ServiceLocaleSwitcher.astro";
import AdminServiceForm from "@/components/services/AdminServiceForm.astro";
export const prerender = false;
const result = await requirePermission(Astro, { service: ["read"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;
const id = Astro.params.id!;
const item = await getServiceAdminById(id, locale);
if (!item) return Astro.redirect(`/${locale}/admin/services`);
const [canUpdate, canPublish, canDelete, canCreate] = await Promise.all([
  hasServicePermission(Astro, { service: ["update"] }),
  hasServicePermission(Astro, { service: ["publish"] }),
  hasServicePermission(Astro, { service: ["delete"] }),
  hasServicePermission(Astro, { service: ["create"] }),
]);
if (!canUpdate) return Astro.redirect(`/${locale}/admin/services`);
const t = getServiceTranslations(locale);
---
<BaseLayout title={t.admin.editService} description={t.meta.description}>
  <AuthLayout title={t.admin.editService}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="services" />
    <main class="mx-auto w-full max-w-5xl space-y-4 px-4 py-8 sm:px-6 lg:px-8">
      <ServiceLocaleSwitcher locale={locale} service={item} availableLocales={item.availableLocales} />
      <AdminServiceForm locale={locale} service={item} baseAdminUrl={`/${locale}/admin/services`} canUpdate={canUpdate} canPublish={canPublish} canDelete={canDelete} canCreate={canCreate} />
    </main>
  </AuthLayout>
</BaseLayout>
