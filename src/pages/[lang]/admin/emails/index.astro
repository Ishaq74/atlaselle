---
import { requirePermission } from "@/lib/auth-guards";
import { hasVoyagePermission } from "@/actions/voyage/_helpers";
import { loadAdminDeliveries } from "@/modules/email-voyage/loaders/admin-email.loader";
import { loadDeadLetterOutbox } from "@/modules/outbox/loaders/admin-outbox.loader";
import { getAdminDict } from "@i18n/admin";
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import AdminEmailList from "@/modules/email-voyage/components/AdminEmailList.astro";
import Button from "@atoms/button/Button.astro";

export const prerender = false;

const result = await requirePermission(Astro, { email: ["read"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;

const p = Astro.url.searchParams;
const { rows, meta } = await loadAdminDeliveries({
  page: p.get("page") ?? undefined,
  pageSize: p.get("pageSize") ?? undefined,
  status: p.get("status") ?? undefined,
  templateKey: p.get("templateKey") ?? undefined,
  sortOrder: p.get("sortOrder") ?? undefined,
});
const canRetry = await hasVoyagePermission(Astro, { email: ["retry"] });
const deadLetters = await loadDeadLetterOutbox(20);
const baseUrl = `/${locale}/admin/emails`;
const title = authT.admin.tabs.emails;
const dict = getAdminDict(locale);
const t = dict.emails;
const col = dict.columns;
---

<BaseLayout title={title} description={title} canonicalPath={baseUrl}>
  <AuthLayout title={title}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="emails" />
    <AdminEmailList
      rows={rows}
      meta={meta}
      locale={locale}
      baseUrl={baseUrl}
      status={p.get("status") ?? undefined}
      templateKey={p.get("templateKey") ?? undefined}
      canRetry={canRetry}
    />
    {deadLetters.length > 0 ? (
      <section class="mx-auto max-w-6xl p-4 md:p-6" data-dead-letter-section>
        <h2 class="font-heading text-xl font-semibold">{t.deadLetter} ({deadLetters.length})</h2>
        <p class="mt-1 text-sm text-muted-foreground">{t.deadLetterNote}</p>
        <ul class="mt-3 space-y-2 text-sm">
          {deadLetters.map((e) => (
            <li class="flex flex-wrap items-center justify-between gap-4 rounded-xl border px-4 py-2" data-outbox-id={e.id}>
              <span class="font-mono text-xs">{e.eventType} · {e.aggregateType}/{String(e.aggregateId).slice(0, 8)} · {col.attempts}: {e.attempts}</span>
              {canRetry ? <Button size="sm" variant="outline" data-requeue>{t.requeue}</Button> : null}
            </li>
          ))}
        </ul>
        <input type="hidden" data-dead-letter-i18n data-error={dict.common.error} />
      </section>
    ) : null}
    <script>
      import { actions } from "astro:actions";
      import { toast } from "@atoms/toast";

      const i18n = document.querySelector<HTMLInputElement>("[data-dead-letter-i18n]");

      document.querySelectorAll<HTMLButtonElement>("[data-requeue]").forEach((btn) => {
        if (btn.dataset.bound === "true") return;
        btn.dataset.bound = "true";
        btn.addEventListener("click", async () => {
          const id = btn.closest<HTMLElement>("[data-outbox-id]")?.getAttribute("data-outbox-id") ?? "";
          if (!id) return;
          const { error } = await actions.requeueOutboxEvent({ id });
          if (error) toast.error(error.message ?? i18n?.dataset.error ?? "");
          else window.location.reload();
        });
      });
    </script>
  </AuthLayout>
</BaseLayout>
