---
import { requirePermission } from "@/lib/auth-guards";
import { hasVoyagePermission } from "@/actions/voyage/_helpers";
import { loadAdminDeliveries } from "@/modules/email-voyage/loaders/admin-email.loader";
import { loadDeadLetterOutbox } from "@/modules/outbox/loaders/admin-outbox.loader";
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import AdminEmailList from "@/modules/email-voyage/components/AdminEmailList.astro";

export const prerender = false;

const result = await requirePermission(Astro, { email: ["read"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;

const p = Astro.url.searchParams;
const { rows, meta } = await loadAdminDeliveries({
  page: p.get("page") ?? undefined,
  pageSize: p.get("pageSize") ?? undefined,
  status: p.get("status") ?? undefined,
  templateKey: p.get("templateKey") ?? undefined,
  sortOrder: p.get("sortOrder") ?? undefined,
});
const canRetry = await hasVoyagePermission(Astro, { email: ["retry"] });
const deadLetters = await loadDeadLetterOutbox(20);
const baseUrl = `/${locale}/admin/emails`;
const title = authT.admin.tabs.emails;
const deadTitle = locale === "fr" ? "Dead letter (outbox)" : "Dead letter (outbox)";
---

<BaseLayout title={title} description={title} canonicalPath={baseUrl}>
  <AuthLayout title={title}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="emails" />
    <AdminEmailList
      rows={rows}
      meta={meta}
      locale={locale}
      baseUrl={baseUrl}
      status={p.get("status") ?? undefined}
      canRetry={canRetry}
    />
    {deadLetters.length > 0 ? (
      <section class="mx-auto max-w-6xl px-6 pb-10">
        <h2 class="text-xl font-bold">{deadTitle} ({deadLetters.length})</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {deadLetters.map((e) => (
            <li class="flex items-center justify-between gap-4 rounded-xl border px-4 py-2" data-outbox-id={e.id}>
              <span class="font-mono text-xs">{e.eventType} · {e.aggregateType}/{String(e.aggregateId).slice(0, 8)} · {e.attempts} essais</span>
              {canRetry ? <button type="button" class="text-primary underline" data-requeue>Requeue</button> : null}
            </li>
          ))}
        </ul>
      </section>
    ) : null}
    <script>
      import { actions } from "astro:actions";
      document.querySelectorAll("[data-requeue]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const li = (btn as HTMLElement).closest("[data-outbox-id]");
          const id = li?.getAttribute("data-outbox-id") ?? "";
          if (!id) return;
          const { error } = await actions.requeueOutboxEvent({ id });
          if (error) alert(error.message);
          else window.location.reload();
        });
      });
    </script>
  </AuthLayout>
</BaseLayout>
