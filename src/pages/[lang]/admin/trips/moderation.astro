---
import { requirePermission } from "@/lib/auth-guards";
import { loadTripModerationQueue, loadTripModerationCounts } from "@/modules/trips/loaders/admin-moderation.loader";
import { getAdminDict, adminStatusLabel } from "@i18n/admin";
import { statusTone as statusToneFor, DataView } from "@/core/admin";
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import AdminPagination from "@molecules/AdminPagination/AdminPagination.astro";
import { Table, TableHeader, TableHead, TableBody, TableRow, TableCell } from "@atoms/table";
import { Badge } from "@atoms/badge";
import Button from "@atoms/button/Button.astro";

export const prerender = false;

const result = await requirePermission(Astro, { trip: ["read"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;

const p = Astro.url.searchParams;
const queue = await loadTripModerationQueue({
  page: p.get("page") ?? undefined,
  pageSize: p.get("pageSize") ?? undefined,
  tab: p.get("tab") ?? undefined,
  status: p.get("status") ?? undefined,
  tripId: p.get("tripId") ?? undefined,
});
const counts = await loadTripModerationCounts().catch(() => ({ pendingComments: 0, pendingReviews: 0, pendingReports: 0 }));
const baseUrl = `/${locale}/admin/trips/moderation`;
const dict = getAdminDict(locale);
const t = dict.moderation;
const c = dict.common;
const title = t.title;
const tab = queue.tab;
const tabTotal = tab === "comments" ? queue.comments.total : tab === "reviews" ? queue.reviews.total : queue.reports.total;
const totalPages = Math.max(1, Math.ceil(tabTotal / queue.meta.pageSize));
const paginationUrl = new URL(Astro.url.href);
const tabs = [
  { key: "comments", label: t.comments, total: queue.comments.total },
  { key: "reviews", label: t.reviews, total: queue.reviews.total },
  { key: "reports", label: t.reports, total: queue.reports.total },
] as const;
---

<BaseLayout title={title} description={title} canonicalPath={baseUrl}>
  <AuthLayout title={title}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="moderation" />
    <section class="mx-auto max-w-6xl space-y-8 p-4 md:p-6" data-trip-moderation>
      <h1 class="font-heading text-2xl font-semibold">{title}</h1>

      <div class="flex flex-wrap gap-2 text-sm">
        <Badge variant="warning" size="sm">{t.comments}: {counts.pendingComments}</Badge>
        <Badge variant="warning" size="sm">{t.reviews}: {counts.pendingReviews}</Badge>
        <Badge variant="warning" size="sm">{t.reports}: {counts.pendingReports}</Badge>
      </div>

      <nav class="flex flex-wrap gap-2 text-sm" aria-label={title}>
        {tabs.map((entry) => (
          <Button size="sm" variant={tab === entry.key ? "primary" : "outline"} href={`${baseUrl}?tab=${entry.key}`}>
            {entry.label} ({entry.total})
          </Button>
        ))}
      </nav>

      {tab === "comments" && (
        <DataView listLabel={dict.views.list} tableLabel={dict.views.table} cardsLabel={dict.views.cards} showModeSelector={queue.comments.rows.length > 0}>
          <div slot="table">
            {queue.comments.rows.length === 0 ? (
              <p class="rounded-xl border p-6 text-sm text-muted-foreground">{t.empty}</p>
            ) : (
              <Table aria-label={t.comments}>
                <TableHeader>
                  <TableRow>
                    <TableHead scope="col">{t.trip}</TableHead>
                    <TableHead scope="col">{dict.columns.name}</TableHead>
                    <TableHead scope="col">{dict.columns.status}</TableHead>
                    <TableHead scope="col">{dict.columns.date}</TableHead>
                    <TableHead scope="col"><span class="sr-only">{c.actions}</span></TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {queue.comments.rows.map((cm) => (
                    <TableRow>
                      <TableCell class="font-medium">{cm.tripTitle ?? cm.tripId}</TableCell>
                      <TableCell>{cm.authorName ?? cm.guestName ?? ""}</TableCell>
                      <TableCell><Badge variant={statusToneFor(cm.status)} size="sm">{adminStatusLabel(dict, cm.status)}</Badge></TableCell>
                      <TableCell class="whitespace-nowrap">{cm.createdAt.toISOString().slice(0, 16).replace("T", " ")}</TableCell>
                      <TableCell class="text-end">
                        <div data-comment-id={cm.id} class="flex flex-wrap justify-end gap-1">
                          <Button size="sm" variant="ghost" data-comment-approve>{t.approve}</Button>
                          <Button size="sm" variant="ghost" data-comment-reject data-confirm={t.reject}>{t.reject}</Button>
                          <Button size="sm" variant="ghost" data-comment-spam data-confirm={t.spam}>{t.spam}</Button>
                          <Button size="sm" variant="ghost" data-comment-trash data-confirm={t.trash}>{t.trash}</Button>
                          <Button size="sm" variant="ghost" data-comment-restore>{t.restore}</Button>
                        </div>
                      </TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            )}
          </div>

          <div slot="list" class="divide-y rounded-lg border">
            {queue.comments.rows.map((cm) => (
              <div data-comment-id={cm.id} class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
                <div class="min-w-0">
                  <p class="truncate font-medium">{cm.authorName ?? cm.guestName ?? ""}</p>
                  <p class="truncate text-xs text-muted-foreground">
                    {t.trip}: {cm.tripTitle ?? cm.tripId} · {cm.createdAt.toISOString().slice(0, 16).replace("T", " ")}
                  </p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                  <Badge variant={statusToneFor(cm.status)} size="sm">{adminStatusLabel(dict, cm.status)}</Badge>
                  <Button size="sm" variant="ghost" data-comment-approve>{t.approve}</Button>
                  <Button size="sm" variant="ghost" data-comment-reject data-confirm={t.reject}>{t.reject}</Button>
                  <Button size="sm" variant="ghost" data-comment-spam data-confirm={t.spam}>{t.spam}</Button>
                  <Button size="sm" variant="ghost" data-comment-trash data-confirm={t.trash}>{t.trash}</Button>
                  <Button size="sm" variant="ghost" data-comment-restore>{t.restore}</Button>
                </div>
              </div>
            ))}
          </div>

          <div slot="cards" class="space-y-4">
            {queue.comments.rows.length === 0 && <p class="rounded-xl border p-6 text-sm text-muted-foreground">{t.empty}</p>}
            {queue.comments.rows.map((cm) => (
              <article class="rounded-xl border p-5" data-comment-id={cm.id}>
                <p class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                  <span>{t.trip}: {cm.tripTitle ?? cm.tripId}</span>
                  <Badge variant={statusToneFor(cm.status)} size="sm">{adminStatusLabel(dict, cm.status)}</Badge>
                  <span>{cm.createdAt.toISOString().slice(0, 16).replace("T", " ")}</span>
                </p>
                <p class="mt-1 text-sm font-medium">{cm.authorName ?? cm.guestName ?? ""}</p>
                <p class="mt-2 whitespace-pre-wrap text-sm">{cm.content}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <Button size="sm" variant="outline" data-comment-approve>{t.approve}</Button>
                  <Button size="sm" variant="outline" data-comment-reject data-confirm={t.reject}>{t.reject}</Button>
                  <Button size="sm" variant="warning" data-comment-spam data-confirm={t.spam}>{t.spam}</Button>
                  <Button size="sm" variant="error" data-comment-trash data-confirm={t.trash}>{t.trash}</Button>
                  <Button size="sm" variant="ghost" data-comment-restore>{t.restore}</Button>
                </div>
              </article>
            ))}
          </div>
        </DataView>
      )}

      {tab === "reviews" && (
        <DataView listLabel={dict.views.list} tableLabel={dict.views.table} cardsLabel={dict.views.cards} showModeSelector={queue.reviews.rows.length > 0}>
          <div slot="table">
            {queue.reviews.rows.length === 0 ? (
              <p class="rounded-xl border p-6 text-sm text-muted-foreground">{t.empty}</p>
            ) : (
              <Table aria-label={t.reviews}>
                <TableHeader>
                  <TableRow>
                    <TableHead scope="col">{t.trip}</TableHead>
                    <TableHead scope="col">{dict.columns.name}</TableHead>
                    <TableHead scope="col">{t.rating}</TableHead>
                    <TableHead scope="col">{dict.columns.status}</TableHead>
                    <TableHead scope="col"><span class="sr-only">{c.actions}</span></TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {queue.reviews.rows.map((rv) => (
                    <TableRow>
                      <TableCell class="font-medium">{rv.tripTitle ?? rv.tripId}</TableCell>
                      <TableCell>{rv.authorName ?? ""}{rv.title ? ` — ${rv.title}` : ""}</TableCell>
                      <TableCell><bdi>{rv.rating}/5</bdi></TableCell>
                      <TableCell><Badge variant={statusToneFor(rv.status)} size="sm">{adminStatusLabel(dict, rv.status)}</Badge></TableCell>
                      <TableCell class="text-end">
                        <div data-review-id={rv.id} class="flex flex-wrap justify-end gap-1">
                          <Button size="sm" variant="ghost" data-review-approve>{t.approve}</Button>
                          <Button size="sm" variant="ghost" data-review-reject data-confirm={t.reject}>{t.reject}</Button>
                          <Button size="sm" variant="ghost" data-review-spam data-confirm={t.spam}>{t.spam}</Button>
                        </div>
                      </TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            )}
          </div>

          <div slot="list" class="divide-y rounded-lg border">
            {queue.reviews.rows.map((rv) => (
              <div data-review-id={rv.id} class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
                <div class="min-w-0">
                  <p class="truncate font-medium">{rv.authorName ?? ""}{rv.title ? ` — ${rv.title}` : ""}</p>
                  <p class="truncate text-xs text-muted-foreground">
                    {t.trip}: {rv.tripTitle ?? rv.tripId} · {t.rating} <bdi>{rv.rating}/5</bdi>
                  </p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                  <Badge variant={statusToneFor(rv.status)} size="sm">{adminStatusLabel(dict, rv.status)}</Badge>
                  <Button size="sm" variant="ghost" data-review-approve>{t.approve}</Button>
                  <Button size="sm" variant="ghost" data-review-reject data-confirm={t.reject}>{t.reject}</Button>
                  <Button size="sm" variant="ghost" data-review-spam data-confirm={t.spam}>{t.spam}</Button>
                </div>
              </div>
            ))}
          </div>

          <div slot="cards" class="space-y-4">
            {queue.reviews.rows.length === 0 && <p class="rounded-xl border p-6 text-sm text-muted-foreground">{t.empty}</p>}
            {queue.reviews.rows.map((rv) => (
              <article class="rounded-xl border p-5" data-review-id={rv.id}>
                <p class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                  <span>{t.trip}: {rv.tripTitle ?? rv.tripId}</span>
                  <Badge variant={statusToneFor(rv.status)} size="sm">{adminStatusLabel(dict, rv.status)}</Badge>
                  <span>{t.rating} <bdi>{rv.rating}/5</bdi></span>
                </p>
                <p class="mt-1 text-sm font-medium">{rv.authorName ?? ""}{rv.title ? ` — ${rv.title}` : ""}</p>
                <p class="mt-2 whitespace-pre-wrap text-sm">{rv.content}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <Button size="sm" variant="outline" data-review-approve>{t.approve}</Button>
                  <Button size="sm" variant="outline" data-review-reject data-confirm={t.reject}>{t.reject}</Button>
                  <Button size="sm" variant="warning" data-review-spam data-confirm={t.spam}>{t.spam}</Button>
                </div>
              </article>
            ))}
          </div>
        </DataView>
      )}

      {tab === "reports" && (
        <DataView listLabel={dict.views.list} tableLabel={dict.views.table} cardsLabel={dict.views.cards} showModeSelector={queue.reports.rows.length > 0}>
          <div slot="table">
            {queue.reports.rows.length === 0 ? (
              <p class="rounded-xl border p-6 text-sm text-muted-foreground">{t.empty}</p>
            ) : (
              <Table aria-label={t.reports}>
                <TableHeader>
                  <TableRow>
                    <TableHead scope="col">{t.reason}</TableHead>
                    <TableHead scope="col">{dict.columns.status}</TableHead>
                    <TableHead scope="col">{dict.columns.date}</TableHead>
                    <TableHead scope="col"><span class="sr-only">{c.actions}</span></TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {queue.reports.rows.map((rp) => (
                    <TableRow>
                      <TableCell class="font-medium">{rp.reason}</TableCell>
                      <TableCell><Badge variant={statusToneFor(rp.status)} size="sm">{adminStatusLabel(dict, rp.status)}</Badge></TableCell>
                      <TableCell class="whitespace-nowrap">{rp.createdAt.toISOString().slice(0, 16).replace("T", " ")}</TableCell>
                      <TableCell class="text-end">
                        <div data-report-id={rp.id} class="flex flex-wrap justify-end gap-1">
                          <Button size="sm" variant="ghost" data-report-reviewed>{t.reviewed}</Button>
                          <Button size="sm" variant="ghost" data-report-resolved data-confirm={t.resolve}>{t.resolve}</Button>
                          <Button size="sm" variant="ghost" data-report-rejected data-confirm={t.reject}>{t.reject}</Button>
                        </div>
                      </TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            )}
          </div>

          <div slot="list" class="divide-y rounded-lg border">
            {queue.reports.rows.map((rp) => (
              <div data-report-id={rp.id} class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
                <div class="min-w-0">
                  <p class="truncate font-medium">{rp.reason}</p>
                  <p class="truncate text-xs text-muted-foreground">{rp.description ?? ""}</p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                  <Badge variant={statusToneFor(rp.status)} size="sm">{adminStatusLabel(dict, rp.status)}</Badge>
                  <Button size="sm" variant="ghost" data-report-reviewed>{t.reviewed}</Button>
                  <Button size="sm" variant="ghost" data-report-resolved data-confirm={t.resolve}>{t.resolve}</Button>
                  <Button size="sm" variant="ghost" data-report-rejected data-confirm={t.reject}>{t.reject}</Button>
                </div>
              </div>
            ))}
          </div>

          <div slot="cards" class="space-y-4">
            {queue.reports.rows.length === 0 && <p class="rounded-xl border p-6 text-sm text-muted-foreground">{t.empty}</p>}
            {queue.reports.rows.map((rp) => (
              <article class="rounded-xl border p-5" data-report-id={rp.id}>
                <p class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                  <Badge variant={statusToneFor(rp.status)} size="sm">{adminStatusLabel(dict, rp.status)}</Badge>
                  <span>{t.reason}: {rp.reason}</span>
                  <span>{rp.createdAt.toISOString().slice(0, 16).replace("T", " ")}</span>
                </p>
                <p class="mt-2 text-sm">{rp.description ?? ""}</p>
                <p class="mt-1 font-mono text-xs">trip:{rp.tripId ?? "—"} comment:{rp.commentId ?? "—"} review:{rp.reviewId ?? "—"}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <Button size="sm" variant="outline" data-report-reviewed>{t.reviewed}</Button>
                  <Button size="sm" variant="warning" data-report-resolved data-confirm={t.resolve}>{t.resolve}</Button>
                  <Button size="sm" variant="error" data-report-rejected data-confirm={t.reject}>{t.reject}</Button>
                </div>
              </article>
            ))}
          </div>
        </DataView>
      )}

      <AdminPagination currentPage={queue.meta.page} totalPages={totalPages} baseUrl={paginationUrl} />

      <input type="hidden" data-moderation-i18n data-error={c.error} data-confirm-label={c.confirm} data-cancel-label={c.cancel} />
    </section>
  </AuthLayout>
</BaseLayout>

<script>
  import { actions } from "astro:actions";
  import { toast } from "@atoms/toast";
  import { confirmAdminAction } from "@/core/admin";

  const root = document.querySelector<HTMLElement>("[data-trip-moderation]");
  const i18n = document.querySelector<HTMLInputElement>("[data-moderation-i18n]");

  const confirmFirst = async (label: string | undefined): Promise<boolean> => {
    if (!label) return true;
    return confirmAdminAction({
      title: label,
      message: label,
      confirmLabel: i18n?.dataset.confirmLabel ?? "OK",
      cancelLabel: i18n?.dataset.cancelLabel ?? "",
    });
  };

  const report = (error: { message?: string } | null | undefined) => {
    if (error) toast.error(error.message ?? i18n?.dataset.error ?? "");
    else window.location.reload();
  };

  root?.querySelectorAll<HTMLElement>("[data-comment-id]").forEach((card) => {
    const commentId = card.getAttribute("data-comment-id") ?? "";
    const call = async (moderationAction: "APPROVE" | "REJECT" | "DELETE" | "RESTORE" | "EDIT", label?: string) => {
      if (!(await confirmFirst(label))) return;
      const { error } = await actions.moderateTripComment({ commentId, moderationAction });
      report(error);
    };
    card.querySelector<HTMLButtonElement>("[data-comment-approve]")?.addEventListener("click", () => void call("APPROVE"));
    card.querySelector<HTMLButtonElement>("[data-comment-reject]")?.addEventListener("click", (e) => void call("REJECT", (e.currentTarget as HTMLElement).dataset.confirm));
    card.querySelector<HTMLButtonElement>("[data-comment-spam]")?.addEventListener("click", (e) => void call("DELETE", (e.currentTarget as HTMLElement).dataset.confirm));
    card.querySelector<HTMLButtonElement>("[data-comment-trash]")?.addEventListener("click", (e) => void call("DELETE", (e.currentTarget as HTMLElement).dataset.confirm));
    card.querySelector<HTMLButtonElement>("[data-comment-restore]")?.addEventListener("click", () => void call("RESTORE"));
  });

  root?.querySelectorAll<HTMLElement>("[data-review-id]").forEach((card) => {
    const reviewId = card.getAttribute("data-review-id") ?? "";
    const call = async (status: "PENDING" | "APPROVED" | "REJECTED" | "SPAM", label?: string) => {
      if (!(await confirmFirst(label))) return;
      const { error } = await actions.moderateTripReview({ reviewId, status });
      report(error);
    };
    card.querySelector<HTMLButtonElement>("[data-review-approve]")?.addEventListener("click", () => void call("APPROVED"));
    card.querySelector<HTMLButtonElement>("[data-review-reject]")?.addEventListener("click", (e) => void call("REJECTED", (e.currentTarget as HTMLElement).dataset.confirm));
    card.querySelector<HTMLButtonElement>("[data-review-spam]")?.addEventListener("click", (e) => void call("SPAM", (e.currentTarget as HTMLElement).dataset.confirm));
  });

  root?.querySelectorAll<HTMLElement>("[data-report-id]").forEach((card) => {
    const id = card.getAttribute("data-report-id") ?? "";
    const call = async (status: "REVIEWED" | "RESOLVED" | "REJECTED", label?: string) => {
      if (!(await confirmFirst(label))) return;
      const { error } = await actions.resolveTripReport({ id, status });
      report(error);
    };
    card.querySelector<HTMLButtonElement>("[data-report-reviewed]")?.addEventListener("click", () => void call("REVIEWED"));
    card.querySelector<HTMLButtonElement>("[data-report-resolved]")?.addEventListener("click", (e) => void call("RESOLVED", (e.currentTarget as HTMLElement).dataset.confirm));
    card.querySelector<HTMLButtonElement>("[data-report-rejected]")?.addEventListener("click", (e) => void call("REJECTED", (e.currentTarget as HTMLElement).dataset.confirm));
  });
</script>
