---
import { requirePermission } from "@/lib/auth-guards";
import { loadTripModerationQueue, loadTripModerationCounts } from "@/modules/trips/loaders/admin-moderation.loader";
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";

export const prerender = false;

const result = await requirePermission(Astro, { trip: ["read"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;

const p = Astro.url.searchParams;
const queue = await loadTripModerationQueue({
  page: p.get("page") ?? undefined,
  pageSize: p.get("pageSize") ?? undefined,
  tab: p.get("tab") ?? undefined,
  status: p.get("status") ?? undefined,
  tripId: p.get("tripId") ?? undefined,
});
const counts = await loadTripModerationCounts().catch(() => ({ pendingComments: 0, pendingReviews: 0, pendingReports: 0 }));
const baseUrl = `/${locale}/admin/trips/moderation`;
const title = locale === "fr" ? "Modération — Avis & commentaires voyage" : "Moderation — Trip reviews & comments";
const tab = queue.tab;
const t = locale === "fr"
  ? { comments: "Commentaires", reviews: "Avis", reports: "Signalements", approve: "Approuver", reject: "Rejeter", spam: "Spam", trash: "Corbeille", restore: "Restaurer", resolve: "Résoudre", pending: "En attente", trip: "Voyage", author: "Auteur", content: "Contenu", reason: "Motif", status: "Statut", empty: "Aucun élément.", rating: "Note" }
  : { comments: "Comments", reviews: "Reviews", reports: "Reports", approve: "Approve", reject: "Reject", spam: "Spam", trash: "Trash", restore: "Restore", resolve: "Resolve", pending: "Pending", trip: "Trip", author: "Author", content: "Content", reason: "Reason", status: "Status", empty: "Nothing here.", rating: "Rating" };
---

<BaseLayout title={title} description={title} canonicalPath={baseUrl}>
  <AuthLayout title={title}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="trips" />
    <section class="mx-auto max-w-6xl space-y-8 px-6 py-10" data-trip-moderation>
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <span class="rounded-full border px-3 py-1">💬 {counts.pendingComments} {t.comments}</span>
        <span class="rounded-full border px-3 py-1">★ {counts.pendingReviews} {t.reviews}</span>
        <span class="rounded-full border px-3 py-1">⚑ {counts.pendingReports} {t.reports}</span>
      </div>
      <nav class="flex gap-2 text-sm" aria-label={title}>
        <a class:list={["rounded-full border px-4 py-1.5", tab === "comments" && "bg-primary text-primary-foreground"]} href={`${baseUrl}?tab=comments`}>{t.comments} ({queue.comments.total})</a>
        <a class:list={["rounded-full border px-4 py-1.5", tab === "reviews" && "bg-primary text-primary-foreground"]} href={`${baseUrl}?tab=reviews`}>{t.reviews} ({queue.reviews.total})</a>
        <a class:list={["rounded-full border px-4 py-1.5", tab === "reports" && "bg-primary text-primary-foreground"]} href={`${baseUrl}?tab=reports`}>{t.reports} ({queue.reports.total})</a>
      </nav>

      {tab === "comments" && (
        <div class="space-y-4">
          {queue.comments.rows.length === 0 && <p class="rounded-xl border p-6 text-sm text-muted-foreground">{t.empty}</p>}
          {queue.comments.rows.map((c) => (
            <article class="rounded-xl border p-5" data-comment-id={c.id}>
              <p class="text-xs text-muted-foreground">{t.trip} : {c.tripTitle ?? c.tripId} · {c.status} · {c.createdAt.toISOString().slice(0, 16).replace("T", " ")}</p>
              <p class="mt-1 text-sm font-medium">{c.authorName ?? c.guestName ?? ""}</p>
              <p class="mt-2 whitespace-pre-wrap text-sm">{c.content}</p>
              <div class="mt-3 flex flex-wrap gap-2 text-xs">
                <button type="button" class="rounded-md border px-3 py-1.5" data-comment-approve>{t.approve}</button>
                <button type="button" class="rounded-md border px-3 py-1.5" data-comment-reject>{t.reject}</button>
                <button type="button" class="rounded-md border px-3 py-1.5" data-comment-spam>{t.spam}</button>
                <button type="button" class="rounded-md border px-3 py-1.5" data-comment-trash>{t.trash}</button>
                <button type="button" class="rounded-md border px-3 py-1.5" data-comment-restore>{t.restore}</button>
              </div>
            </article>
          ))}
        </div>
      )}

      {tab === "reviews" && (
        <div class="space-y-4">
          {queue.reviews.rows.length === 0 && <p class="rounded-xl border p-6 text-sm text-muted-foreground">{t.empty}</p>}
          {queue.reviews.rows.map((r) => (
            <article class="rounded-xl border p-5" data-review-id={r.id}>
              <p class="text-xs text-muted-foreground">{t.trip} : {r.tripTitle ?? r.tripId} · {r.status} · {t.rating} <bdi>{r.rating}/5</bdi></p>
              <p class="mt-1 text-sm font-medium">{r.authorName ?? ""}{r.title ? ` — ${r.title}` : ""}</p>
              <p class="mt-2 whitespace-pre-wrap text-sm">{r.content}</p>
              <div class="mt-3 flex flex-wrap gap-2 text-xs">
                <button type="button" class="rounded-md border px-3 py-1.5" data-review-approve>{t.approve}</button>
                <button type="button" class="rounded-md border px-3 py-1.5" data-review-reject>{t.reject}</button>
                <button type="button" class="rounded-md border px-3 py-1.5" data-review-spam>{t.spam}</button>
              </div>
            </article>
          ))}
        </div>
      )}

      {tab === "reports" && (
        <div class="space-y-4">
          {queue.reports.rows.length === 0 && <p class="rounded-xl border p-6 text-sm text-muted-foreground">{t.empty}</p>}
          {queue.reports.rows.map((r) => (
            <article class="rounded-xl border p-5" data-report-id={r.id}>
              <p class="text-xs text-muted-foreground">{r.status} · {t.reason} : {r.reason} · {r.createdAt.toISOString().slice(0, 16).replace("T", " ")}</p>
              <p class="mt-2 text-sm">{r.description ?? ""}</p>
              <p class="mt-1 font-mono text-xs">trip:{r.tripId ?? "—"} comment:{r.commentId ?? "—"} review:{r.reviewId ?? "—"}</p>
              <div class="mt-3 flex flex-wrap gap-2 text-xs">
                <button type="button" class="rounded-md border px-3 py-1.5" data-report-reviewed>REVIEWED</button>
                <button type="button" class="rounded-md border px-3 py-1.5" data-report-resolved>{t.resolve}</button>
                <button type="button" class="rounded-md border px-3 py-1.5" data-report-rejected>{t.reject}</button>
              </div>
            </article>
          ))}
        </div>
      )}
    </section>
  </AuthLayout>
</BaseLayout>

<script>
  import { actions } from "astro:actions";
  const root = document.querySelector<HTMLElement>("[data-trip-moderation]");
  root?.querySelectorAll<HTMLElement>("[data-comment-id]").forEach((card) => {
    const commentId = card.getAttribute("data-comment-id") ?? "";
    const call = async (moderationAction: "APPROVE" | "REJECT" | "DELETE" | "RESTORE" | "EDIT"): Promise<void> => {
      const { error } = await actions.moderateTripComment({ commentId, moderationAction });
      if (error) alert(error.message);
      else window.location.reload();
    };
    card.querySelector<HTMLButtonElement>("[data-comment-approve]")?.addEventListener("click", () => void call("APPROVE"));
    card.querySelector<HTMLButtonElement>("[data-comment-reject]")?.addEventListener("click", () => void call("REJECT"));
    card.querySelector<HTMLButtonElement>("[data-comment-spam]")?.addEventListener("click", () => void call("DELETE"));
    card.querySelector<HTMLButtonElement>("[data-comment-trash]")?.addEventListener("click", () => void call("DELETE"));
    card.querySelector<HTMLButtonElement>("[data-comment-restore]")?.addEventListener("click", () => void call("RESTORE"));
  });
  root?.querySelectorAll<HTMLElement>("[data-review-id]").forEach((card) => {
    const reviewId = card.getAttribute("data-review-id") ?? "";
    const call = async (status: "PENDING" | "APPROVED" | "REJECTED" | "SPAM"): Promise<void> => {
      const { error } = await actions.moderateTripReview({ reviewId, status });
      if (error) alert(error.message);
      else window.location.reload();
    };
    card.querySelector<HTMLButtonElement>("[data-review-approve]")?.addEventListener("click", () => void call("APPROVED"));
    card.querySelector<HTMLButtonElement>("[data-review-reject]")?.addEventListener("click", () => void call("REJECTED"));
    card.querySelector<HTMLButtonElement>("[data-review-spam]")?.addEventListener("click", () => void call("SPAM"));
  });
  root?.querySelectorAll<HTMLElement>("[data-report-id]").forEach((card) => {
    const id = card.getAttribute("data-report-id") ?? "";
    const call = async (status: "REVIEWED" | "RESOLVED" | "REJECTED"): Promise<void> => {
      const { error } = await actions.resolveTripReport({ id, status });
      if (error) alert(error.message);
      else window.location.reload();
    };
    card.querySelector<HTMLButtonElement>("[data-report-reviewed]")?.addEventListener("click", () => void call("REVIEWED"));
    card.querySelector<HTMLButtonElement>("[data-report-resolved]")?.addEventListener("click", () => void call("RESOLVED"));
    card.querySelector<HTMLButtonElement>("[data-report-rejected]")?.addEventListener("click", () => void call("REJECTED"));
  });
</script>
