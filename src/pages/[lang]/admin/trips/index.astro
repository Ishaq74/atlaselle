---
import { requirePermission } from "@/lib/auth-guards";
import { hasVoyagePermission } from "@/actions/voyage/_helpers";
import { loadAdminTrips } from "@/modules/trips/loaders/admin-trips.loader";
import { TRIP_STATUSES } from "@database/schemas/trips.schema";
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import AdminTripList from "@/modules/trips/components/AdminTripList.astro";

export const prerender = false;

const result = await requirePermission(Astro, { trip: ["read"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;

const p = Astro.url.searchParams;
const { rows, meta } = await loadAdminTrips({
  page: p.get("page") ?? undefined,
  pageSize: p.get("pageSize") ?? undefined,
  search: p.get("search") ?? undefined,
  status: p.get("status") ?? undefined,
  countryCode: p.get("countryCode") ?? undefined,
  sortBy: p.get("sortBy") ?? undefined,
  sortOrder: p.get("sortOrder") ?? undefined,
});
const baseUrl = `/${locale}/admin/trips`;
const title = authT.admin.tabs.trips;
const canCreate = await hasVoyagePermission(Astro, { trip: ["create"] });
---

<BaseLayout title={title} description={title} canonicalPath={baseUrl}>
  <AuthLayout title={title}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="trips" />
    <AdminTripList
      rows={rows}
      meta={meta}
      locale={locale}
      baseUrl={baseUrl}
      search={p.get("search") ?? undefined}
      status={p.get("status") ?? undefined}
      countryCode={p.get("countryCode") ?? undefined}
      statuses={[...TRIP_STATUSES]}
      canCreate={canCreate}
    />
  </AuthLayout>
</BaseLayout>
