---
import { requirePermission } from '@/lib/auth-guards';
import { getAdminPageById, getAdminPageSections, getAdminPagesList } from '@database/loaders/page.loader';
import { getSiteSettings, getContactInfo } from '@database/loaders/site.loader';
import BaseLayout from '@layouts/BaseLayout.astro';
import AuthLayout from '@organisms/AuthLayout/AuthLayout.astro';
import AdminSidebar from '@organisms/AdminSidebar/AdminSidebar.astro';
import AdminPagesPage from '@pages/admin/AdminPagesPage.astro';
import AdminSectionsEditor from '@pages/admin/AdminSectionsEditor.astro';
import AdminLegalEditor from '@pages/admin/AdminLegalEditor.astro';

export const prerender = false;

const result = await requirePermission(Astro, { page: ["read"] });
if ('redirect' in result) return result.redirect;
const { locale, authT } = result;

const editId = Astro.url.searchParams.get('edit');

// ─── Edit mode: load page + sections ───
let editPage: Awaited<ReturnType<typeof getAdminPageById>> = null;
let editSections: Awaited<ReturnType<typeof getAdminPageSections>> = [];
let templateVars: Record<string, string> = {};
if (editId) {
  const row = await getAdminPageById(editId);
  if (row) {
    editPage = row;
    const [sects, siteData, contactData] = await Promise.all([
      getAdminPageSections(editId),
      getSiteSettings(locale),
      getContactInfo(),
    ]);
    editSections = sects;
    templateVars = {
      siteName: siteData?.siteName ?? '',
      email: contactData?.email ?? '',
      phone: contactData?.phone ?? '',
      address: contactData?.address ?? '',
      city: contactData?.city ?? '',
      postalCode: contactData?.postalCode ?? '',
      country: contactData?.country ?? '',
    };
  }
}

// ─── List mode: paginated pages ───
const PER_PAGE = 20;
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);

const { rows: allPages, total: totalCount } = await getAdminPagesList(page, PER_PAGE);
const totalPages = Math.max(1, Math.ceil(totalCount / PER_PAGE));

// Clamp page to actual totalPages
if (page > totalPages && totalPages > 0) {
  const url = new URL(Astro.url);
  url.searchParams.set('page', String(totalPages));
  return Astro.redirect(url.pathname + url.search);
}
---

<BaseLayout title={editPage ? `${authT.admin.cms.pages.editPage} — ${editPage.title}` : authT.admin.cms.pages.title} description={authT.admin.cms.pages.description}>
  <AuthLayout title={editPage ? `${authT.admin.cms.pages.editPage} — ${editPage.title}` : authT.admin.cms.pages.title}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="pages" />
    {editPage ? (
      editPage.template === 'legal'
        ? <AdminLegalEditor t={authT} locale={locale} page={editPage} sections={editSections} templateVars={templateVars} />
        : <AdminSectionsEditor t={authT} locale={locale} page={editPage} sections={editSections} />
    ) : (
      <AdminPagesPage
        t={authT}
        locale={locale}
        pages={allPages}
        currentPage={page}
        totalPages={totalPages}
        baseUrl={Astro.url}
      />
    )}
  </AuthLayout>
</BaseLayout>
