---
import { toLocale } from "@i18n/utils";
import { LOCALES } from "@i18n/config";
import BaseLayout from "@layouts/BaseLayout.astro";
const locale = toLocale(Astro.params.lang);
// Slug universel 'faq' — canonique = soi, alternates = les 4 locales (page universelle conservée en soi).
const alternateUrls = Object.fromEntries(LOCALES.map((loc) => [loc, `/${loc}/faq`]));
const copy = locale === "fr" ? {title:"Questions fréquentes",items:[["Comment réserver ?","Déposez votre candidature : nous confirmons la disponibilité avant tout paiement."],["Les vols sont-ils inclus ?","Les vols internationaux ne sont pas inclus, sauf mention expresse sur votre confirmation."],["Puis-je demander une chambre individuelle ?","Oui, selon disponibilité et supplément communiqué avant confirmation."]]} : locale === "ar" ? {title:"الأسئلة الشائعة",items:[["كيف أحجز؟","قدّم طلبك؛ نؤكد التوفر قبل أي دفعة."],["هل الرحلات الجوية مشمولة؟","لا تشمل الرحلات الجوية الدولية إلا إذا ورد نص صريح في تأكيدك."],["هل يمكنني طلب غرفة مفردة؟","نعم، بحسب التوفر والرسوم الإضافية التي نبلغك بها قبل التأكيد."]]} : {title:"Frequently asked questions",items:[["How do I reserve?","Submit an application; we confirm availability before any payment is due."],["Are flights included?","International flights are not included unless your confirmation explicitly says otherwise."],["Can I request a single room?","Yes, subject to availability and a supplement confirmed before booking."]]};
---
<BaseLayout title={`${copy.title} — ATLASELLE`} description="ATLASELLE travel questions and answers." canonicalPath={`/${locale}/faq`} alternateUrls={alternateUrls}><section class="mx-auto max-w-3xl px-6 py-20"><h1 class="text-4xl font-bold">{copy.title}</h1><div class="mt-10 divide-y border-y">{copy.items.map(([q,a]) => <details class="py-5"><summary class="cursor-pointer font-semibold">{q}</summary><p class="mt-3 text-muted-foreground">{a}</p></details>)}</div></section></BaseLayout>
