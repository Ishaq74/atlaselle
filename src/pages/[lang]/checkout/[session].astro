---
import { toLocale } from "@i18n/utils";
import type { Locale } from "@i18n/config";
import { loadCheckoutPage } from "@/modules/reservations/loaders/booking.loader";
import { resolveLegalLinks } from "@/lib/legal-pages";
import BaseLayout from "@layouts/BaseLayout.astro";

export const prerender = false;

const locale = toLocale(Astro.params.lang) as Locale;
const roomType = Astro.url.searchParams.get("room") === "single" ? "single" : "shared";
const data = await loadCheckoutPage(locale, Astro.params.session ?? "", roomType);
if (!data) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const fmt = (cents: number) => `${data.quote.currency === "EUR" ? "€" : data.quote.currency + " "}${(cents / 100).toLocaleString("en")}`;
const l =
  locale === "fr"
    ? { title: "Paiement", room: "Chambre", shared: "Double partagée", single: "Individuelle", base: "Base", supplement: "Supplément", discount: "Réduction", tax: "Taxes", fee: "Frais", total: "Total", deposit: "Acompte prélevé aujourd'hui", balance: "Solde plus tard", pay: "Payer", dates: "Départ" }
    : locale === "es"
      ? { title: "Pago", room: "Habitación", shared: "Doble compartida", single: "Individual", base: "Base", supplement: "Suplemento", discount: "Descuento", tax: "Impuestos", fee: "Gastos", total: "Total", deposit: "Anticipo cobrado hoy", balance: "Saldo después", pay: "Pagar", dates: "Salida" }
      : locale === "ar"
        ? { title: "الدفع", room: "الغرفة", shared: "مزدوجة مشتركة", single: "مفردة", base: "الأساس", supplement: "إضافة", discount: "خصم", tax: "ضرائب", fee: "رسوم", total: "المجموع", deposit: "الدفعة اليوم", balance: "الرصيد لاحقا", pay: "ادفع", dates: "المغادرة" }
        : { title: "Checkout", room: "Room", shared: "Shared twin", single: "Single", base: "Base", supplement: "Supplement", discount: "Discount", tax: "Tax", fee: "Fee", total: "Total", deposit: "Deposit charged today", balance: "Balance later", pay: "Pay", dates: "Departure" };
// Label de la checkbox termsAccepted avec lien vers les conditions de
// réservation (slugs DB, fallback seed — jamais de page cassée).
const legalLinks = await resolveLegalLinks(locale);
const termsLabel =
  locale === "fr"
    ? `J'ai lu et j'accepte les <a href="${legalLinks.terms}" class="text-primary underline" target="_blank" rel="noopener">conditions de réservation</a>.`
    : locale === "es"
      ? `He leído y acepto las <a href="${legalLinks.terms}" class="text-primary underline" target="_blank" rel="noopener">condiciones de reserva</a>.`
      : locale === "ar"
        ? `قرأت <a href="${legalLinks.terms}" class="text-primary underline" target="_blank" rel="noopener">شروط الحجز</a> وأوافق عليها.`
        : `I have read and accept the <a href="${legalLinks.terms}" class="text-primary underline" target="_blank" rel="noopener">booking terms</a>.`;
const base = `/${locale}/checkout/${data.sessionId}`;
---
<BaseLayout title={`${l.title} — ${data.tripTitle}`} description={data.tripTitle} canonicalPath={base} robots="noindex, nofollow">
  <section class="mx-auto max-w-xl px-6 py-14" data-checkout-page data-session={data.sessionId} data-locale={locale}>
    <h1 class="text-4xl font-bold">{l.title}</h1>
    <p class="mt-2 text-muted-foreground">{data.tripTitle}</p>
    <p class="mt-1 text-sm">{l.dates} : <bdi>{data.startDate.toISOString().slice(0, 10)} → {data.endDate.toISOString().slice(0, 10)}</bdi></p>

    <div class="mt-6 flex gap-2 text-sm">
      <a class:list={["rounded-full border px-4 py-1.5", roomType === "shared" && "bg-primary text-primary-foreground"]} href={`${base}?room=shared`}>{l.shared}</a>
      <a class:list={["rounded-full border px-4 py-1.5", roomType === "single" && "bg-primary text-primary-foreground"]} href={`${base}?room=single`}>{l.single}</a>
    </div>

    <dl class="mt-6 space-y-2 rounded-xl border p-6 text-sm">
      <div class="flex justify-between"><dt>{l.base}</dt><dd><bdi>{fmt(data.quote.baseAmount)}</bdi></dd></div>
      {data.quote.supplementAmount > 0 ? <div class="flex justify-between"><dt>{l.supplement}</dt><dd><bdi>{fmt(data.quote.supplementAmount)}</bdi></dd></div> : null}
      {data.quote.discountAmount > 0 ? <div class="flex justify-between"><dt>{l.discount}</dt><dd><bdi>−{fmt(data.quote.discountAmount)}</bdi></dd></div> : null}
      {data.quote.taxAmount > 0 ? <div class="flex justify-between"><dt>{l.tax}</dt><dd><bdi>{fmt(data.quote.taxAmount)}</bdi></dd></div> : null}
      {data.quote.feeAmount > 0 ? <div class="flex justify-between"><dt>{l.fee}</dt><dd><bdi>{fmt(data.quote.feeAmount)}</bdi></dd></div> : null}
      <div class="flex justify-between border-t pt-2 text-base font-bold"><dt>{l.total}</dt><dd><bdi>{fmt(data.quote.totalAmount)}</bdi></dd></div>
      <div class="flex justify-between text-muted-foreground"><dt>{l.deposit}</dt><dd><bdi>{fmt(data.quote.depositAmount)}</bdi></dd></div>
      <div class="flex justify-between text-muted-foreground"><dt>{l.balance}</dt><dd><bdi>{fmt(data.quote.balanceAmount)}</bdi></dd></div>
    </dl>

    <form data-checkout-form class="mt-6 space-y-4 rounded-xl border p-6">
      <label class="block font-medium">Email<input required name="travelerEmail" type="email" maxlength="320" class="mt-2 w-full rounded-md border bg-background p-3" /></label>
      {/* eslint-disable-next-line astro/no-set-html-directive, astro/jsx-a11y/label-has-associated-control -- termsLabel est construit côté serveur depuis des textes i18n statiques et des slugs DB (aucune entrée utilisateur) ; le texte du label est rendu via set:html, invisible pour l'analyse statique */}
      <label class="flex items-start gap-2 text-sm"><input required type="checkbox" name="terms" class="mt-1" /><span set:html={termsLabel} /></label>
      <button class="w-full rounded-md bg-primary px-4 py-3 font-semibold text-primary-foreground">{l.pay} · <bdi>{fmt(data.quote.totalAmount)}</bdi></button>
      <output class="block text-sm" data-form-message></output>
    </form>
  </section>
</BaseLayout>

<script>
  import { actions } from "astro:actions";
  import type { Locale } from "@i18n/config";
  const root = document.querySelector("[data-checkout-page]");
  const sessionId = root?.getAttribute("data-session") ?? "";
  const locale = (root?.getAttribute("data-locale") ?? "en") as Locale;
  const room = new URLSearchParams(window.location.search).get("room") === "single" ? "single" : "shared";
  document.querySelector("[data-checkout-form]")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement | null;
    if (!form) return;
    const data = new FormData(form);
    const el = form.querySelector("[data-form-message]");
    const btn = form.querySelector("button");
    btn?.setAttribute("disabled", "");
    try {
      if (data.get("terms") !== "on") {
        if (el) el.textContent = "Error";
        return;
      }
      const { data: result, error } = await actions.initiateCheckout({
        checkoutSessionId: sessionId,
        travelerEmail: String(data.get("travelerEmail") ?? ""),
        roomType: room,
        locale,
        termsAccepted: true as const,
      });
      if (error || !result) {
        if (el) el.textContent = error?.message ?? "Error";
      } else {
        window.location.href = result.checkoutUrl;
      }
    } finally {
      btn?.removeAttribute("disabled");
    }
  });
</script>
