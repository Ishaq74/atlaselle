---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getServices, getServiceCategories, getServiceBySlug } from "@/modules/services/loaders";
import ServicesListingPage from "@/modules/services/components/lists/ServicesListingPage.astro";
import { ServiceDetail } from "@/modules/services/components/single";
import { buildServiceJsonLd } from "@/modules/services/seo";
import { buildServiceUrl } from "@/modules/services/utils";
import { getServiceTranslations } from "@/modules/services/i18n";
import type { Locale } from "@i18n/config";

export const prerender = false;
const locale = (Astro.params.lang ?? "fr") as Locale;
const slug = Astro.params.slug;
if (!slug) return Astro.redirect(`/${locale}/services`);

const t = getServiceTranslations(locale);
const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? "1") || 1);

// Single dynamic route (no [categorySlug].astro collision): a category slug
// renders the listing, otherwise a service slug renders the detail.
const categories = await getServiceCategories(locale);
const category = categories.find((row) => (row.translation?.slug ?? row.category.slug) === slug);

let detail: Awaited<ReturnType<typeof getServiceBySlug>> = null;
let listing: Awaited<ReturnType<typeof getServices>> | null = null;
if (category) {
  listing = await getServices({ categoryId: category.category.id, page }, locale, true);
} else {
  detail = await getServiceBySlug(slug, locale);
  if (!detail) return Astro.redirect(`/${locale}/services`);
}

const categoryItems = categories.map((row) => ({ slug: row.translation?.slug ?? row.category.slug, name: row.translation?.name ?? row.category.slug }));
const title = category
  ? (category.translation?.name ?? category.category.slug)
  : (detail?.translation?.title ?? t.labels.service);
const description = category
  ? (category.translation?.description ?? t.meta.description)
  : (detail?.translation?.excerpt ?? detail?.translation?.metaDescription ?? t.meta.description);
const canonicalUrl = category
  ? `/${locale}/services/${category.translation?.slug ?? category.category.slug}`
  : buildServiceUrl(locale, detail?.translation?.slug ?? detail?.service.slug ?? slug);
const canonicalHref = new URL(canonicalUrl, Astro.url.origin).href;
const jsonLdString = !category && detail ? JSON.stringify(buildServiceJsonLd({
  name: title,
  description,
  slug: canonicalHref,
  priceMinor: detail.service.priceMinor,
  currency: detail.service.currency,
  ratingAverage100: detail.service.ratingAverage100,
  ratingCount: detail.service.ratingCount,
})) : undefined;
---
<BaseLayout title={category ? title : `${title} — ${t.meta.title}`} description={description} jsonLd={jsonLdString}>
  <link rel="canonical" href={canonicalHref} />
  {category && listing ? (
    <main><ServicesListingPage locale={locale} title={title} description={category.translation?.description} items={listing.items} meta={listing} baseUrl={`/${locale}/services/${category.translation?.slug ?? category.category.slug}`} categories={categoryItems} activeCategorySlug={category.translation?.slug ?? category.category.slug} /></main>
  ) : detail ? (
    <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8"><ServiceDetail item={detail} locale={locale} /></main>
  ) : null}
</BaseLayout>
