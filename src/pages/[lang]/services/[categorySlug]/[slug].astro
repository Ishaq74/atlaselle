---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getServiceBySlug } from "@/modules/services/loaders";
import { ServiceDetail } from "@/modules/services/components/single";
import { buildServiceJsonLd } from "@/modules/services/seo";
import { buildServiceUrl } from "@/modules/services/utils";
import { getServiceTranslations } from "@/modules/services/i18n";
import type { Locale } from "@i18n/config";
export const prerender = false;
const locale = (Astro.params.lang ?? "fr") as Locale;
const categorySlug = Astro.params.categorySlug!;
const slug = Astro.params.slug!;
const item = await getServiceBySlug(slug, locale, categorySlug);
if (!item) {
  // Wrong category in the URL? Redirect to the canonical category URL
  // (301) instead of the generic list — same contract as the blog routes.
  const unscoped = await getServiceBySlug(slug, locale);
  const canonicalCategorySlug = unscoped?.categories[0]?.slug;
  if (unscoped && canonicalCategorySlug && canonicalCategorySlug !== categorySlug) {
    return Astro.redirect(
      `${buildServiceUrl(locale, unscoped.translation?.slug ?? unscoped.service.slug, canonicalCategorySlug)}${Astro.url.search}`,
      301,
    );
  }
  return Astro.redirect(`/${locale}/services`);
}
const t = getServiceTranslations(locale);
const title = item.translation?.title ?? t.labels.service;
const description = item.translation?.excerpt ?? t.meta.description;
const canonicalCategory = item.categories.find((category) => category.slug === categorySlug)?.slug ?? categorySlug;
const canonicalUrl = buildServiceUrl(locale, item.translation?.slug ?? item.service.slug, canonicalCategory);
const jsonLdString = JSON.stringify(buildServiceJsonLd({ name: title, description, slug: new URL(canonicalUrl, Astro.url.origin).href, priceMinor: item.service.priceMinor, currency: item.service.currency, ratingAverage100: item.service.ratingAverage100, ratingCount: item.service.ratingCount }));
---
<BaseLayout title={`${title} — ${t.meta.title}`} description={description} jsonLd={jsonLdString}>
  <link rel="canonical" href={new URL(canonicalUrl, Astro.url.origin).href} />
  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8"><ServiceDetail item={item} locale={locale} /></main>
</BaseLayout>
