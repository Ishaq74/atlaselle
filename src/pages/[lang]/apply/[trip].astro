---
import { toLocale } from "@i18n/utils";
import { getTripBySlug, tripUrl } from "@/data/trips";
import BaseLayout from "@layouts/BaseLayout.astro";
const locale = toLocale(Astro.params.lang);
const journey = getTripBySlug(locale, Astro.params.trip ?? "");
if (!journey) return Astro.rewrite("/404");
const copy = journey.translations[locale as Exclude<typeof locale, "es">] ?? journey.translations.en;
const l = locale === "ar" ? {title:"انضم إلى قائمة الاهتمام",body:"سنرسل إليك تفاصيل التوافر والخطوات التالية.",name:"الاسم الكامل",email:"البريد الإلكتروني",button:"إرسال الطلب"} : locale === "fr" ? {title:"Rejoindre la liste d’intérêt",body:"Nous vous enverrons les détails de disponibilité et les prochaines étapes.",name:"Nom complet",email:"E-mail",button:"Envoyer ma demande"} : {title:"Join the interest list",body:"We’ll send availability details and next steps.",name:"Full name",email:"Email address",button:"Send my application"};
---
<BaseLayout title={`${l.title} — ATLASELLE`} description={copy.summary}><section class="mx-auto max-w-xl px-6 py-20"><a class="text-sm text-primary underline" href={tripUrl(locale,journey)}>← {copy.title}</a><h1 class="mt-7 text-4xl font-bold">{l.title}</h1><p class="mt-4 text-muted-foreground">{l.body}</p><form class="mt-9 space-y-5 rounded-xl border p-6" method="post" action="/api/contact"><label class="block font-medium">{l.name}<input required name="name" class="mt-2 w-full rounded-md border bg-background p-3" /></label><label class="block font-medium">{l.email}<input required type="email" name="email" class="mt-2 w-full rounded-md border bg-background p-3" /></label><input type="hidden" name="subject" value={`Interest list: ${journey.id}`} /><button class="w-full rounded-md bg-primary px-4 py-3 font-semibold text-primary-foreground">{l.button}</button></form></section></BaseLayout>
