---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getDrizzle } from "@database/drizzle";
import { organization } from "@database/schemas";
import { eq } from "drizzle-orm";
import { getServiceBySlug } from "@/modules/services/loaders";
import { ServiceDetail } from "@/modules/services/components/single";
import { buildServiceJsonLd } from "@/modules/services/seo";
import { buildServiceUrl } from "@/modules/services/utils";
import { getServiceTranslations } from "@/modules/services/i18n";
import type { Locale } from "@i18n/config";
export const prerender = false;
const locale = (Astro.params.lang ?? "fr") as Locale;
const orgSlug = Astro.params.slug!;
const categorySlug = Astro.params.categorySlug!;
const serviceSlug = Astro.params.serviceSlug!;
const db = getDrizzle();
const [org] = await db.select({ id: organization.id, name: organization.name, slug: organization.slug }).from(organization).where(eq(organization.slug, orgSlug)).limit(1);
if (!org) return Astro.redirect(`/${locale}/services`);
const item = await getServiceBySlug(serviceSlug, locale, org.id, categorySlug);
if (!item) return Astro.redirect(`/${locale}/organizations/${orgSlug}/services`);
const t = getServiceTranslations(locale);
const title = item.translation?.title ?? t.labels.service;
const description = item.translation?.excerpt ?? t.meta.description;
const canonicalUrl = buildServiceUrl(locale, org.slug, item.translation?.slug ?? item.service.slug, categorySlug);
const jsonLd = buildServiceJsonLd({ name: title, description, slug: new URL(canonicalUrl, Astro.url.origin).href, priceMinor: item.service.priceMinor, currency: item.service.currency, ratingAverage100: item.service.ratingAverage100, ratingCount: item.service.ratingCount });
---
<BaseLayout title={`${title} — ${org.name}`} description={description}>
  <link rel="canonical" href={new URL(canonicalUrl, Astro.url.origin).href} />
  <script type="application/ld+json">{JSON.stringify(jsonLd)}</script>
  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8"><ServiceDetail item={item} locale={locale} organizationSlug={org.slug} /></main>
</BaseLayout>
