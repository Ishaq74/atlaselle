---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getDrizzle } from "@database/drizzle";
import { organization } from "@database/schemas";
import { eq } from "drizzle-orm";
import { getServices, getServiceCategories, getServiceBySlug } from "@/modules/services/loaders";
import ServicesListingPage from "@/modules/services/components/lists/ServicesListingPage.astro";
import { getServiceTranslations } from "@/modules/services/i18n";
import { buildServiceUrl } from "@/modules/services/utils";
import type { Locale } from "@i18n/config";
export const prerender = false;
const locale = (Astro.params.lang ?? "fr") as Locale;
const orgSlug = Astro.params.slug!;
const categorySlug = Astro.params.categorySlug!;
const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? "1") || 1);
const db = getDrizzle();
const [org] = await db.select({ id: organization.id, name: organization.name, slug: organization.slug }).from(organization).where(eq(organization.slug, orgSlug)).limit(1);
if (!org) return Astro.redirect(`/${locale}/services`);
const t = getServiceTranslations(locale);
const categories = await getServiceCategories(locale, org.id);
const category = categories.find((row) => (row.translation?.slug ?? row.category.slug) === categorySlug);
if (!category) {
 const service = await getServiceBySlug(categorySlug, locale, org.id);
 if (service?.translation) return Astro.redirect(buildServiceUrl(locale, org.slug, service.translation.slug, service.categories[0]?.slug ?? null), 301);
 return Astro.redirect(`/${locale}/organizations/${orgSlug}/services`);
}
const data = await getServices({ organizationId: org.id, categoryId: category.category.id, page }, locale, true);
const categoryItems = categories.map((row) => ({ slug: row.translation?.slug ?? row.category.slug, name: row.translation?.name ?? row.category.slug }));
const title = category.translation?.name ?? category.category.slug;
---
<BaseLayout title={`${title} - ${org.name}`} description={category.translation?.description ?? t.meta.description}>
  <main><ServicesListingPage locale={locale} title={title} description={category.translation?.description} items={data.items} meta={data} baseUrl={`/${locale}/organizations/${org.slug}/services/${categorySlug}`} categories={categoryItems} organizationSlug={org.slug} organizationName={org.name} activeCategorySlug={categorySlug} /></main>
</BaseLayout>