---
import { toLocale } from "@i18n/utils";
import type { Locale } from "@i18n/config";
import { loadBookingByProviderSession } from "@/modules/reservations/loaders/booking.loader";
import BaseLayout from "@layouts/BaseLayout.astro";

export const prerender = false;

const locale = toLocale(Astro.params.lang) as Locale;
const providerSessionId = Astro.url.searchParams.get("session_id") ?? "";
const booking = providerSessionId ? await loadBookingByProviderSession(locale, providerSessionId) : null;
if (!booking) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const fmt = (cents: number) => `${booking.currency === "EUR" ? "€" : booking.currency + " "}${(cents / 100).toLocaleString("en")}`;
const l =
  locale === "fr"
    ? { title: "Réservation confirmée", number: "Numéro", trip: "Voyage", paid: "Payé", confirmed: "Votre place est réservée. Détails envoyés par e-mail.", pending: "Paiement en cours de confirmation — actualisez dans un instant.", balance: "Régler le solde restant", email: "E-mail de la réservation", payBalance: "Payer le solde" }
    : locale === "es"
      ? { title: "Reserva confirmada", number: "Número", trip: "Viaje", paid: "Pagado", confirmed: "Su plaza está reservada. Detalles por correo.", pending: "Pago en confirmación — actualice en un instante.", balance: "Pagar el saldo restante", email: "Correo de la reserva", payBalance: "Pagar el saldo" }
      : locale === "ar"
        ? { title: "تم تأكيد الحجز", number: "الرقم", trip: "الرحلة", paid: "المدفوع", confirmed: "تم حجز مقعدك. التفاصيل بالبريد.", pending: "الدفع قيد التأكيد — حدّث بعد قليل.", balance: "ادفع الرصيد المتبقي", email: "بريد الحجز", payBalance: "ادفع الرصيد" }
        : { title: "Booking confirmed", number: "Number", trip: "Trip", paid: "Paid", confirmed: "Your seat is booked. Details sent by email.", pending: "Payment confirming — refresh in a moment.", balance: "Pay the remaining balance", email: "Booking email", payBalance: "Pay balance" };
const showBalanceForm = (booking.status === "confirmed" || booking.status === "balance_due") && booking.totalAmount - booking.amountPaid > 0;
---
<BaseLayout title={`${l.title} — ${booking.tripTitle}`} description={booking.tripTitle} canonicalPath={`/${locale}/booking-confirmed`} robots="noindex, nofollow">
  <section class="mx-auto max-w-xl px-6 py-20 text-center">
    <p class="text-5xl" aria-hidden="true">✓</p>
    <h1 class="mt-4 text-4xl font-bold">{l.title}</h1>
    <dl class="mx-auto mt-8 max-w-md space-y-3 rounded-xl border p-6 text-start text-sm">
      <div class="flex justify-between"><dt class="text-muted-foreground">{l.number}</dt><dd class="font-mono font-semibold"><bdi>{booking.reservationNumber}</bdi></dd></div>
      <div class="flex justify-between"><dt class="text-muted-foreground">{l.trip}</dt><dd class="font-semibold">{booking.tripTitle}</dd></div>
      <div class="flex justify-between"><dt class="text-muted-foreground">{l.paid}</dt><dd class="font-semibold"><bdi>{fmt(booking.amountPaid)}</bdi> / <bdi>{fmt(booking.totalAmount)}</bdi></dd></div>
    </dl>
    <p class="mt-6 text-muted-foreground">{booking.status === "confirmed" || booking.status === "completed" ? l.confirmed : l.pending}</p>
    {showBalanceForm ? (
      <form data-balance-form class="mx-auto mt-6 max-w-md space-y-3 rounded-xl border p-6 text-start" data-reservation={booking.reservationId} data-locale={locale}>
        <p class="font-semibold">{l.balance} : <bdi>{fmt(booking.totalAmount - booking.amountPaid)}</bdi></p>
        <label class="block text-sm">{l.email}<input required name="travelerEmail" type="email" maxlength="320" class="mt-2 w-full rounded-md border bg-background p-3" /></label>
        <button class="w-full rounded-md bg-primary px-4 py-3 font-semibold text-primary-foreground">{l.payBalance}</button>
        <output class="block text-sm" data-form-message></output>
      </form>
    ) : null}
  </section>
</BaseLayout>

<script>
  import { actions } from "astro:actions";
  import type { Locale } from "@i18n/config";
  document.querySelector("[data-balance-form]")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement | null;
    if (!form) return;
    const data = new FormData(form);
    const locale = (form.dataset.locale ?? "en") as Locale;
    const reservationId = form.dataset.reservation ?? "";
    const el = form.querySelector("[data-form-message]");
    if (data.get("terms") !== "on") {
      if (el) el.textContent = "Error";
      return;
    }
    const { data: result, error } = await actions.payBalance({
      reservationId,
      travelerEmail: String(data.get("travelerEmail") ?? ""),
      locale,
      termsAccepted: true as const,
    });
    if (error || !result) {
      if (el) el.textContent = error?.message ?? "Error";
    } else {
      window.location.href = result.checkoutUrl;
    }
  });
</script>
