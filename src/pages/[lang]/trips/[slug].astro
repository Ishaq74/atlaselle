---
import { toLocale } from "@i18n/utils";
import { LOCALES } from "@i18n/config";
import { getTripPath } from "@i18n/routes";
import { loadTripPage } from "@/modules/trips/loaders/trip.loader";
import BaseLayout from "@layouts/BaseLayout.astro";
import TripPage from "@/components/pages/TripPage.astro";
const locale = toLocale(Astro.params.lang);
const dto = await loadTripPage(locale, Astro.params.slug ?? "");
if (!dto) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}
const copy = dto.translations[locale];
const alternateUrls = Object.fromEntries(LOCALES.map((loc) => [loc, getTripPath(loc, dto.translations[loc].slug)]));
const canonicalPath = getTripPath(locale, copy.slug);
const jsonLd = JSON.stringify({"@context":"https://schema.org","@type":"TouristTrip",name:copy.title,description:copy.summary,inLanguage:locale,offers:{"@type":"Offer",price:dto.price,priceCurrency:dto.currency,availability:dto.status === "open" ? "https://schema.org/InStock" : "https://schema.org/PreOrder"}});
---
<BaseLayout title={`${copy.title} — ATLASELLE`} description={copy.summary} canonicalPath={canonicalPath} alternateUrls={alternateUrls} jsonLd={jsonLd}>
  <TripPage trip={dto} locale={locale} />
</BaseLayout>
