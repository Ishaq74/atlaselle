---
import { toLocale } from "@i18n/utils";
import { LOCALES, type Locale } from "@i18n/config";
import { getTripsBasePath } from "@i18n/routes";
import { loadTripsList } from "@/modules/trips/loaders/trip.loader";
import BaseLayout from "@layouts/BaseLayout.astro";
import TripCard from "@/modules/trips/components/TripCard.astro";

export const prerender = false;

const locale = toLocale(Astro.params.lang);
const difficulty = Astro.url.searchParams.get("difficulty");
const availability = Astro.url.searchParams.get("availability");

const all = await loadTripsList(locale);
const trips = all.filter((t) => {
  if (difficulty && String(t.difficultyLevel) !== difficulty) return false;
  if (availability === "open" && t.status !== "open") return false;
  return true;
});

const copy =
  locale === "fr"
    ? { title: "Nos voyages", description: "Voyages en petits groupes, départs et disponibilités.", all: "Tous", open: "Disponibles", difficulty: "Difficulté" }
    : locale === "es"
      ? { title: "Nuestros viajes", description: "Viajes en grupos pequeños, salidas y disponibilidad.", all: "Todos", open: "Disponibles", difficulty: "Dificultad" }
      : locale === "ar"
        ? { title: "رحلاتنا", description: "رحلات بمجموعات صغيرة ومواعيد وتوفر.", all: "الكل", open: "متاح", difficulty: "المستوى" }
        : { title: "Our journeys", description: "Small-group journeys, departures and availability.", all: "All", open: "Available", difficulty: "Difficulty" };

const canonicalPath = getTripsBasePath(locale);
const alternateUrls = Object.fromEntries(LOCALES.map((loc: Locale) => [loc, getTripsBasePath(loc)]));
const base = getTripsBasePath(locale);
---
<BaseLayout title={`${copy.title} — ATLASELLE`} description={copy.description} canonicalPath={canonicalPath} alternateUrls={alternateUrls}>
  <section class="mx-auto max-w-6xl px-6 py-14">
    <h1 class="text-4xl font-bold">{copy.title}</h1>
    <p class="mt-3 text-muted-foreground">{copy.description}</p>
    <form method="get" class="mt-8 flex flex-wrap items-center gap-4 text-sm">
      <a class:list={["rounded-full border px-4 py-1.5", !availability && "bg-primary text-primary-foreground"]} href={base}>{copy.all}</a>
      <a class:list={["rounded-full border px-4 py-1.5", availability === "open" && "bg-primary text-primary-foreground"]} href={`${base}?availability=open`}>{copy.open}</a>
      <label class="ml-2 inline-flex items-center gap-2">{copy.difficulty}
        <select name="difficulty" class="rounded-md border bg-background px-2 py-1.5" onchange="this.form.submit()">
          <option value="">—</option>
          {[1, 2, 3, 4, 5].map((n) => (
            <option value={String(n)} selected={difficulty === String(n)}>{n}/5</option>
          ))}
        </select>
      </label>
      {availability === "open" ? <input type="hidden" name="availability" value="open" /> : null}
    </form>
    <div class="mt-10 grid gap-8 md:grid-cols-2">
      {trips.map((trip) => (
        <TripCard trip={trip} locale={locale} />
      ))}
    </div>
  </section>
</BaseLayout>
