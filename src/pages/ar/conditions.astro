---
import BaseLayout from "@layouts/BaseLayout.astro";
const title = "شروط السفر";
const description = "يتأكد حجزك بعد قبول طلبك واستلام الدفعة المقدمة.";
---
<BaseLayout title={`${title} — ATLASELLE`} description={description}>
  <section class="mx-auto max-w-3xl px-6 py-20"><h1 class="text-4xl font-bold">{title}</h1><p class="mt-8 text-lg leading-relaxed text-muted-foreground">{description} نرسل لك الشروط النهائية والتأمينات والإلغاءات ومعلومات السلامة قبل الدفع.</p></section>
</BaseLayout>
