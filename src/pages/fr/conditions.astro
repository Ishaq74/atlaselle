---
import BaseLayout from "@layouts/BaseLayout.astro";
const title = "Conditions de voyage";
const description = "Votre réservation est confirmée après acceptation de votre candidature et réception de l’acompte.";
---
<BaseLayout title={`${title} — ATLASELLE`} description={description}>
  <section class="mx-auto max-w-3xl px-6 py-20"><h1 class="text-4xl font-bold">{title}</h1><p class="mt-8 text-lg leading-relaxed text-muted-foreground">{description} Les conditions définitives, assurances, annulations et informations de sécurité vous sont communiquées avant paiement.</p></section>
</BaseLayout>
