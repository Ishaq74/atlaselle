---
import { getTripBySlug, tripUrl } from "@/data/trips";
import BaseLayout from "@layouts/BaseLayout.astro";
const journey = getTripBySlug("fr", Astro.params.voyage ?? "");
if (!journey) return Astro.rewrite("/404");
const copy = journey.translations.fr;
---
<BaseLayout title={`Candidature — ${copy.title} — ATLASELLE`} description={copy.summary}>
  <section class="mx-auto max-w-xl px-6 py-20">
    <a class="text-sm text-primary underline" href={tripUrl("fr", journey)}>← {copy.title}</a>
    <h1 class="mt-7 text-4xl font-bold">Rejoindre la liste d’intérêt</h1>
    <p class="mt-4 text-muted-foreground">Nous vous enverrons les détails de disponibilité et les prochaines étapes.</p>
    <form class="mt-9 space-y-5 rounded-xl border p-6" method="post" action="/api/contact">
      <label class="block font-medium">Nom complet<input required name="name" class="mt-2 w-full rounded-md border bg-background p-3" /></label>
      <label class="block font-medium">E-mail<input required type="email" name="email" class="mt-2 w-full rounded-md border bg-background p-3" /></label>
      <input type="hidden" name="subject" value={`Interest list: ${journey.id}`} />
      <button class="w-full rounded-md bg-primary px-4 py-3 font-semibold text-primary-foreground">Envoyer ma demande</button>
    </form>
  </section>
</BaseLayout>
